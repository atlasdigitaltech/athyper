{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "candidateKey",
    "targetPlanes",
    "roots",
    "expectedArtifactKeys",
    "forbiddenArtifactPrefixes",
    "release",
    "baseline",
    "replacementArtifactKeys",
    "addedArtifactKeys",
    "expectedRuntimeArtifactKeys"
  ],
  "properties": {
    "schema": {
      "const": "athyper.compiled-entity-release-candidate/1"
    },
    "schemaVersion": {
      "const": 1
    },
    "candidateKey": {
      "type": "string",
      "minLength": 1
    },
    "targetPlanes": {
      "const": [
        "neon"
      ]
    },
    "roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expectedArtifactKeys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbiddenArtifactPrefixes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "release": {
      "type": "object"
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "publicationKey",
        "releaseId",
        "releaseHash",
        "artifactCount"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "publicationKey": {
          "type": "string",
          "minLength": 1
        },
        "releaseId": {
          "type": "string",
          "minLength": 1
        },
        "releaseHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "artifactCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "replacementArtifactKeys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "addedArtifactKeys": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expectedRuntimeArtifactKeys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
