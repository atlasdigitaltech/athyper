{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "contractStatus",
    "artifactType",
    "artifactKey",
    "entityCode",
    "plane",
    "dependencies",
    "artifactHash"
  ],
  "properties": {
    "actions": {},
    "artifactHash": {},
    "artifactKey": {},
    "artifactType": {
      "const": "presentation_surface"
    },
    "columns": {},
    "contextControl": {},
    "contractStatus": {},
    "dataAuthority": {},
    "dependencies": {},
    "entityCode": {},
    "excludedCapabilities": {},
    "fieldDiff": {},
    "header": {},
    "layout": {},
    "navigation": {
      "type": "object",
      "properties": {
        "tabs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sectionDisplay": { "enum": ["continuous", "selected"] }
            }
          }
        }
      }
    },
    "pageSizes": {},
    "plane": {
      "const": "neon"
    },
    "policyManifest": {},
    "queryPresentation": {},
    "restrictedValues": {},
    "schema": {},
    "schemaVersion": {
      "const": 2
    },
    "sections": {},
    "sort": {},
    "summaryView": {},
    "surfaceKey": {}
  }
}
