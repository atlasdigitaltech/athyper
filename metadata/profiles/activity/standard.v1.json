{
  "schema": "athyper.capability-profile/1",
  "profileCode": "platform.activity.standard",
  "profileVersion": 1,
  "capabilityKey": "activity",
  "defaults": {
    "views": ["auditLog", "snapshots"],
    "defaultView": "auditLog",
    "snapshots": {
      "manualCapture": true,
      "automaticCapture": "none",
      "captureOperations": [],
      "retentionClass": "standard"
    },
    "query": {
      "defaultRangeDays": 30,
      "maxRangeDays": 90,
      "pageSize": 50
    }
  },
  "permittedOverrides": {
    "views": { "allowedSubset": ["auditLog", "snapshots"] },
    "defaultView": { "allowedValues": ["auditLog", "snapshots"] },
    "snapshots.manualCapture": { "allowedValues": [true, false] },
    "snapshots.retentionClass": { "allowedValues": ["standard", "operational"] },
    "query.defaultRangeDays": { "minimum": 1, "maximum": 90 },
    "query.maxRangeDays": { "minimum": 1, "maximum": 90 },
    "query.pageSize": { "minimum": 1, "maximum": 100 }
  }
}
