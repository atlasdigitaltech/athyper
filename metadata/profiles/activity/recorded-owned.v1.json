{
  "schema": "athyper.capability-profile/1",
  "profileCode": "platform.activity.recorded-owned",
  "profileVersion": 1,
  "capabilityKey": "activity",
  "defaults": {
    "views": [
      "auditLog",
      "versions",
      "snapshots"
    ],
    "defaultView": "auditLog",
    "snapshots": {
      "manualCapture": true,
      "automaticCapture": "committed",
      "captureOperations": [
        "create",
        "patch",
        "aggregate"
      ],
      "retentionClass": "standard"
    },
    "query": {
      "defaultRangeDays": 30,
      "maxRangeDays": 90,
      "pageSize": 50
    },
    "recording": {
      "providerKey": "platform.records.history.v1",
      "projection": "stored_root",
      "operations": [
        "create",
        "patch",
        "aggregate"
      ],
      "adapterKey": "platform.records.owned.v1"
    }
  },
  "permittedOverrides": {
    "views": {
      "allowedSubset": [
        "auditLog",
        "versions",
        "snapshots"
      ]
    },
    "defaultView": {
      "allowedValues": [
        "auditLog",
        "versions",
        "snapshots"
      ]
    },
    "snapshots.manualCapture": {
      "allowedValues": [
        true,
        false
      ]
    },
    "snapshots.retentionClass": {
      "allowedValues": [
        "standard",
        "operational"
      ]
    },
    "query.defaultRangeDays": {
      "minimum": 1,
      "maximum": 90
    },
    "query.maxRangeDays": {
      "minimum": 1,
      "maximum": 90
    },
    "query.pageSize": {
      "minimum": 1,
      "maximum": 100
    },
    "recording.operations": {
      "allowedSubset": [
        "create",
        "patch",
        "transition",
        "delete",
        "aggregate",
        "domain"
      ]
    },
    "snapshots.captureOperations": {
      "allowedSubset": [
        "create",
        "patch",
        "transition",
        "delete",
        "aggregate",
        "domain"
      ]
    }
  }
}
