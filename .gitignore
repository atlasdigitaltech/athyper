# =========================
# Logs
# =========================
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# =========================
# Diagnostic reports
# =========================
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# =========================
# Runtime data
# =========================
pids/
*.pid
*.seed
*.pid.lock

# =========================
# Coverage / Test
# =========================
**/coverage/
*.lcov
.nyc_output/

# Playwright browser tests — never commit sign-in session state or
# the test report bundle. Reference screenshots in __screenshots__/
# ARE committed (they're the regression baseline).
tests/e2e/.auth/
tests/e2e/.playwright*-output/
playwright-report/
test-results/

# =========================
# Build / Output
# =========================
**/dist/
**/build/
**/out/
**/.next/
**/storybook-static/

# =========================
# Turbo
# =========================
.turbo/
**/.turbo/

# =========================
# Dependency directories
# =========================
**/node_modules/

# pnpm store (sometimes appears in CI/WSL)
.pnpm-store/

# =========================
# TypeScript / Tooling
# =========================
*.tsbuildinfo
.npm/
.eslintcache
.stylelintcache
**/.cache/
**/.parcel-cache/
**/.vite/

# Next.js
next-env.d.ts
.next-env.d.ts

# =========================
# Archives
# =========================
*.tgz

# =========================
# claude
# =========================
.claude

# =========================
# Environment files
# =========================
.env
.env.*
*.env
!.env.example
!*.env.example

# Grafana provisioning config dirs are named *.env but contain YAML, not secrets
!deploy/config/telemetry/provisioning.env/
!deploy/config/telemetry/provisioning.env/**

# Sentry CLI auth token (used by @sentry/nextjs source-map upload)
.sentryclirc

# =========================
# Vite / VitePress
# =========================
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
**/.vitepress/dist/
**/.vitepress/cache/

# =========================
# OS / Editor
# =========================
.DS_Store
Thumbs.db
Desktop.ini
.idea/
*.iml

.vscode/
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.vscode-test/
.history/
*.code-workspace

# Editor backups / swap files
*.swp
*.swo
*~
*.bak
*.orig

# =========================
# Athyper / stack (IMPORTANT)
# =========================

# Docker volume data / runtime data
/data/

# Tool outputs
tooling/tools/**/tmp/
tooling/tools/**/output/
.codex-logs/
.weekly-db-checks/

# =========================
# Prisma / DB artifacts
# =========================
**/prisma/dev.db
**/prisma/.env
**/prisma/migrations/**/migration_lock.toml
**/*.db-journal
**/*.db-wal
**/*.db-shm

# =========================
# Python
# =========================
__pycache__/
*.pyc
*.pyo

# =========================
# Misc
# =========================

# pnpm monorepo — ignore accidental npm lock files
**/package-lock.json

# Generated (output dirs only — do NOT ignore source packages)
**/generated/
**/codegen/
**/.prisma/

# Versioned DDL-to-service coverage evidence is generated but reviewable.
!docs/architecture/generated/
docs/architecture/generated/*
!docs/architecture/generated/ddl-service-coverage.json

# =========================
# Scratch / Prototype work
# =========================
tmp/
.tmp/

# =========================
# Local-only docs (not synced to GitHub)
# =========================
docs/local/

# Generated browser/disruption evidence is retained outside source control.
tests/e2e/acceptance-output/

# Local database backups and diagnostic evidence
**/.local-backups/
**/.local-evidence/

# Server backup directory
server-backup/

# Backup directories
apps-backup/
packages-backup/

# =========================
# Claude Code artifacts
# =========================
.codex/

# Customer-specific docs (local only)
docs/customer/
