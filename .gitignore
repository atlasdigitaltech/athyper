# =========================
# Logs
# =========================
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# =========================
# Diagnostic reports
# =========================
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# =========================
# Runtime data
# =========================
pids/
*.pid
*.seed
*.pid.lock

# =========================
# Coverage / Test
# =========================
**/coverage/
*.lcov
.nyc_output/

# =========================
# Build / Output
# =========================
**/dist/
**/build/
**/out/
**/.next/
**/storybook-static/

# =========================
# Turbo
# =========================
.turbo/
**/.turbo/

# =========================
# Dependency directories
# =========================
**/node_modules/

# pnpm store (sometimes appears in CI/WSL)
.pnpm-store/

# =========================
# TypeScript / Tooling
# =========================
*.tsbuildinfo
.npm/
.eslintcache
.stylelintcache
**/.cache/
**/.parcel-cache/
**/.vite/

# Next.js
next-env.d.ts
.next-env.d.ts

# =========================
# Archives
# =========================
*.tgz

# =========================
# claude
# =========================
.claude

# =========================
# Environment files
# =========================
.env
.env.*
*.env
!.env.example
!*.env.example

# Grafana provisioning config dirs are named *.env but contain YAML, not secrets
!stack/config/telemetry/provisioning.env/
!stack/config/telemetry/provisioning.env/**

# Sentry CLI auth token (used by @sentry/nextjs source-map upload)
.sentryclirc

# =========================
# Vite / VitePress
# =========================
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
**/.vitepress/dist/
**/.vitepress/cache/

# =========================
# OS / Editor
# =========================
.DS_Store
Thumbs.db
Desktop.ini
.idea/
*.iml

.vscode/
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.vscode-test/
.history/

# Editor backups / swap files
*.swp
*.swo
*~
*.bak
*.orig

# =========================
# Athyper / stack (IMPORTANT)
# =========================

# Docker volume data / runtime data
/data/
stack/data/
stack/**/data/
stack/logs/
stack/tmp/

# Generated TLS / secrets (if any)
stack/config/**/certs/*.key
stack/config/**/certs/*.crt
stack/config/**/certs/*.pem
stack/config/**/certs/*.pfx
stack/config/**/certs/*.p12
stack/config/**/certs/ca.*

# Tool outputs
tools/**/tmp/
tools/**/output/

# =========================
# Prisma / DB artifacts
# =========================
**/prisma/dev.db
**/prisma/.env
**/prisma/migrations/**/migration_lock.toml
**/*.db-journal
**/*.db-wal
**/*.db-shm

# =========================
# Python
# =========================
__pycache__/
*.pyc
*.pyo

# =========================
# Misc
# =========================

# pnpm monorepo — ignore accidental npm lock files
**/package-lock.json

# Generated (output dirs only — do NOT ignore source packages)
**/generated/
!server/framework/adapters/db/src/generated/
**/codegen/
**/.prisma/

# =========================
# Scratch / Prototype work
# =========================
tmp/
