{
  "schemaVersion": 1,
  "contractId": "authorization-v2-wave3-authority",
  "status": "additive-build-static-certified-live-pending",
  "dependsOn": [
    "authorization-v2-wave1-additive",
    "authorization-v2-wave2-canonical-catalog"
  ],
  "semanticContract": "server/db/seed/contracts/authorization/authority/authorization-authority-semantic-contract.v1.json",
  "authorities": {
    "neonAdmin": {
      "database": "neon",
      "manifest": "server/db/seed/contracts/authorization/authority/neon-admin/authority.v1.json",
      "compiled": "server/db/seed/contracts/authorization/authority/neon-admin/compiled/compiled-authority.v1.json",
      "planes": ["neon", "admin"],
      "runtimePersonaAuthorityAllowed": false,
      "adminAdmission": "explicit_admin_plane_membership_plus_group"
    },
    "mesh": {
      "database": "mesh",
      "manifest": "server/db/seed/contracts/authorization/authority/mesh/authority.v1.json",
      "compiled": "server/db/seed/contracts/authorization/authority/mesh/compiled/compiled-authority.v1.json",
      "planes": ["mesh"],
      "neonCatalogReadAllowed": false,
      "neonPlanReadAllowed": false,
      "repositoryDefaultEnabled": false
    }
  },
  "mapping": {
    "activeHumanPrincipal": "mapped_or_quarantined_zero_grant",
    "servicePrincipal": "explicit_excluded_non_human_with_evidence",
    "legacyAdminGrant": "admin_membership_plus_admin_group",
    "persona": "migration_only_to_exact_compiled_permission_set_role_and_group",
    "companyOrganization": "typed_scoped_group_role_or_explicit_override",
    "emptyScope": "anomaly_and_deny",
    "inactiveOrExpiredAuthority": "grants_nothing"
  },
  "requiredOrder": [
    "expand",
    "capture_watermark",
    "snapshot_backfill",
    "replay_from_watermark",
    "continuous_sync",
    "compare",
    "clean_anomalies",
    "validate_constraints",
    "enforce_not_null",
    "publish_and_read_swap"
  ],
  "staticGate": {
    "command": "pnpm --dir server/db run db:verify:authorization-v2-wave3",
    "status": "implemented"
  },
  "liveGate": {
    "command": "pnpm --dir server/db run db:verify:authorization-v2-wave3:live",
    "requiredEnvironment": [
      "AUTHORIZATION_V2_NEON_DATABASE_URL",
      "AUTHORIZATION_V2_MESH_DATABASE_URL"
    ],
    "status": "required_not_executed",
    "zeroRequired": [
      "unmapped_active_users",
      "tenant_plane_inconsistency",
      "inactive_or_expired_current_grants",
      "empty_or_anomalous_scopes",
      "mesh_permissions_without_local_account_proof",
      "unvalidated_registered_constraints",
      "unexpected_pg_constraint_rows",
      "nullable_required_final_authority_columns"
    ]
  },
  "publication": {
    "allowedBeforeLiveGate": false,
    "requiresNamedBusinessOwner": true,
    "requiresApprovedWatermarkedUserManifest": true,
    "requiresZeroBackfillAnomalies": true,
    "requiresRollbackOwnerAndObservationWindow": true
  }
}
