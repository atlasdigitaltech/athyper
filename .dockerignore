# Never copy host node_modules into the image.
# pnpm symlinks point to absolute host paths and break inside Linux containers.
# Docker installs dependencies fresh via pnpm install in the Dockerfile.
**/node_modules
.pnpm-store

# Git metadata not needed in image
.git
.github

# Environment files — .example files are safe to include (no real secrets)
**/.env
**/.env.*
!**/.env.example

# Build artefacts — rebuilt inside the image from source
**/dist
**/build
**/.turbo
**/.next
**/*.log
**/coverage
**/.playwright
**/test-results

# Local Codex build/prototype artifacts
.codex-*

# Preserved legacy server is behavioral reference only and must never enter images.
server-backup

# Pre-rendered Redis ACL — contains SHA-256 password hashes. Not needed by
# Next.js or the server build.
deploy/config/memorycache/redis-acl.conf

# Documentation
docs/
