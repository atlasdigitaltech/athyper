    "test:e2e:production": "playwright test --config=playwright.config.ts --project=production-admin-desktop --project=production-admin-mobile --project=production-neon-desktop --project=production-neon-mobile --project=production-mesh-desktop --project=production-mesh-mobile",
    "test:visual": "playwright test --config=playwright.config.ts --project=visual",
    "test:plane-contracts": "tsx --test tests/contracts/*.test.ts",
    "storybook": "turbo dev --filter=@athyper/storybook",
    "contracts:check": "turbo contracts:check",
    "db:plan": "pnpm --dir server/db run db:foundation:plan",
    "db:discover:neon": "pnpm --dir server/db run db:setup:discover",
    "db:discover:mesh": "pnpm --dir server/db run db:provision:mesh -- --discover",
    "db:verify:ddl-model": "pnpm --dir server/db run db:verify:ddl-model",
    "db:setup:rebuild-entity-metadata": "pnpm --dir server/db run db:setup:rebuild-entity-metadata",
    "clean": "turbo clean && rm -rf node_modules",
    "brand:build": "tsx scripts/brand/build-brand.ts",
    "brand:sync:apps": "tsx scripts/brand/sync-app-brand.ts",
    "brand:sync:gateway": "tsx scripts/brand/sync-gateway-brand.ts",
    "brand:sync:keycloak": "tsx scripts/brand/sync-keycloak.ts",
    "brand:verify": "tsx scripts/brand/verify-brand-sync.ts",
    "brand:refresh": "pnpm brand:build && pnpm brand:sync:apps && pnpm brand:sync:gateway && pnpm brand:sync:keycloak",
    "brand:check": "pnpm brand:build && pnpm brand:verify",
    "iam:build": "pnpm --filter @athyper/platform-theme iam:build",
    "iam:verify": "tsx scripts/iam/verify-unified-shell.ts",
    "iam:verify:identity-first": "tsx scripts/iam/verify-identity-first.ts",
    "iam:verify:provider-foundation": "tsx scripts/iam/verify-provider-foundation.ts",
    "iam:verify:mfa-authority": "tsx scripts/iam/verify-mfa-authority.ts",
    "iam:verify:federated-assurance": "tsx scripts/iam/verify-federated-assurance.ts",
    "iam:verify:testing-foundation": "tsx scripts/iam/verify-testing-foundation.ts",
    "iam:demo:generate": "node tools/scripts/generate-athyper-demo-iam.cjs",
    "iam:demo:check": "node tools/scripts/generate-athyper-demo-iam.cjs --check && node tools/scripts/verify-athyper-demo-iam.cjs",
    "iam:reconcile:authorization-v2": "node tools/scripts/reconcile-keycloak-authorization-v2.mjs",
    "iam:test:authorization-v2-reconciler": "node --test tools/scripts/reconcile-keycloak-authorization-v2.test.mjs",
    "policy:versions": "syncpack lint",
    "policy:versions:fix": "syncpack fix",
    "policy:peers": "tsx scripts/policy/verify-peer-ranges.ts",
    "policy:tsconfig": "tsx scripts/policy/verify-tsconfig.ts",
    "policy:typography": "pnpm --filter @athyper/platform-theme run check:typography",
    "policy:style-tokens": "tsx scripts/policy/audit-style-tokens.ts",
    "policy:style-tokens:strict": "tsx scripts/policy/audit-style-tokens.ts --strict",
    "policy:server-boundaries": "node scripts/policy/verify-server-boundaries.mjs",
    "policy:server-docker-workspaces": "node scripts/policy/verify-server-docker-workspaces.mjs",
    "policy:docker-toolchain": "node scripts/policy/verify-docker-toolchain.mjs",
    "policy:canonical-packages": "node scripts/policy/verify-canonical-package-rules.mjs",
    "policy:shared-purity": "node scripts/policy/verify-shared-package-purity.mjs",
    "policy:no-source-junctions": "node scripts/policy/verify-no-source-junctions.mjs",
    "policy:deployment-profiles": "node scripts/policy/verify-deployment-profiles.mjs",
    "policy:release-boundaries": "pnpm policy:canonical-packages && pnpm policy:shared-purity && pnpm policy:no-source-junctions && pnpm policy:deployment-profiles",
    "release:phase10:audit": "node scripts/release/phase10-deletion-audit.mjs",
    "policy:neon-mesh-boundary": "node scripts/policy/verify-neon-mesh-boundary.mjs",
    "policy:mesh-boundaries": "node scripts/policy/verify-plane-boundaries.mjs",
    "policy:plane-boundaries": "node scripts/policy/verify-plane-boundaries.mjs",
    "policy:experience-cleanup": "node scripts/policy/verify-experience-cleanup.mjs",
    "policy:content-ui-boundaries": "node scripts/policy/verify-content-ui-boundaries.mjs",
    "policy:shared-naming": "node scripts/policy/verify-shared-naming.mjs",
    "policy:legacy-package-ids": "node scripts/policy/verify-legacy-package-ids.mjs --report policy/reports/legacy-package-ids.json",
    "policy:legacy-runtime-retirement": "node scripts/policy/verify-legacy-runtime-retirement.mjs",
    "policy:runtime-api-paths": "tsx scripts/policy/verify-runtime-api-paths.ts --strict",
    "policy:meta-entity": "node scripts/policy/verify-meta-entity-governance.mjs && node scripts/policy/verify-meta-entity-test-matrix.mjs && node scripts/policy/verify-meta-entity-dependencies.mjs && pnpm policy:meta-entity-contract && pnpm verify:meta-entity-certification",
    "policy:meta-entity-contract": "tsx scripts/policy/verify-meta-entity-contract-coverage.ts",
    "policy:meta-entity-contract:strict": "tsx scripts/policy/verify-meta-entity-contract-coverage.ts --strict",
    "policy:meta-entity-contract:update": "tsx scripts/policy/verify-meta-entity-contract-coverage.ts --update",
    "test:meta-entity-contract-coverage": "tsx --test scripts/policy/meta-entity-contract-coverage.test.ts",
    "test:meta-entity-rollout": "tsx --test scripts/policy/meta-entity-rollout-gate.test.ts",
    "test:meta-entity-certification": "tsx --test scripts/policy/meta-entity-certification.test.ts",
    "verify:meta-entity-rollout": "tsx scripts/policy/verify-meta-entity-rollout.ts",
    "verify:meta-entity-certification": "tsx scripts/policy/verify-meta-entity-certification.ts",
    "policy:meta-entity-hygiene": "pnpm --dir server run meta:hygiene",
    "policy:metadata-semantic-fallbacks": "pnpm --dir server run metadata:semantic-fallbacks:audit",
    "package:ownership:inventory": "node scripts/package-ownership-inventory.mjs",
    "policy:records-identity-boundary": "node scripts/policy/verify-records-identity-boundary.mjs",
    "qualify:meta-entity": "node scripts/performance/qualify-meta-entity.mjs",
    "perf:capture:p0": "node scripts/performance/capture-p0-baseline.mjs",
    "perf:capture:cache-observability": "node scripts/performance/capture-cache-observability-baseline.mjs",
    "perf:capture:record-workspace": "node scripts/performance/capture-record-workspace-baseline.mjs",
    "perf:verify:runtime-list-cache-rollout": "node scripts/performance/verify-runtime-list-cache-rollout.mjs",
    "test:runtime-list-cache-rollout-gate": "node --test scripts/performance/verify-runtime-list-cache-rollout.test.mjs",
    "test:meta-entity-governance": "node --test scripts/performance/qualify-meta-entity.test.mjs",
    "test:meta-entity-retirement": "node --test scripts/performance/verify-meta-entity-retirement.test.mjs",
    "test:meta-entity-dependencies": "node --test scripts/policy/verify-meta-entity-dependencies.test.mjs",
    "retire:meta-entity": "node scripts/performance/verify-meta-entity-retirement.mjs",
    "policy:release-gate": "node scripts/policy/verify-release-gate.mjs",
    "policy:qualification-artifacts": "node scripts/policy/verify-qualification-artifacts.mjs",
    "perf:tenant-size-load:verify": "node scripts/performance/verify-tenant-size-load-evidence.mjs",
    "policy:performance-phase-history": "node scripts/policy/verify-performance-phase-history.mjs",
    "policy:shared-ownership": "node scripts/policy/verify-shared-ownership.mjs --strict --report policy/reports/shared-ownership-drift.json",
    "policy:shared-grouping:strict": "node scripts/policy/verify-shared-naming.mjs --strict-group --group-report policy/reports/shared-grouping-audit.json",
    "policy:shared-naming:legacy": "node scripts/policy/verify-shared-naming.mjs --strict --legacy",
    "policy:shared-grouping": "node scripts/policy/verify-shared-naming.mjs",
    "document-open-rollout-ci-gate": "tsx --tsconfig apps/neon/tsconfig.json scripts/document-open-rollout-ci-gate.mjs",
    "document-open-rollout-snapshot-export": "tsx --tsconfig apps/neon/tsconfig.json scripts/document-open-rollout-snapshot-export.mjs",
    "policy": "pnpm policy:versions && pnpm policy:peers && pnpm policy:tsconfig && pnpm policy:typography && pnpm policy:style-tokens && pnpm policy:server-boundaries && pnpm policy:server-docker-workspaces && pnpm policy:docker-toolchain && pnpm policy:canonical-packages && pnpm policy:shared-purity && pnpm policy:no-source-junctions && pnpm policy:deployment-profiles && pnpm policy:neon-mesh-boundary && pnpm policy:plane-boundaries && pnpm policy:content-ui-boundaries && pnpm policy:shared-ownership && pnpm policy:shared-naming && pnpm policy:shared-grouping && pnpm policy:legacy-package-ids && pnpm policy:legacy-runtime-retirement && pnpm policy:runtime-api-paths && pnpm policy:meta-entity"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "@sentry/cli",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "protobufjs",
      "sharp"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "0.27.7",
    "syncpack": "^14.3.0",
    "tsx": "^4.19.2",
    "turbo": "^2.9.6",
    "typescript": "^6.0.3"
  }
}
