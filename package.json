{
  "name": "athyper",
  "private": true,
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build --concurrency 1",
    "lint": "pnpm policy:shared-grouping && turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:neon-route-open": "pnpm --dir apps/neon run test:route-suites:open",
    "test:neon-route-auth-notifications": "pnpm --dir apps/neon run test:route-suites:auth-notifications",
    "test:neon-route-phase4": "pnpm --dir apps/neon run test:route-suites:phase4",
    "test:content-ui": "pnpm --filter @athyper/content-ui test",
    "test:visual": "playwright test --config=playwright.config.ts",
    "storybook": "turbo dev --filter=@athyper/storybook",
    "contracts:check": "turbo contracts:check",
    "db:setup:rebuild-entity-metadata": "pnpm --dir server/db run db:setup:rebuild-entity-metadata",
    "clean": "turbo clean && rm -rf node_modules",
    "brand:build": "tsx scripts/brand/build-brand.ts",
    "brand:sync:apps": "tsx scripts/brand/sync-app-brand.ts",
    "brand:sync:keycloak": "tsx scripts/brand/sync-keycloak.ts",
    "brand:verify": "tsx scripts/brand/verify-brand-sync.ts",
    "brand:refresh": "pnpm brand:build && pnpm brand:sync:apps && pnpm brand:sync:keycloak",
    "brand:check": "pnpm brand:build && pnpm brand:verify",
    "policy:versions": "syncpack lint",
    "policy:versions:fix": "syncpack fix",
    "policy:peers": "tsx scripts/policy/verify-peer-ranges.ts",
    "policy:tsconfig": "tsx scripts/policy/verify-tsconfig.ts",
    "policy:typography": "pnpm --filter @athyper/theme run check:typography",
    "policy:style-tokens": "tsx scripts/policy/audit-style-tokens.ts",
    "policy:style-tokens:strict": "tsx scripts/policy/audit-style-tokens.ts --strict",
    "policy:server-boundaries": "node scripts/policy/verify-server-boundaries.mjs",
    "policy:neon-mesh-boundary": "node scripts/policy/verify-neon-mesh-boundary.mjs",
    "policy:mesh-boundaries": "node scripts/policy/verify-plane-boundaries.mjs",
    "policy:plane-boundaries": "node scripts/policy/verify-plane-boundaries.mjs",
    "policy:content-ui-boundaries": "node scripts/policy/verify-content-ui-boundaries.mjs",
    "policy:shared-naming": "node scripts/policy/verify-shared-naming.mjs",
    "policy:legacy-package-ids": "node scripts/policy/verify-legacy-package-ids.mjs --report policy/reports/legacy-package-ids.json",
    "policy:legacy-runtime-retirement": "node scripts/policy/verify-legacy-runtime-retirement.mjs",
    "policy:meta-entity": "node scripts/policy/verify-meta-entity-governance.mjs && node scripts/policy/verify-meta-entity-test-matrix.mjs && node scripts/policy/verify-meta-entity-dependencies.mjs",
    "policy:records-identity-boundary": "node scripts/policy/verify-records-identity-boundary.mjs",
    "qualify:meta-entity": "node scripts/performance/qualify-meta-entity.mjs",
    "perf:capture:p0": "node scripts/performance/capture-p0-baseline.mjs",
      "test:meta-entity-governance": "node --test scripts/performance/qualify-meta-entity.test.mjs",
      "test:meta-entity-dependencies": "node --test scripts/policy/verify-meta-entity-dependencies.test.mjs",
    "retire:meta-entity": "node scripts/performance/verify-meta-entity-retirement.mjs",
    "policy:release-gate": "node scripts/policy/verify-release-gate.mjs",
    "policy:qualification-artifacts": "node scripts/policy/verify-qualification-artifacts.mjs",
    "perf:tenant-size-load:verify": "node scripts/performance/verify-tenant-size-load-evidence.mjs",
    "policy:performance-phase-history": "node scripts/policy/verify-performance-phase-history.mjs",
    "policy:shared-ownership": "node scripts/policy/verify-shared-ownership.mjs --strict --report policy/reports/shared-ownership-drift.json",
    "policy:shared-grouping:strict": "node scripts/policy/verify-shared-naming.mjs --strict-group --group-report policy/reports/shared-grouping-audit.json",
    "policy:shared-naming:legacy": "node scripts/policy/verify-shared-naming.mjs --strict --legacy",
    "policy:shared-grouping": "node scripts/policy/verify-shared-naming.mjs",
    "document-open-rollout-ci-gate": "tsx --tsconfig apps/neon/tsconfig.json scripts/document-open-rollout-ci-gate.mjs",
    "document-open-rollout-snapshot-export": "tsx --tsconfig apps/neon/tsconfig.json scripts/document-open-rollout-snapshot-export.mjs",
    "policy": "pnpm policy:versions && pnpm policy:peers && pnpm policy:tsconfig && pnpm policy:typography && pnpm policy:style-tokens && pnpm policy:server-boundaries && pnpm policy:neon-mesh-boundary && pnpm policy:plane-boundaries && pnpm policy:content-ui-boundaries && pnpm policy:shared-ownership && pnpm policy:shared-naming && pnpm policy:shared-grouping && pnpm policy:legacy-package-ids && pnpm policy:legacy-runtime-retirement && pnpm policy:meta-entity"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "@sentry/cli",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "protobufjs",
      "sharp"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "syncpack": "^14.3.0",
    "tsx": "^4.19.2",
    "turbo": "^2.9.6",
    "typescript": "^6.0.3"
  }
}
