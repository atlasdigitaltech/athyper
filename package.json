{
  "name": "athyper",
  "private": true,
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build --concurrency 1",
    "lint": "pnpm policy:shared-grouping && turbo lint",
    "typecheck": "turbo typecheck",
    "test": "pnpm test:repo",
    "test:workspace": "turbo test",
    "test:policy": "tsx --test scripts/policy/*.test.ts scripts/policy/*.test.mjs",
    "test:performance-guards": "node --test scripts/performance/*.test.mjs",
    "perf:verify:experience-production": "node scripts/performance/verify-experience-production-gates.mjs",
    "perf:verify:experience-contracts": "node scripts/performance/verify-experience-production-gates.mjs --contracts-only",
    "perf:verify:shell-bundle": "node scripts/performance/verify-shared-shell-bundle.mjs",
    "test:reachability": "node scripts/testing/verify-test-reachability.mjs --check",
    "test:reachability:update": "node scripts/testing/verify-test-reachability.mjs --write",
    "test:root": "pnpm test:reachability && pnpm test:plane-contracts && pnpm test:policy && pnpm test:performance-guards",
    "test:repo": "pnpm test:workspace && pnpm test:root",
    "test:neon-route-open": "pnpm --dir apps/neon run test:route-suites:open",
    "test:neon-route-auth-notifications": "pnpm --dir apps/neon run test:route-suites:auth-notifications",
    "test:neon-route-phase4": "pnpm --dir apps/neon run test:route-suites:phase4",
    "test:content-ui": "pnpm --filter @athyper/content-ui test",
