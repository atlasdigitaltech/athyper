{
  "name": "athyper",
  "private": true,
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "storybook": "turbo dev --filter=@athyper/storybook",
    "contracts:check": "turbo contracts:check",
    "clean": "turbo clean && rm -rf node_modules",
    "brand:build": "tsx scripts/brand/build-brand.ts",
    "brand:sync:keycloak": "tsx scripts/brand/sync-keycloak.ts",
    "brand:verify": "tsx scripts/brand/verify-brand-sync.ts",
    "brand:refresh": "pnpm brand:build && pnpm brand:sync:keycloak",
    "brand:check": "pnpm brand:build && pnpm brand:verify"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "sharp"
    ]
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.19.0",
    "turbo": "^2.9.5",
    "typescript": "^6.0.2"
  }
}
