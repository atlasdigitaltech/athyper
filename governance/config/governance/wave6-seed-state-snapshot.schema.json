{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athyper.example/governance/wave6-seed-state-snapshot.schema.json",
  "title": "Wave 6 Seed State Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "plane",
    "databaseIdentity",
    "captureKind",
    "seedLedgerSha256",
    "seedOwnedSha256",
    "identityCount",
    "identityCanonicalSha256"
  ],
  "properties": {
    "contractVersion": { "const": "wave6.seed-state-snapshot.v1" },
    "plane": { "enum": ["neon", "mesh"] },
    "databaseIdentity": { "type": "string", "minLength": 1 },
    "captureKind": {
      "enum": [
        "clean_build_a",
        "clean_build_b",
        "forced_reseed_a",
        "forced_reseed_b",
        "in_place_upgrade"
      ]
    },
    "seedLedgerSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "seedOwnedSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identityCount": { "type": "integer", "minimum": 0 },
    "identityCanonicalSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "capturedAt": { "type": "string", "format": "date-time" },
    "evidenceUri": { "type": "string", "minLength": 1 }
  }
}
