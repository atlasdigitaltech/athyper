{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athyper.local/schemas/preserved-identity-migration-v1.json",
  "title": "Wave 6 preserved identity migration manifest",
  "type": "object",
  "required": [
    "contractVersion",
    "manifestId",
    "plane",
    "expectedDatabase",
    "sourceSnapshotSha256",
    "approvalTicket",
    "fieldAuthority",
    "identities",
    "canonicalSha256"
  ],
  "properties": {
    "contractVersion": { "const": "wave6.preserved-identity.v1" },
    "manifestId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{2,127}$"
    },
    "plane": { "enum": ["neon", "mesh"] },
    "expectedDatabase": { "type": "string", "minLength": 1 },
    "sourceSnapshotSha256": { "$ref": "#/$defs/sha256" },
    "approvalTicket": { "type": "string", "minLength": 1 },
    "fieldAuthority": {
      "const": {
        "principalId": "manifest_immutable",
        "boundaryId": "manifest_immutable",
        "principalCode": "manifest_conflict_fail",
        "displayName": "manifest_conflict_fail",
        "principalType": "manifest_conflict_fail",
        "status": "external_identity_conflict_fail",
        "bindingId": "manifest_immutable",
        "realmKey": "external_identity_immutable",
        "providerCode": "external_identity_immutable",
        "subjectId": "external_identity_immutable",
        "username": "external_identity_conflict_fail",
        "issuer": "external_identity_conflict_fail",
        "clientId": "external_identity_conflict_fail"
      }
    },
    "identities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "principalId",
          "boundaryId",
          "principalCode",
          "displayName",
          "principalType",
          "status",
          "bindingId",
          "realmKey",
          "providerCode",
          "subjectId"
        ],
        "properties": {
          "principalId": { "type": "string", "format": "uuid" },
          "boundaryId": { "type": "string", "format": "uuid" },
          "principalCode": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string", "minLength": 1 },
          "principalType": { "type": "string", "minLength": 1 },
          "status": { "enum": ["active", "inactive", "locked", "retired"] },
          "bindingId": { "type": "string", "format": "uuid" },
          "realmKey": { "type": "string", "minLength": 1 },
          "providerCode": { "type": "string", "minLength": 1 },
          "subjectId": { "type": "string", "minLength": 1 },
          "username": { "type": ["string", "null"] },
          "issuer": { "type": ["string", "null"] },
          "clientId": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "canonicalSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
