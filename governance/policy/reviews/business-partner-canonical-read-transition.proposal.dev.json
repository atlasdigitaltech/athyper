  "rules": [
    "Require an explicit current target permission allow at stored tenant ownership; never derive it from an organization allow.",
    "Retain applicable explicit source and target denials, record ACLs, entitlement, plane, assurance and business constraints.",
    "Do not require a second legacy allow merely as a compatibility prerequisite once this transition is explicitly published.",
    "Do not union source and target allows; no resource-free authorization retries.",
    "Deferred operations remain unavailable; company configuration, credit, reveals, writes, import and export are outside this proposal.",
    "Independent children retain their own stored ownership and authorization checks."
  ],
  "publicationRequirements": [
    "Version and compile the admission strategy into a successor contract; release 19 is immutable.",
