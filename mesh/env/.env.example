# =============================================
# athyper MESH — Local Development Environment
# =============================================
# This is the PRIMARY env file for local development.
#
# Usage:
#   cp .env.example .env          (if using default Docker Compose env)
#   docker compose --env-file ../env/.env.example --profile mesh up -d
#
# Environment-specific files:
#   .env.example              ← Local dev (this file, also aliased as local.env.example)
#   staging.env.example       ← Staging (Ubuntu, managed secrets)
#   production.env.example    ← Production (Ubuntu, SUPERSTAR secrets)
#
# NOTE: The Neon web app (.env.local) uses DIFFERENT variable names for some
# settings because it runs OUTSIDE Docker. See products/neon/apps/web/.env.example
# for the web app's env config.
#
# VARIABLE MAPPING (mesh Docker → neon web localhost):
#   IAM_ISSUER_URL          → KEYCLOAK_BASE_URL (base only, no /realms/...)
#   IAM_DEFAULT_REALM       → KEYCLOAK_REALM
#   IAM_CLIENT_ID           → (not used by web; web uses KEYCLOAK_CLIENT_ID=neon-web)
#   REDIS_URL (memorycache) → REDIS_URL (localhost, with password)
#   DATABASE_URL (dbpool)   → DATABASE_URL (localhost:6432)
#   PUBLIC_BASE_URL (API)   → RUNTIME_API_URL (web accesses API via gateway)

# =============================================
# LOCAL CREDENTIALS — NOT for staging/production
# =============================================
# All credentials below use 'athyperadmin' as both username and password.
# This is intentional for local dev ease-of-use.
# NEVER copy these literal values to staging.env or production.env.
# =============================================

# =============================================
# ENVIRONMENT IDENTITY
# =============================================
# Valid values: local | staging | production
ENVIRONMENT=local
COMPOSE_PROJECT_NAME=athyper-mesh

# =============================================
# RUNTIME CONFIGURATION
# =============================================
MODE=api
MULTITENANT=TRUE
SERVICE_NAME=athyper-runtime
# Hardcoded in local dev. Use ${RELEASE_VERSION} in staging/production.
SERVICE_VERSION=1.0.0
PORT=3000
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT_MS=15000

# =============================================
# PUBLIC URLs
# =============================================
PUBLIC_BASE_URL=https://api.athyper.local
PUBLIC_WEB_URL=https://neon.athyper.local

# =============================================
# BASE PATHS
# =============================================
# IMPORTANT: ../../data / ../../config are correct because all .bat and .sh
# scripts pass each service file with an explicit -f flag.  When Docker Compose
# receives multiple -f files it resolves each file's relative paths from that
# file's own directory.  Since every service file lives one level below
# mesh/compose/ (e.g. db/, telemetry/), ../../data resolves to mesh/data and
# ../../config resolves to mesh/config — NOT the project root.
# DO NOT use compose.yml with `include:` on Windows — env-var relative paths
# are resolved from the project root under include:, giving wrong root-level dirs.
# Windows: Use forward slashes — Docker Compose handles them correctly.
#   Absolute example: C:/Users/you/athyper-private/mesh/data
# Linux/macOS:
#   Absolute example: /home/you/athyper-private/mesh/data
MESH_DATA=../../data
MESH_CONFIG=../../config
ATHYPER_KERNEL_CONFIG_PATH=apps/kernel.config.local.parameter.json
AUTH_DEBUG_EXPOSE_TOKENS=true

# =============================================
# HOSTNAMES (Local Development)
# =============================================
# Gateway & Infrastructure
GATEWAY_HOST=gateway.mesh.athyper.local
IAM_HOST=iam.mesh.athyper.local
OBJECTSTORAGE_HOST=objectstorage.mesh.athyper.local
OBJECTSTORAGE_CONSOLE_HOST=objectstorage.console.mesh.athyper.local

# Observability
TELEMETRY_HOST=telemetry.mesh.athyper.local
METRICS_HOST=metrics.mesh.athyper.local
TRACES_HOST=traces.mesh.athyper.local
LOGS_HOST=logs.mesh.athyper.local

# Applications
APPS_ATHYPER_WEB_HOST=neon.athyper.local
APPS_ATHYPER_API_HOST=api.athyper.local

# =============================================
# GATEWAY (Traefik)
# =============================================
GATEWAY_TLS_OPTIONS=mesh-gateway-tls12@file
DASHBOARD_AUTH_MW=mesh-dashboard-auth@file
GATEWAY_ACCESSLOG=true
GATEWAY_LOG_LEVEL=DEBUG

# =============================================
# SERVICE MEMORY LIMITS
# =============================================
GATEWAY_MEMORY_LIMIT=128m
IAM_MEMORY_LIMIT=768m
OBJECTSTORAGE_MEMORY_LIMIT=256m
MEMORYCACHE_MEMORY_LIMIT=128m
MEMORYCACHE_EXPORTER_MEMORY_LIMIT=64m
TELEMETRY_MEMORY_LIMIT=256m
METRICS_MEMORY_LIMIT=384m
TRACING_MEMORY_LIMIT=256m
LOGGING_MEMORY_LIMIT=384m
LOGSHIPPER_MEMORY_LIMIT=64m
APPS_ATHYPER_MEMORY_LIMIT=256m
DB_MEMORY_LIMIT=512m
DBPOOL_APPS_MEMORY_LIMIT=64m
DBPOOL_AUTH_MEMORY_LIMIT=64m

# =============================================
# DATABASE (PostgreSQL via PgBouncer)
# =============================================
DB_ADMIN_PASSWORD=athyperadmin
DATABASE_URL=postgresql://athyperadmin:athyperadmin@dbpool-apps:6432/athyper_dev1
DATABASE_ADMIN_URL=postgresql://athyperadmin:athyperadmin@db:5432/athyper_dev1
DB_POOL_MAX=5

# =============================================
# CACHE (Redis)
# =============================================
# Uses Docker internal hostname 'memorycache' (the Redis container name)
REDIS_URL=redis://app:athyperadmin@memorycache:6379/0
MEMORYCACHE_PASSWORD=athyperadmin
# Redis client tuning
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_MAX_RETRIES=2
REDIS_ERROR_LOG_COOLDOWN_MS=10000

# =============================================
# OBJECT STORAGE (MinIO S3)
# S3_ACCESS_KEY/S3_SECRET_KEY are also used as
# MinIO root credentials in the objectstorage container
# =============================================
S3_ENDPOINT=http://objectstorage:9000
S3_ACCESS_KEY=athyperadmin
S3_SECRET_KEY=athyperadmin
S3_REGION=us-east-1
S3_BUCKET=athyper-local
S3_USE_SSL=false
# Multipart upload tuning (defaults are conservative and work for most workloads)
S3_MULTIPART_PART_SIZE_MB=5
S3_MULTIPART_QUEUE_SIZE=4
S3_MAX_UPLOAD_MB=100
S3_PRESIGNED_TTL_SECONDS=900

# =============================================
# IAM (Keycloak)
# Maps to KC_BOOTSTRAP_ADMIN_USERNAME / KC_BOOTSTRAP_ADMIN_PASSWORD in compose
# =============================================
IAM_ADMIN=athyperadmin
IAM_ADMIN_PASSWORD=athyperadmin
IAM_DB_URL=jdbc:postgresql://dbpool-auth:6433/athyperauth_dev1?preferQueryMode=simple
IAM_DB_USERNAME=athyperadmin
IAM_DB_PASSWORD=athyperadmin
IAM_ISSUER_URL=https://iam.mesh.athyper.local/realms/athyper
IAM_CLIENT_ID=athyper-api
IAM_CLIENT_SECRET=athyperadmin
IAM_DEFAULT_REALM=athyper

# Platform Control Realm (disabled by default, enable for platform admin features)
PLATFORM_CONTROL_ENABLED=false
PLATFORM_KEYCLOAK_REALM=platform-control
PLATFORM_KEYCLOAK_CLIENT_ID=athyper-admin
PLATFORM_IAM_ISSUER_URL=https://iam.mesh.athyper.local/realms/platform-control

# IAM SMTP (local dev uses Mailhog — no auth required)
# Mailhog SMTP: mailhog:1025 (Docker internal)
# Mailhog Web UI: http://localhost:8025
KC_SMTP_HOST=mailhog
KC_SMTP_PORT=1025
KC_SMTP_FROM=noreply@athyper.local
KC_SMTP_FROM_DISPLAY_NAME=Athyper
KC_SMTP_AUTH=false
KC_SMTP_SSL=false
KC_SMTP_STARTTLS=false
# KC_SMTP_USERNAME and KC_SMTP_PASSWORD are NOT set in local dev (Mailhog requires no auth).
# In staging/production, set these to your SMTP provider credentials.

# Google OAuth (Phase 6 — set credentials to enable pepsi org SSO routing)
# Obtain from: GCP Console → APIs & Services → OAuth 2.0 Credentials
# Redirect URI: https://iam.mesh.athyper.local/realms/athyper/broker/google/endpoint
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (Social Login — set credentials to enable GitHub login button)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# =============================================
# IAM SECRETS (SUPERSTAR env vars)
# =============================================
# These are resolved by kernel config loader
ATHYPER_SUPER__IAM_SECRET__IAM_ATHYPER_CLIENT_SECRET=athyperadmin

# =============================================
# TELEMETRY (OpenTelemetry)
# =============================================
OTLP_ENDPOINT=http://logshipper:4318
TELEMETRY_ADMIN_USER=athyperadmin
TELEMETRY_ADMIN_PASSWORD=athyperadmin
