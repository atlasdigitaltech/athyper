{
  "name": "@athyper/runtime-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "dev:worker": "MODE=worker tsx watch src/app.ts",
    "dev:scheduler": "MODE=scheduler tsx watch src/app.ts",
    "start": "node dist/src/app.js",
    "start:api": "node dist/src/app.js",
    "start:worker": "MODE=worker node dist/src/app.js",
    "start:scheduler": "MODE=scheduler node dist/src/app.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "rls:verify": "pnpm --dir db run db:verify:rls",
    "tenant-stamp:verify": "tsx scripts/verify-tenant-stamp.ts",
    "realm-strict-mfa:verify": "tsx scripts/verify-realm-strict-mfa.ts",
    "field-security:verify": "pnpm --dir db run db:verify:field-security",
    "secdef:verify": "pnpm --dir db run db:verify:secdef",
    "archetypes:verify": "pnpm --dir db run db:verify:archetypes",
    "lookup:diff": "tsx scripts/lookup-diff.ts",
    "meili:backfill": "tsx scripts/meilisearch-backfill.ts",
    "runtime:server-path-check": "tsx scripts/check-runtime-server-paths.ts",
    "meta:hygiene": "tsx scripts/check-meta-entity-hygiene.ts",
    "pi-line-defaults:verify": "tsx scripts/verify-pi-line-default-resolver-coverage.ts",
    "p2p:field-contract:audit": "tsx scripts/audit-p2p-field-contract.ts",
    "metadata:semantic-fallbacks:audit": "tsx scripts/audit-metadata-semantic-fallbacks.ts",
    "metadata:cache-policy:audit": "tsx scripts/audit-metadata-cache-policy.ts",
    "lint": "tsx scripts/check-runtime-server-paths.ts --strict && tsx scripts/verify-pi-line-default-resolver-coverage.ts"
  },
  "dependencies": {
    "@athyper/adapter-auth": "workspace:*",
    "@athyper/adapter-db": "workspace:*",
    "@athyper/adapter-memory-cache": "workspace:*",
    "@athyper/adapter-object-storage": "workspace:*",
    "@athyper/adapter-telemetry": "workspace:*",
    "@athyper/api-contracts": "workspace:*",
    "@athyper/auth-common": "workspace:*",
    "@athyper/runtime-contracts": "workspace:*",
    "@athyper/server-foundation": "workspace:*",
    "@athyper/svc-ai": "workspace:*",
    "@athyper/svc-audit": "workspace:*",
    "@athyper/svc-business": "workspace:*",
    "@athyper/svc-collab": "workspace:*",
    "@athyper/svc-content": "workspace:*",
    "@athyper/svc-doc-services": "workspace:*",
    "@athyper/svc-documents": "workspace:*",
    "@athyper/svc-finance": "workspace:*",
    "@athyper/svc-iam": "workspace:*",
    "@athyper/svc-integration": "workspace:*",
    "@athyper/svc-jobs": "workspace:*",
    "@athyper/svc-master": "workspace:*",
    "@athyper/svc-metadata": "workspace:*",
    "@athyper/svc-policy": "workspace:*",
    "@athyper/svc-platform": "workspace:*",
    "@athyper/svc-records": "workspace:*",
    "@athyper/svc-search": "workspace:*",
    "@athyper/svc-shared": "workspace:*",
    "@athyper/svc-workflow": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.73.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.215.0",
    "@opentelemetry/resources": "^2.7.0",
    "@opentelemetry/sdk-node": "^0.215.0",
    "@opentelemetry/semantic-conventions": "^1.29.0",
    "@sentry/node": "^10.49.0",
    "@simplewebauthn/server": "^13.3.0",
    "@bull-board/api": "^7.0.0",
    "@bull-board/express": "^7.0.0",
    "@bull-board/ui": "^7.0.0",
    "bullmq": "^5.74.1",
    "busboy": "^1.6.0",
    "dotenv": "^17.4.2",
    "jose": "^6.2.2",
    "express": "^5.0.0",
    "kysely": "^0.28.16",
    "nodemailer": "^8.0.5",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "tsx": "^4.19.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "pg": "^8.13.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
