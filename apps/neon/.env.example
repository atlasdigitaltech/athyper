# =============================================
# Neon App — Local Development Environment
# =============================================
# Copy to .env.local before running next dev:
#   cp apps/neon/.env.example apps/neon/.env.local
#
# See stack/env/.env for the Docker-side configuration.
# These variables are for the Next.js app running on the HOST (outside Docker).
#
# Variable mapping from Docker → host:
#   REDIS_URL:        replace 'memorycache' hostname with 'localhost'
#   RUNTIME_API_URL:  replace container hostname 'api' with 'localhost:4000'

# Browser-visible environment used for cross-plane login links.
# local -> *.athyper.local, staging -> *-staging.athyper.com, production -> *.athyper.com.
NEXT_PUBLIC_ENVIRONMENT=local

# Redis (session store)
# Must use localhost since this app runs outside Docker.
# Default local dev credentials — NEVER use in staging/production.
REDIS_URL=redis://app:athyperadmin@localhost:6379/0
AUTH_SUBJECT_CLEANUP_ENABLED=on

# Backend API URL
# Use localhost since the API server runs on the host in local dev.
RUNTIME_API_URL=http://localhost:4000

# Document edit workspace signing. This must exactly match the runtime API.
# Local-only predictable value; staging/production must use managed secrets.
DOCUMENT_EDIT_WORKSPACE_TOKEN_SECRET=local-development-document-edit-workspace-key-2026
# Rotation form (preferred outside local): JSON key ring plus active minting key.
# DOCUMENT_EDIT_WORKSPACE_TOKEN_KEYS={"2026_07":"replace-with-at-least-32-random-characters"}
# DOCUMENT_EDIT_WORKSPACE_TOKEN_ACTIVE_KID=2026_07

# Entity query V1 pilot flags (shadow mode by default)
NEON_ENTITY_QUERY_V1_PILOTS=company_code
NEON_ENTITY_QUERY_V1_MODE=shadow

# Independent kill switch; entries are tenant:entity and support * wildcards.
# DOCUMENT_EDIT_SAVE_AND_TRANSITION_DISABLED=*:purchase_invoice

# Keycloak base URL (no /realms/... suffix)
# NODE_TLS_REJECT_UNAUTHORIZED is auto-set to 0 for *.athyper.local in dev.
KEYCLOAK_BASE_URL=https://iam.athyper.local

# =============================================
# AUTH BFF HARDENING (session role re-check + required-actions gate)
# =============================================
# Periodic AUTHORIZED-role revalidation interval (seconds) inside
# validatePlaneServerSession. 0 disables the periodic tick (the refresh-time
# re-check still runs). Default: 600 (10 minutes).
AUTH_ROLE_RECHECK_INTERVAL_S=600

# Block cookie-based BFF sessions when the user has any KC required_actions
# pending. Default: on (production target). Set to `off` only for local dev
# scenarios where you intentionally seed required actions for testing.
AUTH_BFF_REQUIRED_ACTIONS_BLOCK=on

# =============================================
# ADVANCED OVERRIDES (rarely needed in local dev)
# =============================================
# Explicit URL for the context resolver. Falls back to RUNTIME_API_URL +
# /api/session/contexts when unset. Set this when the runtime API is on a
# different host than the context-resolver endpoint.
# AUTH_CONTEXT_RESOLVER_URL=

# Explicit URL for the IAM service used by the BFF's session-rebuild fallback.
# Falls back to RUNTIME_API_URL when unset.
# IAM_SERVICE_URL=

# Explicit URL for the auth-discovery resolver. Falls back to RUNTIME_API_URL +
# /api/auth/discovery when unset.
# AUTH_DISCOVERY_RESOLVER_URL=

# Optional audit relay endpoint. When set, the BFF POSTs structured audit
# events here (login, refresh, revoke). Leave unset to disable relay.
# AUTH_AUDIT_ENDPOINT=

# Expose decoded token claims on /api/auth/debug/* routes (local dev only —
# NEVER set in staging/production). Default: false.
# AUTH_DEBUG_EXPOSE_TOKENS=true

# Atlas remains hidden unless the runtime environment gate, tenant feature
# flag, and ai.agent.use permission are also enabled.
ATLAS_AGENT_ENABLED=true
ATLAS_CONVERSATION_HISTORY_ENABLED=true
