NODE_ENV=development
PORT=3101
APP_ORIGIN=http://localhost:3101
RUNTIME_API_URL=http://localhost:4000
REDIS_URL=redis://app:athyperadmin@127.0.0.1:6379/0
KEYCLOAK_BASE_URL=https://iam.athyper.local
# Development-only deterministic 32-byte key. Inject a random secret in staging/production.
SESSION_TOKEN_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Optional overrides: NEON_KEYCLOAK_REALM, NEON_KEYCLOAK_CLIENT_ID, KEYCLOAK_CLIENT_SECRET, SESSION_KEY_VERSION, SESSION_STORE_VERSION, SESSION_TOKEN_PREVIOUS_KEYS, AUTH_CONFIGURATION_REVISION, AUTH_TRUSTED_DEVICE_TTL_DAYS

# Optional session lifetime overrides (seconds); align with the Keycloak realm/client.
# DEV Studio/Neon: idle 7200, absolute 43200. Unset retains plane defaults.
# AUTH_SESSION_IDLE_TTL_SECONDS=7200
# AUTH_SESSION_ABSOLUTE_TTL_SECONDS=43200
