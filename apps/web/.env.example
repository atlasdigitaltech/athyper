# =============================================
# Neon Web App — Local Development Environment
# =============================================
# USAGE: Copy to .env.local for local development:
#   cp .env.example .env.local
#
# This file uses LOCALHOST addresses (web app runs outside Docker).
# It differs from mesh/env/.env.example which uses Docker-internal hostnames.
# For staging/production the web app runs inside the mesh and receives
# env vars via the Docker Compose service definition — no separate env file needed.
#
# Variable mapping (mesh Docker env → this file):
#   IAM_ISSUER_URL          → KEYCLOAK_BASE_URL (base URL only, no /realms/...)
#   IAM_DEFAULT_REALM       → KEYCLOAK_REALM
#   IAM_CLIENT_ID           → (not used; web uses KEYCLOAK_CLIENT_ID=neon-web)
#   REDIS_URL (memorycache) → REDIS_URL (127.0.0.1, with password)
#   DATABASE_URL (dbpool)   → DATABASE_URL (127.0.0.1:6432)
#   PUBLIC_BASE_URL (API)   → RUNTIME_API_URL

# =============================================
# ENVIRONMENT
# =============================================
ENVIRONMENT=local

# =============================================
# PUBLIC URLs
# =============================================
# Used to build the OAuth2 redirect_uri.
# Must exactly match a registered Keycloak client redirect URI.
PUBLIC_BASE_URL=http://localhost:3000

# =============================================
# KEYCLOAK (IAM)
# =============================================
KEYCLOAK_BASE_URL=https://iam.mesh.athyper.local
KEYCLOAK_REALM=athyper
KEYCLOAK_CLIENT_ID=neon-web
# Admin credentials for server-side KC admin API calls (org attribute enrichment)
# KC 26.5.1 doesn't expose per-org roles via REST; workbenches are read from org attributes.
KEYCLOAK_ADMIN_USERNAME=athyperadmin
KEYCLOAK_ADMIN_PASSWORD=athyperadmin

# =============================================
# PLATFORM CONTROL REALM (optional)
# Enable only when the platform-control realm is configured in Keycloak.
# =============================================
PLATFORM_CONTROL_ENABLED=false
PLATFORM_KEYCLOAK_REALM=platform-control
PLATFORM_KEYCLOAK_CLIENT_ID=athyper-admin
# Note: The mesh env has PLATFORM_IAM_ISSUER_URL as a full URL.
# This app constructs it at runtime from KEYCLOAK_BASE_URL + PLATFORM_KEYCLOAK_REALM.

# =============================================
# RUNTIME API (Framework Backend)
# The web BFF proxies data-plane calls to this URL.
# In Docker Compose: accessible via gateway host.
# In local dev: https://api.athyper.local (via Traefik).
# =============================================
RUNTIME_API_URL=http://localhost:4000
# Optional: separate collab service URL. Defaults to RUNTIME_API_URL if not set.
# Set only if the collab service runs on a different host/port.
# COLLAB_API_URL=http://localhost:4001

# =============================================
# REDIS (Session Storage)
# Must use 127.0.0.1 (not localhost) — on Windows, 'localhost' resolves to
# IPv6 ::1 first but Docker only binds to IPv4, causing ECONNRESET.
# The mesh .env.example uses 'memorycache' (Docker internal hostname).
# =============================================
REDIS_URL=redis://app:athyperadmin@127.0.0.1:6379/0

# =============================================
# FEATURE FLAGS (NEXT_PUBLIC_ = exposed to browser bundle)
# =============================================
# Show "Continue with GitHub" button on the login page
NEXT_PUBLIC_GITHUB_LOGIN_ENABLED=false
# Show "Platform Admin" link on the login page
NEXT_PUBLIC_PLATFORM_CONTROL_ENABLED=false

# =============================================
# SOCIAL LOGIN — GITHUB
# =============================================
# GITHUB_OAUTH_CLIENT_ID / GITHUB_OAUTH_CLIENT_SECRET are NOT set here.
# Social login OAuth credentials are configured in Keycloak (Identity Provider Broker).
# Set them in mesh/env/.env under the GitHub OAuth section.
# The web app only sends kc_idp_hint=github to Keycloak — it never calls GitHub directly.

# Provider → tenant mapping (dynamic key: <PROVIDER>_TENANT_ID)
# When a social login has no KC org claim, this maps the provider to a tenant.
GITHUB_TENANT_ID=demo_in

# =============================================
# DEBUG
# =============================================
# Disable TLS verification for local dev (self-signed certs)
NODE_TLS_REJECT_UNAUTHORIZED=0
