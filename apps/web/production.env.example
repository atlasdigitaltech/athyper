# =============================================
# Neon Web App — Production Environment
# =============================================
# Used when the web app runs OUTSIDE the stack Docker network
# (split-server topology or standalone Next.js host).
#
# If apps/web runs inside the stack Docker Compose (athyper-neon-web service),
# vars are injected by the compose service — this file is NOT needed.
#
# Copy to .env.local:
#   cp apps/web/production.env.example apps/web/.env.local
#
# All ${VAR} references must be sourced from your CI/CD secret store.

# =============================================
# ENVIRONMENT
# =============================================
ENVIRONMENT=production

# =============================================
# F8: HOST GUARD (single-ingress enforcement)
# =============================================
ALLOWED_HOSTS=neon.athyper.com
GATEWAY_ORIGIN=https://neon.athyper.com
# ALLOW_DIRECT_ACCESS=true

# =============================================
# PUBLIC URLs
# =============================================
# Must exactly match a registered Keycloak client redirect URI.
PUBLIC_BASE_URL=https://neon.athyper.com

# =============================================
# KEYCLOAK (IAM)
# =============================================
KEYCLOAK_BASE_URL=https://iam.athyper.com
KEYCLOAK_REALM=athyper
KEYCLOAK_CLIENT_ID=neon-web
KEYCLOAK_ADMIN_USERNAME=${KEYCLOAK_ADMIN_USERNAME}
KEYCLOAK_ADMIN_PASSWORD=${KEYCLOAK_ADMIN_PASSWORD}

# =============================================
# PLATFORM CONTROL REALM (optional)
# =============================================
PLATFORM_CONTROL_ENABLED=false
PLATFORM_KEYCLOAK_REALM=platform-control
PLATFORM_KEYCLOAK_CLIENT_ID=athyper-admin

# =============================================
# RUNTIME API (Framework Backend)
# =============================================
# Split-server: use the public API hostname.
# Same-server Docker: use Docker-internal URL (e.g. http://athyper-runtime:4000).
RUNTIME_API_URL=https://api.athyper.com

# =============================================
# REDIS (Session Storage)
# =============================================
# Redis is Docker-internal. Expose port 6379 on the stack host (firewall-gated),
# or use a managed Redis service.
REDIS_URL=${REDIS_URL}

# =============================================
# FEATURE FLAGS
# =============================================
NEXT_PUBLIC_GITHUB_LOGIN_ENABLED=false
NEXT_PUBLIC_PLATFORM_CONTROL_ENABLED=false

# =============================================
# SOCIAL LOGIN — GITHUB
# =============================================
GITHUB_TENANT_ID=

# =============================================
# OBSERVABILITY — Sentry / GlitchTip (frontend)
# =============================================
NEXT_PUBLIC_SENTRY_DSN=${NEXT_PUBLIC_SENTRY_DSN}
SENTRY_DSN=${GLITCHTIP_DSN}
NEXT_PUBLIC_ENVIRONMENT=production
NEXT_PUBLIC_SERVICE_VERSION=${RELEASE_VERSION}
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.01
SENTRY_TRACES_SAMPLE_RATE=0.01
SENTRY_ORG=${SENTRY_ORG}
SENTRY_PROJECT=${SENTRY_PROJECT}
SENTRY_URL=${SENTRY_URL}
SENTRY_AUTH_TOKEN=${SENTRY_AUTH_TOKEN}
