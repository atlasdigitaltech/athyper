    "paths": {
      "@/*": ["./*"],
      "@athyper/ui": ["../../packages/shared/ui-platform/ui/src/index.ts"],
      "@athyper/meta-entity-authoring-contracts": ["../../packages/shared/data-integration/meta-entity-authoring-contracts/src/index.ts"],
      "@athyper/meta-entity-runtime": ["../../packages/products/admin/meta-entity-runtime/src/index.ts"],
