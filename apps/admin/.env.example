# =============================================
# Admin App — Local Development Environment
# =============================================
# Copy to .env.local before running next dev:
#   cp apps/admin/.env.example apps/admin/.env.local
#
# See stack/env/.env for the Docker-side configuration.
# These variables are for the Next.js app running on the HOST (outside Docker).

# Redis (session store)
# Must use localhost since this app runs outside Docker.
# Default local dev credentials — NEVER use in staging/production.
REDIS_URL=redis://app:athyperadmin@localhost:6379/0

# Backend API URL
# Use localhost since the API server runs on the host in local dev.
RUNTIME_API_URL=http://localhost:4000

# Keycloak base URL (no /realms/... suffix)
# NODE_TLS_REJECT_UNAUTHORIZED is auto-set to 0 for *.athyper.local in dev.
KEYCLOAK_BASE_URL=https://iam.athyper.local
