# =============================================
# Neon Web — Local Development Environment
# =============================================
# Copy this file to .env.local and adjust as needed:
#   cp .env.example .env.local
#
# PREREQUISITES:
#   1. Docker mesh running:
#        cd mesh && docker compose --env-file ../env/.env.example --profile mesh up -d
#   2. Hosts file entries (see HOSTS FILE below)
#   3. Keycloak realm imported:
#        cd mesh/scripts && ./initdb-iam.sh
#
# HOSTS FILE (add to C:\Windows\System32\drivers\etc\hosts or /etc/hosts):
#   127.0.0.1 gateway.mesh.athyper.local
#   127.0.0.1 iam.mesh.athyper.local
#   127.0.0.1 objectstorage.mesh.athyper.local
#   127.0.0.1 neon.athyper.local
#   127.0.0.1 api.athyper.local
#
# IMPORTANT: This web app runs OUTSIDE Docker (via `pnpm dev`).
# The mesh services (Keycloak, Redis, PostgreSQL, MinIO) run INSIDE Docker.
# All URLs below use localhost or *.athyper.local (resolved via hosts file).
# =============================================

# =============================================
# ENVIRONMENT
# =============================================
ENVIRONMENT=local

# =============================================
# PUBLIC URLs
# =============================================
# Public base URL of THIS web app (used for OAuth redirect URIs).
# Must match your Next.js dev server port (default: 3001).
PUBLIC_BASE_URL=http://localhost:3001

# Public app URL (used for post-logout redirect). Falls back to PUBLIC_BASE_URL if unset.
# NEXT_PUBLIC_APP_URL=http://localhost:3001

# =============================================
# REDIS (Session Storage)
# =============================================
# The web app stores sessions, CSRF tokens, and PKCE state in Redis.
#
# Option A — Docker mesh Redis (recommended):
#   Redis runs inside Docker on port 6379, password = athyperadmin
REDIS_URL=redis://:athyperadmin@localhost:6379/0
#
# Option B — Standalone Redis (no password):
# REDIS_URL=redis://localhost:6379/0

# =============================================
# DATABASE (Optional — enables tenant UUID resolution)
# =============================================
# When set, the app resolves DEFAULT_TENANT_ID to a UUID from core.tenant table.
# When unset, tenant resolution uses the raw DEFAULT_TENANT_ID string as-is.
# Uses PgBouncer port 6432 (not direct PostgreSQL 5432).
DATABASE_URL=postgresql://athyperadmin:athyperadmin@localhost:6432/athyper_dev1

# =============================================
# KEYCLOAK (IAM)
# =============================================
# Base URL of the Keycloak server (via Traefik gateway with TLS)
KEYCLOAK_BASE_URL=https://iam.mesh.athyper.local
# Realm name — must match the realm imported into Keycloak
KEYCLOAK_REALM=athyper
# Client ID for this web app — registered in Keycloak as a public client
KEYCLOAK_CLIENT_ID=neon-web

# =============================================
# PLATFORM CONTROL REALM (Optional)
# =============================================
# Enable for platform admin features (tenant switching, cross-tenant support).
# Uses a separate Keycloak realm with its own client.
PLATFORM_CONTROL_ENABLED=false
PLATFORM_KEYCLOAK_REALM=platform-control
PLATFORM_KEYCLOAK_CLIENT_ID=athyper-admin

# =============================================
# RUNTIME API (Framework Backend)
# =============================================
# URL of the athyper runtime API (accessed via Traefik gateway).
# Used for MFA, tenant listing, health checks, and meta-studio.
RUNTIME_API_URL=https://api.athyper.local

# Mesh API backend URL (used for collaboration routes: comments, flags, analytics).
# In local dev this is the same runtime API via the gateway.
API_MESH_URL=https://api.athyper.local

# =============================================
# TENANT
# =============================================
# Default tenant ID for session namespacing and data isolation.
# In local dev with a single tenant, "default" is fine.
# If DATABASE_URL is set, this is resolved to a UUID from core.tenant.
DEFAULT_TENANT_ID=default

# =============================================
# SOCIAL LOGIN — GITHUB (via Keycloak IdP)
# =============================================
# GitHub OAuth App credentials — used by Keycloak as an Identity Provider.
# The Next.js app itself does NOT call GitHub directly; Keycloak brokers the OAuth flow.
# GitHub OAuth App callback URL must be set to:
#   {KEYCLOAK_BASE_URL}/realms/{KEYCLOAK_REALM}/broker/github/endpoint
GITHUB_OAUTH_CLIENT_ID=Ov23liIgDgW7ohpcUO2N
GITHUB_OAUTH_CLIENT_SECRET=e230aae5d7bb7eb955a6d4011c7a75be004ba506

# =============================================
# SOCIAL LOGIN — PROVIDER TENANT MAPPING
# =============================================
# Hard-map a social login provider to a specific tenant, bypassing JWT/org claims.
# Pattern: {PROVIDER_UPPERCASED}_TENANT_ID
# Use this when Keycloak's organization claim returns the wrong tenant for a given IdP.
# e.g. GitHub users belong to demo_in, Microsoft users belong to demo_ca.
GITHUB_TENANT_ID=demo_in
MICROSOFT_TENANT_ID=demo_ca

# =============================================
# DEBUG & DEVELOPMENT
# =============================================
# Expose full JWT tokens at GET /api/auth/debug (PII is always redacted)
AUTH_DEBUG_EXPOSE_TOKENS=true

# TLS — accept self-signed certs from mesh gateway (LOCAL DEV ONLY!)
# NEVER set this in staging or production.
NODE_TLS_REJECT_UNAUTHORIZED=0

# Dev stubs: return mock data when runtime API is unreachable (GET requests only)
ENABLE_DEV_STUBS=true
