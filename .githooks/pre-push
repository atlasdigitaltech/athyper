#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────
# pre-push hook — athyper
# Blocks direct pushes to protected branches: main, develop.
# All changes must go through a Pull Request.
#
# Also: verifies that KC theme brand assets are in sync with the
# canonical source before any push. Prevents stale assets from
# reaching the remote.
#
# Flow:  feature/* → PR → develop → PR → main
#
# To bypass in a genuine emergency:
#   git push --no-verify
# ─────────────────────────────────────────────────────────────

REMOTE="$1"

while read local_ref local_sha remote_ref remote_sha; do
  # Extract branch name from ref (refs/heads/main → main)
  remote_branch="${remote_ref#refs/heads/}"

  if [ "$remote_branch" = "main" ] || [ "$remote_branch" = "develop" ]; then
    # Allow pushes from CI/CD context (GitHub Actions)
    if [ -n "$CI" ] || [ -n "$GITHUB_ACTIONS" ]; then
      exit 0
    fi

    echo ""
    echo "  ✖  Direct push to '$remote_branch' on remote '$REMOTE' is not allowed."
    echo ""
    echo "  Branch workflow:"
    echo "    feature/* ──PR──► develop ──PR──► main"
    echo ""
    echo "    1. git push origin feature/your-feature"
    echo "    2. Open a Pull Request → develop on GitHub"
    echo "    3. Get at least 1 peer review → merge"
    echo ""
    echo "  Emergency bypass: git push --no-verify"
    echo ""
    exit 1
  fi
done

# ── Brand sync verification ───────────────────────────────────
# Verify KC brand assets match the canonical source before push.
# Catches cases where brand source changed but sync was not run.

if command -v pnpm &>/dev/null; then
  pnpm brand:verify
  if [ $? -ne 0 ]; then
    echo ""
    echo "  Fix: run  pnpm brand:refresh  then commit the updated files."
    echo ""
    exit 1
  fi
fi

# ── Generated-artifact drift ──
# The fast subset of pnpm policy:static: checks whose only failure mode is a
# stale committed artifact. Each has a one-command fix, so catching them here
# costs seconds instead of a full CI round trip. The expensive architectural
# policies stay in CI. inventory:authorization:check is deliberately excluded:
# it also reports unknownSources findings that no regeneration can clear.
#
# Skip for a deliberate work-in-progress push:  ATHYPER_SKIP_DRIFT=1 git push

if [ -z "$ATHYPER_SKIP_DRIFT" ] && command -v pnpm &>/dev/null; then
  echo ""
  echo "  [drift] Checking generated artifacts (~10s; ATHYPER_SKIP_DRIFT=1 to skip)..."

  drift_failed=""

  check_drift() {
    if ! pnpm "$1" >/dev/null 2>&1; then
      drift_failed="$drift_failed\n    pnpm $1  →  fix: pnpm $2"
    fi
  }

  check_drift inventory:server-rebuild:check                  inventory:server-rebuild
  check_drift routes:server-manifest:check                    routes:server-manifest
  check_drift inventory:authorization-data-disposition:check  "exec node tooling/scripts/policy/authorization-data-disposition.mjs --artifacts-only"
  check_drift urls:check                                      urls:generate
  check_drift format:changed:check                            format:changed

  if [ -n "$drift_failed" ]; then
    echo ""
    echo "  ✖  Generated artifacts are stale. CI will reject this push."
    echo ""
    printf "  Stale:$drift_failed\n"
    echo ""
    echo "  Run the fix command(s), commit the regenerated files, then push again."
    echo "  Emergency bypass: git push --no-verify"
    echo ""
    exit 1
  fi

  echo "  ✓  Generated artifacts are in sync."
  echo ""
fi

exit 0
