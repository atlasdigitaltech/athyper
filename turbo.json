{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "4",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "codegen": {
      "inputs": ["prisma/**"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "codegen"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "inputs": ["src/**", "**/*.{ts,mts,cts}", "tsconfig.json", "package.json"]
    },
    "dev": { "cache": false, "persistent": true },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "**/*.{ts,mts,cts}"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "**/*.{ts,mts,cts}", "tsconfig.json"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "**/*.{ts,mts,cts}", "tests/**", "vitest.config.*"]
    },
    "contracts:check": {
      "dependsOn": ["^build"],
      "inputs": ["src/**"],
      "outputs": []
    },
    "clean": { "cache": false }
  }
}
