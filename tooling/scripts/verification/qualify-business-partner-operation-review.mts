import {chromium} from '@playwright/test';
import {writeFileSync} from 'node:fs';
const [account,statePath,output]=process.argv.slice(2);
if(!['catl.owner','catl.admin'].includes(account??'')||!statePath||!output)throw Error('Usage: qualify-business-partner-operation-review.mts <catl.owner|catl.admin> <state.json> <report.json>');
const origin='https://neon.dev.athyper.test';const browser=await chromium.launch();try{const context=await browser.newContext({ignoreHTTPSErrors:true,storageState:statePath});const page=await context.newPage();const errors:string[]=[];page.on('pageerror',e=>errors.push(e.message));await page.goto(origin+'/mdg/operation-review');const r=await context.request.get(origin+'/api/governance/operation-review');const body=await r.json();if(!r.ok())throw Error(`review unavailable:${r.status()}:${body.code}`);await page.getByRole('button',{name:'Record 0 explicit decisions',exact:true}).waitFor();const selects=await page.locator('select').evaluateAll(nodes=>nodes.map(n=>n.value));const disabled=await page.getByRole('button',{name:'Record 0 explicit decisions',exact:true}).isDisabled();const bad=await context.request.post(origin+'/api/governance/operation-review',{headers:{origin},data:{}});const evidence={generatedAt:new Date().toISOString(),account,reviewerId:body.reviewerId,status:r.status(),assurance:body.assurance,rows:body.rows.length,receipts:body.receipts.length,allDecisionsInitiallyEmpty:selects.every(v=>v===''),recordInitiallyDisabled:disabled,pageErrors:errors,missingCsrfStatus:bad.status(),realDecisionsSubmitted:false,grantChanges:[],activationAuthorized:false};writeFileSync(output,JSON.stringify(evidence,null,2)+'\n');console.log(JSON.stringify(evidence));if(body.reviewerId!==account||body.rows.length!==51||!disabled||selects.some(v=>v)||errors.length||bad.status()!==403)throw Error('Qualification failed');await context.close();}finally{await browser.close();}
