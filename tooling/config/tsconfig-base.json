{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "declaration": true,
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "lib": ["ES2022"]
  }
}
