{
  "uid": "athyper-governance",
  "title": "Athyper Governance Overview",
  "description": "Archive lifecycle, legal holds, content quotas, and privacy guard metrics",
  "tags": ["athyper", "governance", "compliance"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "tenant",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values({__name__=~\"gov_.*\"}, tenant)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Archive Job Backlog",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [
        { "expr": "gov_archive_job_backlog", "legendFormat": "Backlog" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 200 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Held Manifests",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [
        { "expr": "gov_manifests_held", "legendFormat": "Held" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Active Legal Holds",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [
        { "expr": "gov_legal_holds_active", "legendFormat": "Active" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "blue", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Purge-Ready Manifests",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [
        { "expr": "gov_manifests_purge_ready", "legendFormat": "Purge Ready" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Current Quota Breaches",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [
        { "expr": "gov_quota_breaches{tenant=~\"$tenant\"}", "legendFormat": "{{ quota_key }}" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "PII Detections",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "targets": [
        { "expr": "clamp_min(delta(gov_privacy_guard_warned{tenant=~\"$tenant\"}[1h]), 0)", "legendFormat": "Detected (1h)" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 10,
      "title": "Archive Jobs Throughput",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "gov_archive_jobs_completed{tenant=~\"$tenant\"}", "legendFormat": "Completed (24h)" },
        { "expr": "gov_archive_jobs_failed{tenant=~\"$tenant\"}", "legendFormat": "Failed (24h)" }
      ]
    },
    {
      "id": 11,
      "title": "Legal Hold Events",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "clamp_min(delta(gov_legal_holds_created{tenant=~\"$tenant\"}[5m]), 0)", "legendFormat": "Created" },
        { "expr": "clamp_min(delta(gov_legal_holds_released{tenant=~\"$tenant\"}[5m]), 0)", "legendFormat": "Released" },
        { "expr": "gov_legal_hold_overlaps{tenant=~\"$tenant\"}", "legendFormat": "Active overlaps" }
      ]
    },
    {
      "id": 20,
      "title": "Quota Utilization by Key",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "gov_quota_utilization_pct{tenant=~\"$tenant\"}", "legendFormat": "{{ quota_key }}" }
      ],
      "fieldConfig": {
        "defaults": {
          "max": 120,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      }
    },
    {
      "id": 21,
      "title": "Privacy Guard Activity",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "clamp_min(delta(gov_privacy_guard_inspected{tenant=~\"$tenant\"}[5m]), 0)", "legendFormat": "Inspected (5m)" },
        { "expr": "clamp_min(delta(gov_privacy_guard_warned{tenant=~\"$tenant\"}[5m]), 0)", "legendFormat": "PII detected (5m)" }
      ]
    },
    {
      "id": 30,
      "title": "Legal Hold Manifest Pressure",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        { "expr": "gov_manifests_held{tenant=~\"$tenant\"}", "legendFormat": "Held" },
        { "expr": "gov_manifests_purge_ready{tenant=~\"$tenant\"}", "legendFormat": "Purge-ready" },
        { "expr": "gov_legal_hold_overlaps{tenant=~\"$tenant\"}", "legendFormat": "Overlaps" }
      ],
      "fieldConfig": { "defaults": {} }
    },
    {
      "id": 31,
      "title": "Legal Hold Lifecycle Totals",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        { "expr": "gov_legal_holds_created{tenant=~\"$tenant\"}", "legendFormat": "Created" },
        { "expr": "gov_legal_holds_released{tenant=~\"$tenant\"}", "legendFormat": "Released" }
      ]
    },
    {
      "id": 40,
      "title": "Archive Job Totals",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "targets": [
        { "expr": "gov_archive_jobs_completed{tenant=~\"$tenant\"}", "legendFormat": "Completed (24h)" },
        { "expr": "gov_archive_jobs_failed{tenant=~\"$tenant\"}", "legendFormat": "Failed (24h)" }
      ]
    },
    {
      "id": 41,
      "title": "Privacy Guard Totals",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [
        { "expr": "gov_privacy_guard_inspected{tenant=~\"$tenant\"}", "legendFormat": "Inspected (30d)" },
        { "expr": "gov_privacy_guard_warned{tenant=~\"$tenant\"}", "legendFormat": "PII detected (30d)" }
      ]
    }
  ]
}
