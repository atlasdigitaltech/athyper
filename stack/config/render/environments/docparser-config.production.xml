<?xml version="1.0" encoding="UTF-8"?>
<!--
  Apache Tika server config — athyper render pipeline
  Environment: PRODUCTION

  Production locks in the strictest parser policy and the largest
  timeout window we accept. Anything beyond longRunningTaskTimeoutMillis
  is a caller-side problem (attachment too big → reject at upload
  validation, not here). See ../README.md for the contract.
-->
<properties>
  <parsers>
    <parser class="org.apache.tika.parser.DefaultParser">
      <!-- Security: no executable extraction. Non-negotiable in prod. -->
      <parser-exclude class="org.apache.tika.parser.executable.ExecutableParser"/>
    </parser>
  </parsers>

  <service-loader
      initializableProblemHandler="ignore"
      loadErrorHandler="IGNORE"/>

  <server>
    <params>
      <enableUnsecureFeatures>false</enableUnsecureFeatures>

      <!-- 5 min / 10 min. Tuned to accommodate scanned-PDF OCR on
           ~100-page documents without holding the pool indefinitely. -->
      <taskTimeoutMillis>300000</taskTimeoutMillis>
      <taskPulseMillis>10000</taskPulseMillis>
      <longRunningTaskTimeoutMillis>600000</longRunningTaskTimeoutMillis>
    </params>
  </server>
</properties>
