{
  "kind": "athyper.keycloak.realm-demo-setup",
  "version": 3,
  "realm": "athyper",
  "planes": [
    "neon",
    "mesh",
    "admin"
  ],
  "sourceRealmFile": "realm-athyper.json",
  "importableByKeycloak": false,
  "description": "Unified athyper demo IAM setup. One Keycloak realm serves Neon, Mesh, and Admin through plane-scoped clients. Keycloak organizations use stable ORG-* aliases; business meaning is carried by tenant_code, legal_entity_code, buyer_account_code, and supplier_account_code attributes.",
  "namingPolicy": {
    "organizationAlias": "ORG-{10-digit-zero-padded}",
    "tenantLegalEntityBlock": "ORG-1000000001..ORG-1999999999",
    "partnerSupplierBlock": "ORG-3000000001..ORG-3999999999",
    "networkAccountCode": "BNA-{10-digit-zero-padded}",
    "requiredClientRole": "AUTHORIZED",
    "realmRoles": [
      "NEON_USER",
      "MESH_BUYER_USER",
      "MESH_PARTNER_USER",
      "ADMIN_USER"
    ]
  },
  "organizationAttributePolicy": {
    "tenant_code": "Required when NEON_USER or ADMIN_USER is granted for the organization context.",
    "legal_entity_code": "Required when NEON_USER or ADMIN_USER is granted for the organization context.",
    "buyer_account_code": "Required when MESH_BUYER_USER is granted for the organization context.",
    "supplier_account_code": "Required when MESH_PARTNER_USER is granted for the organization context."
  },
