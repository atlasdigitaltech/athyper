  "additionalProperties": false,
  "definitions": {
    "RealmConfig": {
      "type": "object",
      "required": ["iam"],
      "properties": {
        "defaults": {
          "type": "object",
          "description": "Free-form realm-level defaults (feature flags, policies, etc.)",
          "additionalProperties": true,
          "default": {}
        },
        "iam": {
          "type": "object",
          "required": ["issuerUrl", "clientId"],
          "properties": {
            "issuerUrl": {
              "type": "string",
              "format": "uri",
              "description": "OIDC issuer URL (e.g. https://iam.athyper.local/realms/athyper)"
            },
            "clientId": {
              "type": "string",
              "minLength": 1,
              "description": "OIDC client ID for audience validation (bearer-only resource server)"
            },
            "allowedAzp": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "description": "Authorized party (azp) allowlist — tokens must originate from one of these clients"
            },
            "clientSecretRef": {
              "type": "string",
              "minLength": 1,
              "description": "Reference name for SUPERSTAR env secret resolution (ATHYPER_SUPER__IAM_SECRET__<ref>)"
            }
          },
          "additionalProperties": false
        },
        "redirectUriAllowlist": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Redirect URI allowlist for this realm. In production, no wildcards are permitted."
        },
        "featureFlags": {
          "type": "object",
          "description": "Auth feature flags for gradual rollout.",
          "properties": {
            "bffSessions": {
              "type": "boolean",
              "default": false,
              "description": "Enable Redis-backed BFF sessions (vs. cookie-only)"
            },
            "refreshRotation": {
              "type": "boolean",
              "default": false,
              "description": "Enable refresh token rotation on every use"
            },
            "csrfProtection": {
              "type": "boolean",
              "default": false,
              "description": "Enable CSRF double-submit enforcement"
            },
            "strictIssuerCheck": {
              "type": "boolean",
              "default": false,
              "description": "Enable strict JWT issuer validation at API boundary"
            },
            "pkceFlow": {
              "type": "boolean",
              "default": false,
              "description": "Enable PKCE authorization code flow (vs. direct grant)"
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "platformMinimums": {
          "type": "object",
          "description": "Platform-level IAM security minimums. Tenants cannot configure values weaker than these.",
          "properties": {
            "passwordMinLength": {
              "type": "integer",
              "minimum": 1,
              "default": 8,
              "description": "Minimum password length"
            },
            "passwordHistory": {
              "type": "integer",
              "minimum": 0,
              "default": 1,
              "description": "Number of previous passwords to remember"
            },
            "maxLoginFailures": {
              "type": "integer",
              "minimum": 1,
              "default": 10,
              "description": "Maximum login failures before lockout"
            },
            "lockoutDurationMinutes": {
              "type": "integer",
              "minimum": 1,
              "default": 5,
              "description": "Account lockout duration in minutes"
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "tenants": {
          "type": "object",
          "description": "Map of tenant keys to tenant configurations",
          "additionalProperties": {
            "$ref": "#/definitions/TenantConfig"
          },
          "default": {}
        }
      },
      "additionalProperties": false
    },
    "TenantConfig": {
      "type": "object",
      "properties": {
        "defaults": {
          "type": "object",
          "description": "Free-form tenant-level defaults (country, currency, timezone, etc.)",
          "additionalProperties": true,
          "default": {}
        },
        "orgs": {
          "type": "object",
          "description": "Map of org keys to org configurations",
          "additionalProperties": {
            "$ref": "#/definitions/OrgConfig"
          },
          "default": {}
        }
      },
      "additionalProperties": false
    },
    "OrgConfig": {
      "type": "object",
      "properties": {
        "defaults": {
          "type": "object",
          "description": "Free-form org-level defaults",
          "additionalProperties": true,
          "default": {}
        }
      },
      "additionalProperties": false
    }
  }
}
