# =============================================
# athyper Stack — Production Environment
# =============================================
# Deploy on Ubuntu. All secrets injected via SUPERSTAR env vars / secrets manager.
# Copy to production.env and fill in ${VAR} references before deploying.
#
# Environment-specific files:
#   .env.example              ← Local dev
#   staging.env.example       ← Staging
#   production.env.example    ← Production (this file)

# =============================================
# ENVIRONMENT IDENTITY
# =============================================
ENVIRONMENT=production
# Pinned — must match across all envs so container/volume/network names are
# stable. Changing this renames every container and orphans all named volumes.
COMPOSE_PROJECT_NAME=athyper

# =============================================
# RUNTIME CONFIGURATION
# =============================================
MODE=api
MULTITENANT=TRUE
SERVICE_NAME=athyper-runtime
SERVICE_VERSION=${RELEASE_VERSION}
WEB_PORT=3000
API_PORT=3000
LOG_LEVEL=warn
SHUTDOWN_TIMEOUT_MS=60000
NODE_ENV=production
NODE_TLS_REJECT_UNAUTHORIZED=1

# =============================================
# PUBLIC URLs
# =============================================
PUBLIC_BASE_URL=https://api.athyper.com
PUBLIC_WEB_URL=https://neon.athyper.com
PUBLIC_NEON_URL=https://neon.athyper.com
PUBLIC_MESH_URL=https://mesh.athyper.com
PUBLIC_ADMIN_URL=https://admin.athyper.com

# =============================================
# BASE PATHS (server runtime roots)
# =============================================
# These six vars are set via systemd Environment= lines in athyper-stack.service,
# NOT here. compose.sh reads them and exports ATHYPER_CONFIG / ATHYPER_DATA as
# backwards-compat aliases so compose bind mounts do not need to change.
#
# Server values (set in systemd unit, /opt/stack/athyper/ two-root layout):
#   ATHYPER_CONFIG_ROOT  = /opt/stack/athyper/config
#   ATHYPER_SECRETS_ROOT = /opt/stack/athyper/secrets
#   ATHYPER_DATA_ROOT    = /opt/stack/athyper/data
#   ATHYPER_LOG_ROOT     = /opt/stack/athyper/logs
#   ATHYPER_BACKUP_ROOT  = /opt/stack/athyper/backups
#
# Do NOT set ATHYPER_DATA or ATHYPER_CONFIG here — they are derived aliases.
ATHYPER_KERNEL_CONFIG_PATH=apps/kernel.config.production.parameter.json
AUTH_DEBUG_EXPOSE_TOKENS=false
# =============================================
# HOSTNAMES
# =============================================
# Gateway & Infrastructure
GATEWAY_HOST=gateway.athyper.com
IAM_HOST=iam.athyper.com
OBJECTSTORAGE_HOST=objectstorage.athyper.com
OBJECTSTORAGE_CONSOLE_HOST=objectstorage.console.athyper.com

# Observability
TELEMETRY_HOST=telemetry.athyper.com
METRICS_HOST=metrics.athyper.com
ALERTMANAGER_HOST=alerts.athyper.com
TRACES_HOST=traces.athyper.com
LOGS_HOST=logs.athyper.com

# Monitoring (monitoring profile — enabled in production)
STATUSWATCH_HOST=uptime.athyper.com
CRONWATCH_HOST=healthchecks.athyper.com
ERRORCOLLECT_HOST=errors.athyper.com

# Admin — NOT deployed by default in production.
# BullBoard is embedded in the API runtime at /api/jobs/admin/board,
# gated by RBAC permissions JOBS.BOARD.VIEW / JOBS.QUEUE.MANAGE.
# The sidecar container (compose profile `emergency`) carries no public
# hostname and is reachable only on the internal Docker network during
# break-glass incidents — see rb-08-bullboard-emergency-activation.md.
# pgweb is blocked by validate-env.sh.
BULLBOARD_REDIS_HOST=memorycache
BULLBOARD_REDIS_PORT=6379
BULLBOARD_REDIS_DB=0
BULLBOARD_REDIS_USE_TLS=false
BULLBOARD_REDIS_USERNAME=app
# Leave unset to reuse MEMORYCACHE_PASSWORD. If REDIS_BULLMQ_URL points at the
# dedicated memorycache-jobs service, set BULLBOARD_REDIS_HOST=memorycache-jobs.
BULLBOARD_REDIS_PASSWORD=

# Search (search profile)
SEARCHCORE_HOST=meilisearch.athyper.com

# Analytics (analytics profile — DEFERRED, do NOT enable without
# read replica + governance sign-off; see analytics/README.md)
ANALYTICSBOARD_HOST=metabase.athyper.com

# Secrets (security-infisical profile)
SECRETSTORE_HOST=infisical.athyper.com

# Applications
APPS_ATHYPER_WEB_HOST=neon.athyper.com
APPS_ATHYPER_NEON_HOST=neon.athyper.com
APPS_ATHYPER_MESH_HOST=mesh.athyper.com
APPS_ATHYPER_ADMIN_HOST=admin.athyper.com
APPS_ATHYPER_API_HOST=api.athyper.com
# Traefik upstream for the Neon web app — in-network Docker service name.
# Production upstreams stay inside the Docker edge network.
# Do not point these to host.docker.internal; that is local development only.
APPS_ATHYPER_WEB_UPSTREAM_URL=http://neon-web:3000
APPS_ATHYPER_NEON_UPSTREAM_URL=http://neon-web:3000
APPS_ATHYPER_MESH_UPSTREAM_URL=http://mesh-web:3000
APPS_ATHYPER_ADMIN_UPSTREAM_URL=http://admin-web:3000
# Traefik upstream for the API — must be a valid URL even though the Docker-label
# router (priority ~30) always wins over the static file-provider router (priority 1).
# An empty value causes Traefik to emit a backend-parse warning at startup.
APPS_ATHYPER_API_UPSTREAM_URL=http://api:3000

# Single-ingress host guard (apps/neon/proxy.ts): the neon-web
# container rejects requests whose Host header is not in ALLOWED_HOSTS.
# GATEWAY_ORIGIN is the redirect target for direct-access Host headers.
ALLOWED_HOSTS=neon.athyper.com
GATEWAY_ORIGIN=https://neon.athyper.com
NEON_ALLOWED_HOSTS=neon.athyper.com
NEON_GATEWAY_ORIGIN=https://neon.athyper.com
MESH_ALLOWED_HOSTS=mesh.athyper.com
MESH_GATEWAY_ORIGIN=https://mesh.athyper.com
ADMIN_ALLOWED_HOSTS=admin.athyper.com
ADMIN_GATEWAY_ORIGIN=https://admin.athyper.com

# ── Neon Web — container-specific env (apps profile) ───────────────────────
# The web BFF uses a dedicated KC client distinct from the API's client_id.
# Keep it aligned with the redirect-URI entry registered in Keycloak for
# the neon.athyper.com host.
KEYCLOAK_CLIENT_ID=neon-web
NEON_KEYCLOAK_REALM=athyper
NEON_KEYCLOAK_CLIENT_ID=neon-web
MESH_KEYCLOAK_REALM=athyper
MESH_KEYCLOAK_CLIENT_ID=mesh-web
ADMIN_KEYCLOAK_REALM=athyper
ADMIN_KEYCLOAK_CLIENT_ID=admin-web
APP_MFA_ENFORCED=true
AUTH_DISCOVERY_SHARED_SECRET=${AUTH_DISCOVERY_SHARED_SECRET}
AUTH_DISCOVERY_EXPOSE_DEV_LINK=false
AUTH_DISCOVERY_DELIVERY_URL=${AUTH_DISCOVERY_DELIVERY_URL}
AUTH_DISCOVERY_DELIVERY_SECRET=${AUTH_DISCOVERY_DELIVERY_SECRET}
AUTH_DISCOVERY_STAGE1_VERIFICATION_MODE=disabled
AUTH_DISCOVERY_TOKEN_TTL_SECONDS=900
AUTH_DISCOVERY_RESEND_COOLDOWN_SECONDS=30
AUTH_DISCOVERY_VERIFIED_TRUST_TTL_DAYS=30
NEXT_PUBLIC_AUTH_DISCOVERY_RESEND_COOLDOWN_SECONDS=30
AUTH_DISCOVERY_USERNAME_EMAIL_DOMAINS=
# KC admin API credentials — used for server-side org-attribute enrichment.
# PROVISION THESE FROM A SECRET MANAGER (see docs/secrets-management.md);
# the placeholders below must never ship as real values.
KEYCLOAK_ADMIN_USERNAME=${KEYCLOAK_ADMIN_USERNAME}
KEYCLOAK_ADMIN_PASSWORD=${KEYCLOAK_ADMIN_PASSWORD}
# Feature flags baked into the browser bundle at build time.
NEXT_PUBLIC_GITHUB_LOGIN_ENABLED=false
NEXT_PUBLIC_PLATFORM_CONTROL_ENABLED=false
# Social login → tenant mapping (used when KC org claim is absent).
GITHUB_TENANT_ID=

# =============================================
# GATEWAY (Traefik)
# =============================================
GATEWAY_TLS_OPTIONS=athyper-tls-default@file
# ACME cert resolver for Let's Encrypt production certificates.
GATEWAY_CERT_RESOLVER=letsencrypt
DASHBOARD_AUTH_MW=athyper-dashboard-auth@file
# Let's Encrypt registration email (required — ACME registration fails without it).
ACME_EMAIL=${ACME_EMAIL}
GATEWAY_ACCESSLOG=false
GATEWAY_LOG_LEVEL=WARN
# Dashboard basic-auth htpasswd (user:bcrypt_hash).
# MUST be unique per environment — NEVER reuse the local dev hash.
# Generate: htpasswd -nbB admin <password> | sed 's/\$/\$\$/g'
# Escape $ as $$ for Docker Compose YAML interpolation.
GATEWAY_DASHBOARD_HTPASSWD=${GATEWAY_DASHBOARD_HTPASSWD}

# =============================================
# SERVICE MEMORY LIMITS
# =============================================
GATEWAY_MEMORY_LIMIT=512m
IAM_MEMORY_LIMIT=2g
OBJECTSTORAGE_MEMORY_LIMIT=1g
MEMORYCACHE_MEMORY_LIMIT=512m
MEMORYCACHE_EXPORTER_MEMORY_LIMIT=128m
TELEMETRY_MEMORY_LIMIT=1g
METRICS_MEMORY_LIMIT=1g
ALERTMANAGER_MEMORY_LIMIT=256m
TRACING_MEMORY_LIMIT=1g
LOGGING_MEMORY_LIMIT=1g
LOGSHIPPER_MEMORY_LIMIT=256m
APPS_ATHYPER_MEMORY_LIMIT=1g
DB_MEMORY_LIMIT=2g
DBPOOL_APPS_MEMORY_LIMIT=256m
DBPOOL_SESSION_MEMORY_LIMIT=256m
VIRUSSCAN_MEMORY_LIMIT=1g
# --- Render profile (docrender + docparser) ---
DOCRENDER_MEMORY_LIMIT=2g
DOCRENDER_CPU_LIMIT=1.5
DOCPARSER_MEMORY_LIMIT=2g
# --- Monitoring profile ---
STATUSWATCH_MEMORY_LIMIT=512m
CRONWATCH_MEMORY_LIMIT=512m
ERRORCOLLECT_MEMORY_LIMIT=1g
# --- Admin profile (opt-in only) ---
QUEUECONSOLE_MEMORY_LIMIT=128m
# --- Search profile (searchcore) ---
SEARCHCORE_MEMORY_LIMIT=1g
# --- Analytics profile / analyticsboard (DEFERRED — see analytics/README.md) ---
ANALYTICSBOARD_MEMORY_LIMIT=2g
# --- Secrets profile (secretstore) ---
SECRETSTORE_MEMORY_LIMIT=1g

# =============================================
# DATABASE (PostgreSQL via PgBouncer)
# =============================================
# PgBouncer config paths (relative to ATHYPER_CONFIG)
DBPOOL_APPS_CONFIG=db/production/dbpool/apps/pgbouncer-apps.ini
DBPOOL_SESSION_CONFIG=db/production/dbpool/session/pgbouncer-session.ini
# Upstream Postgres endpoint — substituted into pgbouncer-{apps,auth}.ini
# at container start. Change DB_HOST for blue/green cutover, DNS failover,
# or read-replica promotion without rebuilding the pgbouncer config files.
DB_HOST=db.athyper.com
DB_PORT=5432
DB_ADMIN_USER=postgres
# DB_ADMIN_PASSWORD is used by the db container (POSTGRES_PASSWORD).
# If you run a self-hosted PostgreSQL container, this MUST be set.
# If using a managed database (RDS, Cloud SQL), leave unset and omit the db profile.
DB_ADMIN_PASSWORD=${DB_ADMIN_PASSWORD}
DATABASE_URL=${DATABASE_URL}
DATABASE_ADMIN_URL=${DATABASE_ADMIN_URL}
DB_POOL_MAX=50
# PgBouncer auth — userlist generated at container start from these env vars
DBPOOL_APPS_USER=athyper_user
DBPOOL_APPS_PASSWORD=${DBPOOL_APPS_PASSWORD}
DBPOOL_SESSION_USER=pgbouncer_auth_user
DBPOOL_SESSION_PASSWORD=${DBPOOL_SESSION_PASSWORD}

# =============================================
# CACHE (Redis)
# =============================================
REDIS_URL=${REDIS_URL}
MEMORYCACHE_PASSWORD=${MEMORYCACHE_PASSWORD}
# Per-service Redis passwords (ACL hashes computed at container start)
# Generate strong passwords: openssl rand -base64 24
REDIS_EXPORTER_PASSWORD=${REDIS_EXPORTER_PASSWORD}
REDIS_GLITCHTIP_PASSWORD=${REDIS_GLITCHTIP_PASSWORD}
REDIS_INFISICAL_PASSWORD=${REDIS_INFISICAL_PASSWORD}
# Breakglass only — no service connects as this user
REDIS_ADMIN_PASSWORD=${REDIS_ADMIN_PASSWORD}
# Redis client tuning
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_MAX_RETRIES=5
REDIS_ERROR_LOG_COOLDOWN_MS=60000
# Optional: dedicated Redis for BullMQ (queues/workers/schedulers).
# When unset, BullMQ reuses REDIS_URL. Point at a separate instance (or
# db index, e.g. redis://host:6379/1) so a READONLY error or reconnect
# storm on the cache client cannot cascade to job coordination. Operated
# alongside the opt-in `memorycache-jobs` compose profile — see
# rb-09-redis-failover.md for the client ownership matrix.
REDIS_BULLMQ_URL=${REDIS_BULLMQ_URL}

# =============================================
# OBJECT STORAGE (MinIO S3)
# S3_ACCESS_KEY/S3_SECRET_KEY = MinIO root credentials (MINIO_ROOT_USER).
# Application code uses the scoped APP_S3_* / BACKUP_S3_* credentials below,
# provisioned by objectstorage-init on first stack start.
# Generate: openssl rand -hex 12   (access key, min 3 chars)
#           openssl rand -base64 32 (secret key, min 8 chars)
# =============================================
S3_ENDPOINT=${S3_ENDPOINT}
S3_ACCESS_KEY=${S3_ACCESS_KEY}
S3_SECRET_KEY=${S3_SECRET_KEY}
S3_REGION=${S3_REGION}
S3_BUCKET=${S3_BUCKET}
S3_USE_SSL=true
# CORS allowed origins for object storage presigned-URL uploads
CORS_ALLOWED_ORIGINS=https://neon.athyper.com,https://mesh.athyper.com,https://admin.athyper.com
# Multipart upload tuning
S3_MULTIPART_PART_SIZE_MB=8
S3_MULTIPART_QUEUE_SIZE=4
S3_MAX_UPLOAD_MB=250
S3_PRESIGNED_TTL_SECONDS=900

# Scoped service account — athyper-app (readwrite on S3_BUCKET).
# objectstorage-init creates this MinIO user with athyper-app-policy.
APP_S3_ACCESS_KEY=${APP_S3_ACCESS_KEY}
APP_S3_SECRET_KEY=${APP_S3_SECRET_KEY}

# Scoped service account — athyper-backup (readwrite on BACKUP_S3_BUCKET).
# objectstorage-init creates this MinIO user with athyper-backup-policy.
BACKUP_S3_BUCKET=${BACKUP_S3_BUCKET}
BACKUP_S3_ACCESS_KEY=${BACKUP_S3_ACCESS_KEY}
BACKUP_S3_SECRET_KEY=${BACKUP_S3_SECRET_KEY}

# =============================================
# IAM (Keycloak)
# KEYCLOAK_IMAGE_TAG: single source for scripts + compose — bump here when upgrading
# =============================================
KEYCLOAK_IMAGE_TAG=26.6.1
IAM_ADMIN=${IAM_ADMIN}
IAM_ADMIN_PASSWORD=${IAM_ADMIN_PASSWORD}
IAM_DB_URL=jdbc:postgresql://dbpool-session:6433/athyper_iam?preferQueryMode=simple
IAM_DB_USERNAME=${IAM_DB_USERNAME}
IAM_DB_PASSWORD=${IAM_DB_PASSWORD}
IAM_ISSUER_URL=${IAM_ISSUER_URL}
IAM_CLIENT_ID=${IAM_CLIENT_ID}
IAM_CLIENT_SECRET=${IAM_CLIENT_SECRET}
IAM_DEFAULT_REALM=athyper

# Platform Control Realm (disabled by default, enable for platform admin features)
PLATFORM_CONTROL_ENABLED=false
PLATFORM_KEYCLOAK_REALM=platform-control
PLATFORM_KEYCLOAK_CLIENT_ID=athyper-admin
PLATFORM_IAM_ISSUER_URL=${PLATFORM_IAM_ISSUER_URL}

# IAM SMTP
KC_SMTP_HOST=${KC_SMTP_HOST}
KC_SMTP_PORT=${KC_SMTP_PORT}
KC_SMTP_FROM=${KC_SMTP_FROM}
KC_SMTP_FROM_DISPLAY_NAME=Athyper
KC_SMTP_AUTH=true
KC_SMTP_USERNAME=${KC_SMTP_USERNAME}
KC_SMTP_PASSWORD=${KC_SMTP_PASSWORD}
KC_SMTP_SSL=false

# App SMTP — notification email channel (injected from secret manager)
# Webhook URL: https://api.athyper.com/api/notifications/webhooks/email-bounce
# SMTP_BOUNCE_WEBHOOK_SECRET: required in production. Generate with:
#   openssl rand -base64 32
SMTP_HOST=${SMTP_HOST}
SMTP_PORT=${SMTP_PORT}
SMTP_SECURE=${SMTP_SECURE}
SMTP_USER=${SMTP_USER}
SMTP_PASS=${SMTP_PASS}
SMTP_FROM=${SMTP_FROM}
# Per-plane FROM overrides — set in secret manager, fall back to SMTP_FROM if unset.
# Recommended values: noreply.neon@athyper.com / noreply.mesh@athyper.com / noreply.admin@athyper.com
SMTP_FROM_NEON=${SMTP_FROM_NEON}
SMTP_FROM_MESH=${SMTP_FROM_MESH}
SMTP_FROM_ADMIN=${SMTP_FROM_ADMIN}
SMTP_BOUNCE_WEBHOOK_SECRET=${SMTP_BOUNCE_WEBHOOK_SECRET}

# Web Push (VAPID) - browser push channel
# Generate once per environment:
#   npx web-push generate-vapid-keys
# VAPID_PRIVATE_KEY must come from the secret manager.
VAPID_SUBJECT=${VAPID_SUBJECT}
VAPID_PUBLIC_KEY=${VAPID_PUBLIC_KEY}
VAPID_PRIVATE_KEY=${VAPID_PRIVATE_KEY}
KC_SMTP_STARTTLS=true
KC_WEBAUTHN_RP_ID=${KC_WEBAUTHN_RP_ID}
ADMIN_WEB_CLIENT_SECRET=${ADMIN_WEB_CLIENT_SECRET}
ATHYPER_SVC_RUNTIME_WORKER_CLIENT_SECRET=${ATHYPER_SVC_RUNTIME_WORKER_CLIENT_SECRET}
NEON_SVC_BFF_CLIENT_SECRET=${NEON_SVC_BFF_CLIENT_SECRET}

# Social OAuth — set to enable provider login buttons
# GitHub: Register at https://github.com/settings/developers
# Callback URL: https://iam.athyper.com/realms/athyper/broker/github/endpoint
GITHUB_OAUTH_CLIENT_ID=${GITHUB_OAUTH_CLIENT_ID}
GITHUB_OAUTH_CLIENT_SECRET=${GITHUB_OAUTH_CLIENT_SECRET}
# Google: Obtain from GCP Console → APIs & Services → OAuth 2.0 Credentials
# Redirect URI: https://iam.athyper.com/realms/athyper/broker/google/endpoint
GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET}
MICROSOFT_CLIENT_ID=${MICROSOFT_CLIENT_ID}
MICROSOFT_CLIENT_SECRET=${MICROSOFT_CLIENT_SECRET}

# =============================================
# IAM SECRETS (SUPERSTAR env vars)
# =============================================
# These are resolved by kernel config loader
ATHYPER_SUPER__IAM_SECRET__IAM_ATHYPER_CLIENT_SECRET=${IAM_CLIENT_SECRET}

# =============================================
# VIRUS SCANNING (ClamAV)
# =============================================
# Enforce fail-closed: unreachable ClamAV blocks uploads (503) rather than
# silently bypassing the scan.
CLAMD_HOST=virusscan
CLAMD_PORT=3310
CLAMD_ON_UNAVAILABLE=fail-closed
# Enable freshclam auto-update daemon in staging/production
FRESHCLAM_NO_DAEMON=false

# =============================================
# CREDENTIAL ENCRYPTION
# =============================================
# Required in production — server will refuse to start without it.
# Must be ≥32 characters. Generate with: openssl rand -base64 48
CREDENTIAL_MASTER_KEY=${CREDENTIAL_MASTER_KEY}

# =============================================
# LEGACY PDF RENDERER (superseded by docrender)
# =============================================
# athyper-renderer container retired; PdfRendererClient kept only as a
# fallback. Production uses Gotenberg exclusively — leave RENDERER_BASE_URL
# blank.
RENDERER_INTERNAL_TOKEN=${RENDERER_INTERNAL_TOKEN}
RENDERER_BASE_URL=

# =============================================
# TELEMETRY (OpenTelemetry)
# =============================================
# Canonical names (no vendor aliases): inject TELEMETRY_ADMIN_* directly
# from the secret manager. Do NOT alias to GRAFANA_ADMIN_* — the rename
# layer silently resolves to empty and locks ops out of Grafana mid-incident.
OTLP_ENDPOINT=${OTLP_ENDPOINT}
TELEMETRY_ADMIN_USER=${TELEMETRY_ADMIN_USER}
TELEMETRY_ADMIN_PASSWORD=${TELEMETRY_ADMIN_PASSWORD}

# --- Alertmanager contact routing ---
# Required in production. Inject SMTP relay + recipient groups from the
# secret manager; validate-env blocks unresolved placeholders and blanks.
ALERTMANAGER_SMTP_SMARTHOST=${ALERTMANAGER_SMTP_SMARTHOST}
ALERTMANAGER_SMTP_FROM=${ALERTMANAGER_SMTP_FROM}
ALERTMANAGER_SMTP_REQUIRE_TLS=true
ALERTMANAGER_SMTP_AUTH_USERNAME=
ALERTMANAGER_SMTP_AUTH_PASSWORD=
ALERTMANAGER_PLATFORM_EMAIL=${ALERTMANAGER_PLATFORM_EMAIL}
ALERTMANAGER_CRITICAL_EMAIL=${ALERTMANAGER_CRITICAL_EMAIL}
ALERTMANAGER_FINANCE_EMAIL=${ALERTMANAGER_FINANCE_EMAIL}
ALERTMANAGER_COMPLIANCE_EMAIL=${ALERTMANAGER_COMPLIANCE_EMAIL}
ALERTMANAGER_SECURITY_EMAIL=${ALERTMANAGER_SECURITY_EMAIL}

# --- Tempo storage backend ---
# Production uses the stack MinIO for durable, lifecycle-managed trace
# storage. Bucket is provisioned at start by the tracing-bucket-init
# sidecar (idempotent). Retention is driven by Tempo's compactor
# (336h = 14d) — configure a MinIO ILM rule on the bucket as
# defense-in-depth against orphaned objects if compliance requires a
# hard deletion SLO.
# TEMPO_S3_ACCESS_KEY/TEMPO_S3_SECRET_KEY: use a dedicated MinIO user
# with put/get/delete/list on the bucket only; do NOT reuse root creds
# (${S3_ACCESS_KEY}/${S3_SECRET_KEY}) for Tempo's blast radius.
TEMPO_STORAGE_BACKEND=s3
TEMPO_S3_BUCKET=athyper-tempo-traces
TEMPO_S3_ENDPOINT=objectstorage:9000
TEMPO_S3_ACCESS_KEY=${TEMPO_S3_ACCESS_KEY}
TEMPO_S3_SECRET_KEY=${TEMPO_S3_SECRET_KEY}
TEMPO_S3_INSECURE=true

# --- Loki storage backend ---
# Mirrors Tempo pattern: s3 in production for durable, lifecycle-managed log storage.
# Bucket is provisioned at start by the logging-bucket-init sidecar (idempotent).
# LOKI_S3_ACCESS_KEY/LOKI_S3_SECRET_KEY: use a dedicated MinIO user
# with put/get/delete/list on the bucket only; do NOT reuse root creds.
LOKI_STORAGE_BACKEND=s3
LOKI_S3_BUCKET=athyper-loki-logs
LOKI_S3_ENDPOINT=objectstorage:9000
LOKI_S3_ACCESS_KEY=${LOKI_S3_ACCESS_KEY}
LOKI_S3_SECRET_KEY=${LOKI_S3_SECRET_KEY}
LOKI_S3_INSECURE=true

# --- Distributed tracing — OpenTelemetry → Tempo ---
# Head-based sampling: 0.1 = 10% in production. Tune once ingest volume is
# measured; avoid raising above 0.2 without reviewing Tempo storage capacity.
OTEL_EXPORTER_OTLP_ENDPOINT=http://tracing:4317
OTEL_SERVICE_NAME=athyper-runtime
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# =============================================
# RENDER PROFILE (docrender + docparser)
# =============================================
# Internal only. Replica count drives LibreOffice throughput (serial per instance).
#
# Canonical tuning + error-category contract:
#   stack/config/render/environments/docrender.production.conf
#   stack/config/render/environments/docparser-config.production.xml
#   stack/config/render/README.md
#
# DO NOT widen DOCRENDER_CHROMIUM_ALLOW_LIST without documented ops
# sign-off — it governs what URLs Chromium will load at render time.
# Keep values below in sync with the .conf file (source of truth).
DOCRENDER_REPLICAS=2
DOCRENDER_API_TIMEOUT=180s
DOCRENDER_LIBREOFFICE_RESTART_AFTER=100
DOCRENDER_CHROMIUM_ALLOW_LIST=file:///tmp.*
# App-side consumer URLs (internal Docker DNS).
DOCRENDER_BASE_URL=http://docrender:3000
DOCPARSER_URL=http://docparser:9998

# =============================================
# MONITORING PROFILE (statuswatch + cronwatch + errorcollect)
# =============================================
# Rotate per-environment. errorcollect ingest is NOT gateway-auth-gated — SDK
# clients send events with the DSN.
CRONWATCH_SECRET_KEY=${CRONWATCH_SECRET_KEY}
ERRORCOLLECT_SECRET_KEY=${ERRORCOLLECT_SECRET_KEY}
# App-side consumer URLs.
CRONWATCH_BASE_URL=http://cronwatch:8000/ping
CRONWATCH_EMAIL_USE_TLS=True
# DSN injected from Vault / AWS Secrets Manager. SDK is no-op until set.
GLITCHTIP_DSN=${GLITCHTIP_DSN}
SENTRY_TRACES_SAMPLE_RATE=0.01
# Web frontend (@sentry/nextjs). DSN baked into browser bundle at build time.
NEXT_PUBLIC_SENTRY_DSN=${NEXT_PUBLIC_SENTRY_DSN}
NEXT_PUBLIC_ENVIRONMENT=production
NEXT_PUBLIC_SERVICE_VERSION=${SERVICE_VERSION}
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.01
# Source-map upload happens during `next build` in the release image-build
# job. Token scope: project:releases + project:write; rotate per playbook.
SENTRY_ORG=${SENTRY_ORG}
SENTRY_PROJECT=${SENTRY_PROJECT}
SENTRY_URL=${SENTRY_URL}
SENTRY_AUTH_TOKEN=${SENTRY_AUTH_TOKEN}

# =============================================
# SEARCH PROFILE (searchcore)
# =============================================
# Infra only — indexing worker and search API are wired separately.
# Generate master key: openssl rand -base64 32
SEARCHCORE_URL=http://searchcore:7700
# Both vars carry the same secret value. MEILI_MASTER_KEY is read by the
# searchcore container binary; SEARCHCORE_MASTER_KEY is read by the API server.
MEILI_MASTER_KEY=${MEILI_MASTER_KEY}
SEARCHCORE_MASTER_KEY=${SEARCHCORE_MASTER_KEY}
MEILI_ENV=production
MEILI_LOG_LEVEL=WARN
MEILI_MAX_INDEXING_MEMORY=512MiB

# =============================================
# ANALYTICS PROFILE (analyticsboard) — DEFERRED
# =============================================
# Pre-staged. Read stack/compose/analytics/README.md before
# enabling. The stack will REFUSE to start with the analytics profile
# unless ANALYTICSBOARD_GOVERNANCE_APPROVED=approved is set explicitly here
# (validate-env.sh enforces). That flag is the contract that the four
# governance bullets in the README have been answered.
#
# In production, MB_DB_TYPE MUST be postgres (H2 is unsupported here)
# and MB_DB_CONNECTION_URI MUST point at a dedicated app DB. The data
# source must be a streaming-replicated read replica — never the
# primary. The stack will not enforce that target shape, but the four
# governance bullets do.
MB_DB_TYPE=postgres
MB_DB_CONNECTION_URI=${MB_DB_CONNECTION_URI}
MB_JAVA_OPTS=-Xmx1536m -XX:+UseG1GC
ANALYTICSBOARD_GOVERNANCE_APPROVED=false

# =============================================
# SECRETS PROFILE (secretstore)
# =============================================
# Infra-only. Admin provisions secrets via UI after first-boot.
# ENCRYPTION_KEY: 32 hex chars. Generate: openssl rand -hex 16
INFISICAL_ENCRYPTION_KEY=${INFISICAL_ENCRYPTION_KEY}
# AUTH_SECRET: any string ≥32 chars. Generate: openssl rand -base64 32
INFISICAL_AUTH_SECRET=${INFISICAL_AUTH_SECRET}
