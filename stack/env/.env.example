# =============================================
# athyper Stack — Local Development Environment
# =============================================
# This is the PRIMARY env file for local development.
#
# Usage:
#   cp .env.example .env          (if using default Docker Compose env)
#   docker compose --env-file ../env/.env.example --profile core up -d
#
# Environment-specific files:
#   .env.example              ← Local dev (this file, also aliased as local.env.example)
#   staging.env.example       ← Staging (Ubuntu, managed secrets)
#   production.env.example    ← Production (Ubuntu, SUPERSTAR secrets)
#
# NOTE: The Neon web app (.env.local) uses DIFFERENT variable names for some
# settings because it runs OUTSIDE Docker. See apps/neon/.env.example when present
# for the web app's env config.
#
# VARIABLE MAPPING (stack Docker → neon web localhost):
#   IAM_ISSUER_URL          → KEYCLOAK_BASE_URL (base only, no /realms/...)
#   IAM_DEFAULT_REALM       → KEYCLOAK_REALM
#   IAM_CLIENT_ID           → (not used by web; web uses KEYCLOAK_CLIENT_ID=neon-web)
#   REDIS_URL (memorycache) → REDIS_URL (localhost, with password)
#   DATABASE_URL (dbpool)   → DATABASE_URL (localhost:6432)
#   PUBLIC_BASE_URL (API)   → RUNTIME_API_URL (container: http://api:3000; local host: http://localhost:4000 — NOT via Traefik)

# =============================================
# LOCAL CREDENTIALS — NOT for staging/production
# =============================================
# Infrastructure administrator credentials use the local development default.
# Application database traffic uses the separate NOBYPASSRLS athyper_runtime login.
# NEVER copy these literal values to staging.env or production.env.
# =============================================

# =============================================
# ENVIRONMENT IDENTITY
# =============================================
# Valid values: local | staging | production
ENVIRONMENT=local
# Pinned — must match across all envs so container/volume/network names are
# stable. Changing this renames every container and orphans all named volumes.
COMPOSE_PROJECT_NAME=athyper
# Default compose profile when stack-profile/up.bat is invoked without an arg.
# Local dev uses "core" (infra only) — the 6 app processes run on the host via
# Host-process development may override this to "all" or apps-
# specific profiles. See stack/docs/local-dev-setup.md for the full recipe.
STACK_PROFILE=dev

# =============================================
# RUNTIME CONFIGURATION
# =============================================
MODE=api
MULTITENANT=TRUE
SERVICE_NAME=athyper-runtime
# Hardcoded in local dev. Use ${RELEASE_VERSION} in staging/production.
SERVICE_VERSION=1.0.0
WEB_PORT=3000
API_PORT=3000
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT_MS=15000
NODE_ENV=development
# Shared by the Neon BFF and runtime API for document workspace capabilities.
# Local-only predictable value; never reuse outside local development.
DOCUMENT_EDIT_WORKSPACE_TOKEN_SECRET=local-development-document-edit-workspace-key-2026
# DOCUMENT_EDIT_WORKSPACE_TOKEN_KEYS={"2026_07":"replace-with-at-least-32-random-characters"}
# DOCUMENT_EDIT_WORKSPACE_TOKEN_ACTIVE_KID=2026_07
DOCUMENT_EDIT_SAVE_AND_TRANSITION_DISABLED=
# Accept self-signed certs in local dev (gateway uses .athyper.local TLS)
NODE_TLS_REJECT_UNAUTHORIZED=0

# =============================================
# PUBLIC URLs
# =============================================
PUBLIC_BASE_URL=https://api.athyper.local
PUBLIC_WEB_URL=https://neon.athyper.local
PUBLIC_NEON_URL=https://neon.athyper.local
PUBLIC_MESH_URL=https://mesh.athyper.local
PUBLIC_STUDIO_URL=https://studio.athyper.local

# =============================================
# BASE PATHS — Local Windows Dev (two-root layout)
# =============================================
# Git checkout (source, compose defs, templates):
#   D:\Products\athyper\         ← never holds runtime state
#
# Runtime state (config, secrets, data, logs, backups):
#   D:\Stack\athyper\            ← adjust prefix if your layout differs
#
# Use forward slashes — Docker Compose and Docker Desktop require them.
# Adjust the D:/Stack/athyper/ prefix to match your local layout.
# Run  setup-config.bat local  to populate D:\Stack\athyper\config from
# the repo templates, and  data-dirs-create.bat  to create data dirs.
#
# Docker Desktop auto-restart: Docker Desktop re-reads this file when
# restarting a container (bypassing up.bat / up.sh). The absolute paths
# below ensure auto-restart resolves bind mounts correctly.

# Six runtime roots (scripts + setup tools read these)
ATHYPER_CONFIG_ROOT=D:/Stack/athyper/config
ATHYPER_SECRETS_ROOT=D:/Stack/athyper/secrets
ATHYPER_DATA_ROOT=D:/Stack/athyper/data
ATHYPER_LOG_ROOT=D:/Stack/athyper/logs
ATHYPER_BACKUP_ROOT=D:/Stack/athyper/backups

# Backwards-compat aliases — Docker Compose bind mounts use these names.
# Scripts (up.bat / up.sh) derive them from the _ROOT vars above, but
# they must also be present here for Docker Desktop auto-restart.
ATHYPER_CONFIG=D:/Stack/athyper/config
ATHYPER_DATA=D:/Stack/athyper/data

ATHYPER_KERNEL_CONFIG_PATH=apps/kernel.config.local.parameter.json
AUTH_DEBUG_EXPOSE_TOKENS=true
AUTH_DISCOVERY_SHARED_SECRET=athyperadmin
AUTH_DISCOVERY_EXPOSE_DEV_LINK=true
AUTH_DISCOVERY_DELIVERY_URL=
AUTH_DISCOVERY_DELIVERY_SECRET=
AUTH_DISCOVERY_STAGE1_VERIFICATION_MODE=disabled
AUTH_DISCOVERY_TOKEN_TTL_SECONDS=900
AUTH_DISCOVERY_RESEND_COOLDOWN_SECONDS=30
AUTH_DISCOVERY_VERIFIED_TRUST_TTL_DAYS=30
NEXT_PUBLIC_AUTH_DISCOVERY_RESEND_COOLDOWN_SECONDS=30
IAM_PRESENTATION_CONTEXT_TTL_SECONDS=60
IAM_PRESENTATION_REDIS_CONNECT_TIMEOUT_MS=1000
IAM_PRESENTATION_REDIS_READ_TIMEOUT_MS=1000
# Optional comma-separated domains that allow local-part username discovery
# aliases, e.g. athq.admin@athyper.demo -> username athq.admin.
AUTH_DISCOVERY_USERNAME_EMAIL_DOMAINS=athyper.demo

# =============================================
# AUTH PIPELINE HARDENING (Phase E2 + Phase I)
# =============================================
# All variables below are consumed by the server runtime
# (server/src/auth/auth-pipeline.ts, server/src/kernel/auth-flag-validator.ts,
# server/src/runtimes/api.ts). They are read at request time and bootstrap.
#
#
# ======== Attachment auth hardening phase (temporary rollout flags) ========
# Leave off by default. Turn on in lower environments to baseline behavior before
# enforcing stricter attachment auth/multipart cleanup behavior.
ATTACHMENT_AUTH_STRICT=false
ATTACHMENT_MULTIPART_CLEANUP_STRICT=false

# Required: generate at least 32 random UTF-8 bytes for Query V1 cursors.
ENTITY_QUERY_CURSOR_SECRET=local-development-query-cursor-secret-2026
ENTITY_QUERY_V1_PILOTS=company_code
NEON_ENTITY_QUERY_V1_PILOTS=company_code
NEON_ENTITY_QUERY_V1_MODE=shadow
MUTATION_KERNEL_STAGE=shadow_validation
MUTATION_KERNEL_INTERNAL_TENANTS=
MUTATION_KERNEL_EXTERNAL_COHORT=

# Atlas base holder (also requires tenant flag + ai.agent.use grant).
ATLAS_AGENT_ENABLED=true
# Admin exposes non-tenant product help only when this independent gate is true.
ATLAS_AGENT_ADMIN_ENABLED=true
ANTHROPIC_API_KEY=
# Server-only HMAC key for non-reversible credential fingerprints (32+ chars).
ATLAS_AGENT_CREDENTIAL_FINGERPRINT_KEY=
ATLAS_BYOK_ENABLED=false
ATLAS_BYOK_BACKEND=disabled
ATLAS_BYOK_FINGERPRINT_KEY=
ATLAS_BYOK_CACHE_TTL_MS=30000
ATLAS_AGENT_DEFAULT_PUBLIC_MODEL=atlas-fast
ATLAS_AGENT_ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
ATLAS_AGENT_ANTHROPIC_BALANCED_MODEL=claude-sonnet-4-6
ATLAS_AGENT_ANTHROPIC_BEST_MODEL=claude-opus-4-8
# Server-only, permission-gated OpenAI evaluation provider. Never make this
# internal binding the default public Atlas model. It accepts public-classified
# content only; the evaluator permission does not classify pasted content.
OPENAI_PROVIDER_ENABLED=false
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_TIMEOUT_MS=60000
ATLAS_AGENT_OPENAI_EVAL_MODEL=gpt-5.6-sol
GEMINI_PROVIDER_ENABLED=false
GEMINI_API_KEY=
GEMINI_PROJECT_ID=
GEMINI_EVAL_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=60000
GEMINI_ACCOUNT_CLASS=
GEMINI_PROVIDER_REGION=global
ATLAS_AGENT_PROVIDER_TIMEOUT_MS=60000
ATLAS_AGENT_STREAM_IDLE_TIMEOUT_MS=30000
ATLAS_AGENT_MAX_OUTPUT_TOKENS=2048
ATLAS_AGENT_MAX_OUTPUT_BYTES=131072
ATLAS_AGENT_USER_RUNS_PER_MINUTE=10
ATLAS_AGENT_TENANT_RUNS_PER_MINUTE=100
ATLAS_AGENT_TOOLS_ENABLED=false
ATLAS_AGENT_TOOL_MAX_ROUNDS=3
ATLAS_AGENT_TOOL_MAX_CALLS=4
ATLAS_AGENT_TOOL_MAX_ELAPSED_MS=120000
ATLAS_AGENT_TOOL_MAX_TOTAL_TOKENS=32768
ATLAS_AGENT_TOOL_TIMEOUT_MS=10000
ATLAS_AGENT_TOOL_MAX_INPUT_BYTES=32768
ATLAS_AGENT_TOOL_MAX_RESULT_BYTES=32768
ATLAS_CONVERSATION_PERSISTENCE_ENABLED=false
# Sensitive retained content requires an approved protected-content store.
ATLAS_CONVERSATION_CONTENT_PROTECTION_MODE=database_at_rest_non_sensitive_only
# Compose injects this privileged URL into worker/scheduler only.
ATLAS_CONVERSATION_MAINTENANCE_DATABASE_URL=
ATLAS_CONVERSATION_RETENTION_DAYS=30
ATLAS_CONVERSATION_MIN_RETENTION_DAYS=1
ATLAS_CONVERSATION_MAX_RETENTION_DAYS=365
ATLAS_CONVERSATION_CONTEXT_MAX_MESSAGES=20
ATLAS_CONVERSATION_CONTEXT_MAX_CHARACTERS=98304
ATLAS_CONVERSATION_STALE_RUN_TIMEOUT_MS=900000
ATLAS_CONVERSATION_PURGE_BATCH_SIZE=500

# Per-env defaults are LOCKED in code — these env vars only need to be set
# when an operator deliberately downgrades enforcement (compat / burn-in
# windows), and most require a paired _SUNSET=YYYY-MM-DD or the override
# is REFUSED with a structured event.

# ── Required-actions enforcement ────────────────────────────────────────────
# Defaults: local→off, staging→on, production→on. Set to 'off' only with a
# sunset, and only while migrating. 'on' forces it on regardless of env.
# AUTH_REQUIRED_ACTIONS_ENFORCE=
# AUTH_REQUIRED_ACTIONS_ENFORCE_SUNSET=          # YYYY-MM-DD (max 30 days)

# JSON override for the matrix of {actionCode: [pathPrefix,...]}. Falls back
# to DEFAULT_REQUIRED_ACTION_MATRIX in server/src/auth/auth-pipeline.ts when
# absent or malformed.
# AUTH_REQUIRED_ACTIONS_MATRIX=

# Emergency override — when the JSON above is malformed, staging/production
# normally BLOCK boot. Setting this to 'true' (with a sunset, max 72h)
# downgrades that to a warn so the deploy can proceed on the built-in matrix.
# AUTH_REQUIRED_ACTIONS_MATRIX_ALLOW_FALLBACK=
# AUTH_REQUIRED_ACTIONS_MATRIX_ALLOW_FALLBACK_SUNSET=

# ── Token-schema mode ───────────────────────────────────────────────────────
# Defaults: local→warn, staging→reject, production→reject (locked; warn is
# REFUSED in prod). Set to 'warn' in staging only for a 7-day burn-in window.
# AUTH_TOKEN_SCHEMA_MODE=
# AUTH_TOKEN_SCHEMA_MODE_SUNSET=                 # YYYY-MM-DD (max 7 days)

# ── Claim-first context guard ───────────────────────────────────────────────
# off → no checks. shadow → checks run, mismatches logged + counted but
# request proceeds. on → checks run, mismatches REJECT the request.
# AUTH_CLAIM_FIRST_CONTEXT=off

# Log sampler for claim-mismatch warnings. Counters stay UNSAMPLED; only the
# warn-log line cardinality is throttled. Defaults shown.
# AUTH_MISMATCH_LOG_BURST=10                     # first N events/min unconditionally
# AUTH_MISMATCH_LOG_SAMPLE_RATE=100              # thereafter log every K-th event
# AUTH_MISMATCH_LOG_WINDOW_MS=60000              # window length

# ── Platform-context gate ───────────────────────────────────────────────────
# Controls the createRequirePlatformContext middleware. 'on' enforces; 'off'
# logs only. Defaults to on in non-local; defer to env-gate resolver in local.
# AUTH_PLATFORM_CONTEXT_GATE=

# Require the X-Plane-Key header on /api/auth/verify. Defaults to on in
# non-local; helps catch BFF/wrapper bugs that drop the header.
# AUTH_VERIFY_REQUIRE_PLANE=

# ── Session-store keyspace namespacing ──────────────────────────────────────
# CSV of namespace prefixes the session store may use (defaults to all three
# planes). Used by session-store eviction + audit replay tooling.
# SESSION_NAMESPACES=neon,mesh,admin

# =============================================
# HOSTNAMES (Local Development)
# =============================================
# Gateway & Infrastructure
GATEWAY_HOST=gateway.athyper.local
IAM_HOST=iam.athyper.local
OBJECTSTORAGE_HOST=objectstorage.athyper.local
OBJECTSTORAGE_CONSOLE_HOST=objectstorageui.athyper.local

# Observability
TELEMETRY_HOST=telemetry.athyper.local
METRICS_HOST=metrics.athyper.local
ALERTMANAGER_HOST=alerts.athyper.local
TRACES_HOST=traces.athyper.local
LOGS_HOST=logs.athyper.local

# Monitoring (monitoring profile)
STATUSWATCH_HOST=uptime.athyper.local
CRONWATCH_HOST=healthchecks.athyper.local
ERRORCOLLECT_HOST=errors.athyper.local

# Admin (admin profile — dev-only in dbconsole's case)
# queueconsole: normal administration uses the RBAC-protected /api/jobs/admin/* API.
# The read-only sidecar container under
# compose profile `emergency` has no hostname — it is reachable only on
# the internal Docker network during break-glass incidents.
DBCONSOLE_HOST=dbconsole.athyper.local

# Search (search profile)
SEARCHCORE_HOST=meilisearch.athyper.local

# Analytics (analytics profile — DEFERRED, hedge stage; see
# use the Stack v2 analytics capability plan before enabling)
ANALYTICSBOARD_HOST=metabase.athyper.local

# Secrets (security-infisical profile — opt-in)
SECRETSTORE_HOST=infisical.athyper.local

# Applications
APPS_ATHYPER_WEB_HOST=neon.athyper.local
APPS_ATHYPER_NEON_HOST=neon.athyper.local
APPS_ATHYPER_MESH_HOST=mesh.athyper.local
APPS_ATHYPER_STUDIO_HOST=studio.athyper.local
APPS_ATHYPER_API_HOST=api.athyper.local
# Local development upstreams.
# Traefik stays in Docker, while the API and Next.js plane apps run on the host.
# Staging/production templates deliberately use in-network Docker service names.
APPS_ATHYPER_WEB_UPSTREAM_URL=http://host.docker.internal:3101
APPS_ATHYPER_NEON_UPSTREAM_URL=http://host.docker.internal:3101
APPS_ATHYPER_MESH_UPSTREAM_URL=http://host.docker.internal:3102
APPS_ATHYPER_STUDIO_UPSTREAM_URL=http://host.docker.internal:3103
APPS_ATHYPER_API_UPSTREAM_URL=http://host.docker.internal:4000

# =============================================
# GATEWAY (Traefik)
# =============================================
GATEWAY_TLS_OPTIONS=athyper-tls-default@file
# ACME cert resolver — empty in local dev (self-signed via file provider).
# Set to letsencrypt-staging or letsencrypt in staging/production.
GATEWAY_CERT_RESOLVER=
# Host-guard middleware — inactive in local dev (web runs outside Docker).
# Set to the gateway-fronted hostname in staging/production.
GATEWAY_ORIGIN=https://neon.athyper.local
ALLOWED_HOSTS=neon.athyper.local
NEON_ALLOWED_HOSTS=neon.athyper.local
NEON_GATEWAY_ORIGIN=https://neon.athyper.local
MESH_ALLOWED_HOSTS=mesh.athyper.local
MESH_GATEWAY_ORIGIN=https://mesh.athyper.local
STUDIO_ALLOWED_HOSTS=studio.athyper.local
STUDIO_GATEWAY_ORIGIN=https://studio.athyper.local
DASHBOARD_AUTH_MW=athyper-dashboard-auth@file
GATEWAY_ACCESSLOG=true
# Drops full request path/query from Traefik access logs so auth codes, state,
# login hints, and tenant/workspace context never land in request-line logs.
GATEWAY_ACCESSLOG_REQUEST_PATH_MODE=drop
GATEWAY_LOG_LEVEL=DEBUG
# Dashboard basic-auth htpasswd (user:bcrypt_hash).
# $$ is required because Docker Compose resolves $VAR in YAML;
# double-dollar escapes the literal $ in the bcrypt hash.
# Generate new: htpasswd -nbB admin <password> | sed 's/\$/\$\$/g'
GATEWAY_DASHBOARD_HTPASSWD=athyperadmin:$$2y$$05$$NVCnGffZfFqIT.gM5/QipOXFSED4v5h6edLZNtZHEfS0z46qCbltS

# =============================================
# SERVICE MEMORY LIMITS
# =============================================
GATEWAY_MEMORY_LIMIT=128m
IAM_MEMORY_LIMIT=768m
OBJECTSTORAGE_MEMORY_LIMIT=256m
MEMORYCACHE_MEMORY_LIMIT=128m
MEMORYCACHE_EXPORTER_MEMORY_LIMIT=64m
TELEMETRY_MEMORY_LIMIT=256m
METRICS_MEMORY_LIMIT=384m
ALERTMANAGER_MEMORY_LIMIT=128m
TRACING_MEMORY_LIMIT=256m
LOGGING_MEMORY_LIMIT=384m
LOGSHIPPER_MEMORY_LIMIT=256m
APPS_ATHYPER_MEMORY_LIMIT=256m
DB_MEMORY_LIMIT=512m
DBPOOL_APPS_MEMORY_LIMIT=64m
DBPOOL_SESSION_MEMORY_LIMIT=64m
VIRUSSCAN_MEMORY_LIMIT=600m
# --- Render profile (docrender + docparser) ---
DOCRENDER_MEMORY_LIMIT=1g
DOCRENDER_CPU_LIMIT=1.0
DOCPARSER_MEMORY_LIMIT=1g
# --- Monitoring profile (statuswatch + cronwatch + errorcollect) ---
STATUSWATCH_MEMORY_LIMIT=128m
CRONWATCH_MEMORY_LIMIT=256m
ERRORCOLLECT_MEMORY_LIMIT=384m
# --- Admin profile (queueconsole + dbconsole) ---
QUEUECONSOLE_MEMORY_LIMIT=128m
DBCONSOLE_MEMORY_LIMIT=64m
BULLBOARD_REDIS_HOST=memorycache-jobs
BULLBOARD_REDIS_PORT=6379
BULLBOARD_REDIS_DB=0
BULLBOARD_REDIS_USE_TLS=false
BULLBOARD_REDIS_USER=bullboard
# Leave unset to reuse MEMORYCACHE_PASSWORD. Set explicitly when BullMQ points
# at a dedicated Redis with different credentials.
BULLBOARD_UI_USER=athyper-emergency
BULLBOARD_UI_PASSWORD=change-me-before-use
QUEUECONSOLE_HOST_PORT=3001
# --- Search profile (searchcore) ---
SEARCHCORE_MEMORY_LIMIT=256m
# --- Analytics profile / analyticsboard (DEFERRED) ---
ANALYTICSBOARD_MEMORY_LIMIT=1g
# --- Secrets profile (secretstore) ---
SECRETSTORE_MEMORY_LIMIT=384m

# =============================================
# DATABASE (PostgreSQL via PgBouncer)
# =============================================
# PgBouncer config paths (relative to ATHYPER_CONFIG)
DBPOOL_APPS_CONFIG=db/local/dbpool/pgbouncer-apps.ini
DBPOOL_SESSION_CONFIG=db/local/dbpool/pgbouncer-session.ini
DB_ADMIN_USER=athyperadmin
DB_ADMIN_PASSWORD=athyperadmin
STUDIO_DATABASE_URL=postgresql://athyper_runtime:athyper-runtime-local-change-me@dbpool-apps:6432/athyper_studio?sslmode=disable
STUDIO_DATABASE_ADMIN_URL=postgresql://athyperadmin:athyperadmin@db:5432/athyper_studio?sslmode=disable
DATABASE_URL=postgresql://athyper_runtime:athyper-runtime-local-change-me@dbpool-apps:6432/athyper_neon?sslmode=disable
DATABASE_ADMIN_URL=postgresql://athyperadmin:athyperadmin@db:5432/athyper_neon?sslmode=disable
MESH_DATABASE_URL=postgresql://athyper_runtime:athyper-runtime-local-change-me@dbpool-apps:6432/athyper_mesh?sslmode=disable
MESH_DATABASE_ADMIN_URL=postgresql://athyperadmin:athyperadmin@db:5432/athyper_mesh?sslmode=disable
NEON_WORKER_DATABASE_URL=postgresql://athyper_runtime:athyper-runtime-local-change-me@dbpool-apps:6432/athyper_neon?sslmode=disable
STUDIO_WORKER_DATABASE_URL=postgresql://athyper_runtime:athyper-runtime-local-change-me@dbpool-apps:6432/athyper_studio?sslmode=disable
MESH_WORKER_DATABASE_URL=postgresql://athyper_runtime:athyper-runtime-local-change-me@dbpool-apps:6432/athyper_mesh?sslmode=disable
DATABASE_POOL_MAX=5
# PgBouncer auth — userlist generated at container start from these env vars
DBPOOL_APPS_USER=athyper_runtime
DBPOOL_APPS_PASSWORD=athyper-runtime-local-change-me
DBPOOL_SESSION_USER=athyperadmin
DBPOOL_SESSION_PASSWORD=athyperadmin

# =============================================
# CACHE (Redis)
# =============================================
# Uses Docker internal hostname 'memorycache' (the Redis container name)
REDIS_URL=redis://app:athyperadmin@memorycache:6379/0
SESSION_TOKEN_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
SESSION_TOKEN_PREVIOUS_KEYS=
SESSION_KEY_VERSION=1
SESSION_STORE_VERSION=1
SESSION_REDIS_NAMESPACE=athyper:session
AUTH_CONFIGURATION_REVISION=1
AUTH_TRUSTED_DEVICE_TTL_DAYS=30
MEMORYCACHE_PASSWORD=athyperadmin
# Per-service Redis passwords (ACL hashes computed at container start from these vars)
REDIS_EXPORTER_PASSWORD=athyperadmin
# Dedicated users for GlitchTip (Celery + Django cache, DB 1) and Infisical
# (session cache + rate limiting, DB 2). Separate credentials so a compromise
# of one service does not expose the other. Neither user has admin/dangerous commands.
REDIS_GLITCHTIP_PASSWORD=athyperadmin
REDIS_BULLBOARD_PASSWORD=athyperadmin
REDIS_INFISICAL_PASSWORD=athyperadmin
# Breakglass only — no service connects as this user.
# Emergency: redis-cli --user admin -a <REDIS_ADMIN_PASSWORD>
REDIS_ADMIN_PASSWORD=athyperadmin
# Redis client tuning
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_MAX_RETRIES_PER_REQUEST=2
REDIS_MAX_RETRIES=2
REDIS_ERROR_LOG_COOLDOWN_MS=10000

# =============================================
# OBJECT STORAGE (MinIO S3)
# S3_ACCESS_KEY/S3_SECRET_KEY = MinIO root user (MINIO_ROOT_USER in compose).
# In local dev all scoped credentials equal root — objectstorage-init no-ops.
# In staging/production objectstorage-init creates dedicated scoped accounts.
# =============================================
S3_ENDPOINT=http://objectstorage:9000
S3_ACCESS_KEY=athyperadmin
S3_SECRET_KEY=athyperadmin
S3_REGION=us-east-1
S3_BUCKET=athyper-local

# Publication rollout (disabled until Studio authority keys and target DDL are ready)
PUBLICATION_API_ENABLED=false
PUBLICATION_COMPILE_ENABLED=false
PUBLICATION_DISPATCH_ENABLED=false
PUBLICATION_APPLY_ENABLED=false
PUBLICATION_RECOVERY_ENABLED=false
PUBLICATION_TARGET_PLANES=studio,neon,mesh
PUBLICATION_REQUIRE_SIGNATURE=true
PUBLICATION_SIGNING_KEY_ID=publication-local-v1
PUBLICATION_PRIVATE_KEY_REFERENCE=publication/signing/private
PUBLICATION_PUBLIC_KEY_REFERENCE=publication/signing/public
PUBLICATION_RUNTIME_VERSION=1.0.0
PUBLICATION_RECOVERY_INTERVAL_MS=60000
INFISICAL_URL=http://secretstore:8080
INFISICAL_TOKEN=
INFISICAL_WORKSPACE_ID=
INFISICAL_ENVIRONMENT=dev
INFISICAL_SECRET_PATH=/publication
S3_USE_SSL=false
# Multipart upload tuning (defaults are conservative and work for most workloads)
S3_MULTIPART_PART_SIZE_MB=5
S3_MULTIPART_QUEUE_SIZE=4
S3_MAX_UPLOAD_MB=100
ATTACHMENT_TENANT_QUOTA_GB=10
ATTACHMENT_TENANT_QUOTA_ITEMS=50000
ATTACHMENT_QUOTA_RESERVATION_TTL_SECONDS=1800
ATTACHMENT_QUOTA_RETRY_AFTER_SECONDS=900
S3_PRESIGNED_TTL_SECONDS=900

# Scoped service account — athyper-app (readwrite on S3_BUCKET).
# Local dev: same as root. Non-local: inject dedicated MinIO user credentials.
# objectstorage-init creates this account with athyper-app-policy.
APP_S3_ACCESS_KEY=athyperadmin
APP_S3_SECRET_KEY=athyperadmin

# Scoped service account — athyper-backup (readwrite on BACKUP_S3_BUCKET).
# Local dev: same as root. Non-local: inject dedicated MinIO user credentials.
# objectstorage-init creates this account with athyper-backup-policy.
BACKUP_S3_BUCKET=athyper-backups
BACKUP_S3_ACCESS_KEY=athyperadmin
BACKUP_S3_SECRET_KEY=athyperadmin

# =============================================
# IAM (Keycloak)
# Maps to KC_BOOTSTRAP_ADMIN_USERNAME / KC_BOOTSTRAP_ADMIN_PASSWORD in compose
# KEYCLOAK_IMAGE_TAG: single source for scripts + compose — bump here when upgrading
# =============================================
KEYCLOAK_IMAGE_TAG=26.7.2
IAM_ADMIN=athyperadmin
IAM_ADMIN_PASSWORD=athyperadmin
# KC admin API credentials used by the Neon web BFF for server-side org enrichment.
# Must match IAM_ADMIN / IAM_ADMIN_PASSWORD in local dev.
KEYCLOAK_ADMIN_USERNAME=athyperadmin
KEYCLOAK_ADMIN_PASSWORD=athyperadmin
IAM_DB_URL=jdbc:postgresql://dbpool-session:6433/athyper_iam?preferQueryMode=simple
IAM_DB_USERNAME=athyperadmin
IAM_DB_PASSWORD=athyperadmin
IAM_ISSUER_URL=https://iam.athyper.local/realms/athyper
IAM_CLIENT_ID=athyper-api-runtime
IAM_CLIENT_SECRET=athyperadmin
IAM_DEFAULT_REALM=athyper
STUDIO_WEB_CLIENT_SECRET=AdminWeb@1234
ATHYPER_SVC_RUNTIME_WORKER_CLIENT_SECRET=
NEON_SVC_BFF_CLIENT_SECRET=
NEON_KEYCLOAK_REALM=athyper
NEON_KEYCLOAK_CLIENT_ID=neon-web
MESH_KEYCLOAK_REALM=athyper
MESH_KEYCLOAK_CLIENT_ID=mesh-web
STUDIO_KEYCLOAK_REALM=athyper
STUDIO_KEYCLOAK_CLIENT_ID=studio-web
# Feature flags baked into the browser bundle at build time.
NEXT_PUBLIC_GITHUB_LOGIN_ENABLED=false
NEXT_PUBLIC_PLATFORM_CONTROL_ENABLED=false
# Social login → tenant mapping (used when KC org claim is absent).
GITHUB_TENANT_ID=

# Demo-user seed passwords — retained for IAM fixture generation only.
# Realm JSON files contain NO plaintext credentials; kcadm.sh sets these after realm import.
# Override in staging/prod; rotate regularly.
IAM_DEMO_USER_PASSWORD=Demo@1234
IAM_PLATFORM_CONTROL_USER_PASSWORD=Admin@1234

# Platform Control Realm (disabled by default, enable for platform admin features)
PLATFORM_CONTROL_ENABLED=false
PLATFORM_KEYCLOAK_REALM=platform-control
PLATFORM_KEYCLOAK_CLIENT_ID=athyper-studio
PLATFORM_IAM_ISSUER_URL=https://iam.athyper.local/realms/platform-control

# IAM SMTP (local dev uses mailtrap — no auth required)
# mailtrap SMTP: mailtrap:1025 (Docker internal)
# mailtrap Web UI: https://mailtrap.athyper.local
MAILTRAP_HOST=mailtrap.athyper.local
KC_SMTP_HOST=mailtrap
KC_SMTP_PORT=1025
KC_SMTP_FROM=noreply@athyper.local
KC_SMTP_FROM_DISPLAY_NAME=Athyper
KC_SMTP_AUTH=false
KC_SMTP_SSL=false
KC_SMTP_STARTTLS=false
KC_WEBAUTHN_RP_ID=athyper.local
# KC_SMTP_USERNAME and KC_SMTP_PASSWORD are NOT set in local dev (mailtrap requires no auth).
# Staging/production: override all KC_SMTP_* vars to point at your real SMTP provider.
# Staging (Brevo):
#   KC_SMTP_HOST=smtp-relay.brevo.com
#   KC_SMTP_PORT=587
#   KC_SMTP_AUTH=true
#   KC_SMTP_SSL=false
#   KC_SMTP_STARTTLS=true
#   KC_SMTP_USERNAME=<brevo_smtp_login>     # adff41001@smtp-brevo.com
#   KC_SMTP_PASSWORD=<brevo_smtp_key>
# Production (AWS SES eu-central-1):
#   KC_SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
#   KC_SMTP_PORT=587
#   KC_SMTP_AUTH=true
#   KC_SMTP_SSL=false
#   KC_SMTP_STARTTLS=true
#   KC_SMTP_USERNAME=<ses_smtp_username>
#   KC_SMTP_PASSWORD=<ses_smtp_password>

# App SMTP — notification email channel
# Local dev: compose defaults to mailtrap:1025 (no .env entry needed).
# Bounce webhook: register at https://api.athyper.com/api/notifications/webhooks/email-bounce
#   Brevo: Authentication method = Token, value = SMTP_BOUNCE_WEBHOOK_SECRET
#   SES:   SNS subscription, Authorization: Bearer <SMTP_BOUNCE_WEBHOOK_SECRET>
# Staging (Brevo):
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=adff41001@smtp-brevo.com
#   SMTP_PASS=<brevo_smtp_key>
#   SMTP_FROM=noreply.neon-test@athyper.com   # per-plane override via SMTP_FROM_NEON/MESH/ADMIN
# Production (AWS SES eu-central-1):
#   SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=<ses_smtp_username>
#   SMTP_PASS=<ses_smtp_password>
#   SMTP_FROM=noreply.neon@athyper.com
# SMTP_HOST=mailtrap
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@athyper.local
SMTP_BOUNCE_WEBHOOK_SECRET=

# Web Push (VAPID) - browser push channel
# Generate a local keypair with:
#   npx web-push generate-vapid-keys
# Private key is a signing credential; keep staging/production values in secrets.
VAPID_SUBJECT=mailto:noreply@athyper.local
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Google OAuth (Phase 6 — set credentials to enable pepsi org SSO routing)
# Obtain from: GCP Console → APIs & Services → OAuth 2.0 Credentials
# Redirect URI: https://iam.athyper.local/realms/athyper/broker/google/endpoint
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LinkedIn OAuth (Mesh/external-partner scenarios only; never Admin)
# Redirect URI: https://iam.athyper.local/realms/athyper/broker/linkedin/endpoint
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Windows/Kerberos is a separately deployable internal enterprise feature.
ATHYPER_ENTERPRISE_WINDOWS_AUTH_ENABLED=false

# GitHub OAuth (Social Login — set credentials to enable GitHub login button)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# =============================================
# IAM SECRETS (SUPERSTAR env vars)
# =============================================
# These are resolved by kernel config loader
ATHYPER_SUPER__IAM_SECRET__IAM_ATHYPER_CLIENT_SECRET=athyperadmin

# =============================================
# LEGACY PDF RENDERER (superseded by docrender)
# =============================================
# The athyper-renderer container was retired in favour of Gotenberg
# (see the RENDER PROFILE below). The
# bootstrap still keeps PdfRendererClient as a fallback for back-compat,
# so the token stays defined but the URL is intentionally blank — set it
# only if you stand up a custom legacy renderer.
RENDERER_INTERNAL_TOKEN=athyperadmin
RENDERER_BASE_URL=

# =============================================
# VIRUS SCANNING (ClamAV)
# =============================================
# The governed server adapter supports fail-closed only:
# if clamd is unreachable, uploads return 503 rather than silently bypassing the
# virus scan. Scanner failures are never interpreted as a clean result.
# CLAMD_HOST=virusscan
# CLAMD_PORT=3310
# CLAMD_TIMEOUT_MS=30000
# CLAMD_MAX_BYTES=104857600
# CLAMD_ON_UNAVAILABLE=fail-closed

# =============================================
# CREDENTIAL ENCRYPTION
# =============================================
# Not required in local dev (bootstrap warns + disables encryption).
# !! REQUIRED in staging/production — server MUST refuse to start without it.
# Generate: openssl rand -base64 48
# CREDENTIAL_MASTER_KEY=

# =============================================
# TELEMETRY (OpenTelemetry)
# =============================================
OTLP_ENDPOINT=http://logshipper:4318
TELEMETRY_ADMIN_USER=athyperadmin
TELEMETRY_ADMIN_PASSWORD=athyperadmin

# --- Alertmanager contact routing ---
# Local dev routes alerts to mailtrap. Staging/production must inject real
# SMTP relay and recipient groups via env/secrets.
ALERTMANAGER_SMTP_SMARTHOST=mailtrap:1025
ALERTMANAGER_SMTP_FROM=alerts@athyper.local
ALERTMANAGER_SMTP_REQUIRE_TLS=false
ALERTMANAGER_SMTP_AUTH_USERNAME=
ALERTMANAGER_SMTP_AUTH_PASSWORD=
ALERTMANAGER_PLATFORM_EMAIL=ops@athyper.local
ALERTMANAGER_CRITICAL_EMAIL=critical@athyper.local
ALERTMANAGER_FINANCE_EMAIL=finance@athyper.local
ALERTMANAGER_COMPLIANCE_EMAIL=compliance@athyper.local
ALERTMANAGER_SECURITY_EMAIL=security@athyper.local

# --- Tempo storage backend ---
# Local dev keeps filesystem (bind-mounted, durable across restarts).
# Staging/production switch to s3 → MinIO (objectstorage service) for
# lifecycle-managed retention. Tempo expands ${VAR} at start via
# `-config.expand-env=true`; every var must be defined (empty is fine
# for the backend not in use). Stack v2 operations-lite uses local storage and
# does not enable Tempo unless tracing mode is selected explicitly.
TEMPO_STORAGE_BACKEND=local
TEMPO_S3_BUCKET=athyper-tempo-traces
TEMPO_S3_ENDPOINT=objectstorage:9000
TEMPO_S3_ACCESS_KEY=athyperadmin
TEMPO_S3_SECRET_KEY=athyperadmin
TEMPO_S3_INSECURE=true

# --- Loki storage backend ---
# Local dev keeps filesystem; staging/production switch to s3 → MinIO.
# Loki expands ${VAR} at start via `-config.expand-env=true`; every var
# must be defined (empty is fine for the backend not in use).
# Stack v2 operations-lite uses local Loki storage and has no bucket-init job.
LOKI_STORAGE_BACKEND=filesystem
LOKI_S3_BUCKET=athyper-loki-logs
LOKI_S3_ENDPOINT=objectstorage:9000
LOKI_S3_ACCESS_KEY=athyperadmin
LOKI_S3_SECRET_KEY=athyperadmin
LOKI_S3_INSECURE=true

# --- Distributed tracing — OpenTelemetry → Tempo ---
# Empty OTEL_EXPORTER_OTLP_ENDPOINT disables tracing (SDK no-op, no
# auto-instrumentation load). Set to the Tempo service hostname on the
# internal Docker network — Tempo listens on 4317 (gRPC) / 4318 (HTTP).
OTEL_EXPORTER_OTLP_ENDPOINT=http://tracing:4317
# Service name tag attached to every span. Falls back to SERVICE_NAME.
OTEL_SERVICE_NAME=athyper-runtime
# Head-based sampling ratio (0.0-1.0). 1.0 = full trace capture (local dev);
# drop to ~0.1 in production once ingest volume is measured.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

# =============================================
# RENDER PROFILE (docrender + docparser)
# =============================================
# Gotenberg handles HTML/Office → PDF; Tika extracts text from binaries.
# Both are internal-only (no gateway route).
#
# Canonical tuning + error-category contract:
#   stack/config/render/README.md
#   stack/config/render/docrender.conf           (local reference)
#   stack/config/render/environments/*.conf      (per-env variants)
#   stack/config/render/docparser-config.xml          (mounted into tika)
#
# The values below must match stack/config/render/docrender.conf — keep
# them in sync when tuning (the .conf file is the source of truth; env
# file is the propagation channel for compose-time interpolation).
DOCRENDER_REPLICAS=1
DOCRENDER_API_TIMEOUT=120s
DOCRENDER_LIBREOFFICE_RESTART_AFTER=50
DOCRENDER_CHROMIUM_ALLOW_LIST=file:///tmp.*
# App-side consumer URLs — read by server/packages/foundation/render and the
# attachment-text-extract worker (svc-jobs/workers/tika-extract). Internal
# hostnames resolve only inside the athyper-internal Docker network.
DOCRENDER_BASE_URL=http://docrender:3000
# DOCPARSER_URL — consumed by the attachment-text-extract worker. When unset, the
# worker is not created and enqueued extraction jobs will accumulate until
# docparser is configured.
DOCPARSER_URL=http://docparser:9998

# =============================================
# MONITORING PROFILE (statuswatch + cronwatch + errorcollect)
# =============================================
# Healthchecks + GlitchTip reuse the stack Postgres (see init-databases.sh).
# GlitchTip ingest endpoint is intentionally NOT gateway-auth-gated — SDK
# clients send events unauthenticated using the DSN.
# Rotate in staging/production; validate-env.sh rejects the athyperadmin-*
# defaults there.
CRONWATCH_SECRET_KEY=athyperadmin-hc-local-change-me
ERRORCOLLECT_SECRET_KEY=athyperadmin-gt-local-change-me
# App-side consumer URLs.
# Healthchecks is reached over the internal network (no TLS hop); the
# ping path is /ping/<slug>. The slug today is "{queue}-{jobName}" —
# see server/packages/foundation/monitoring/healthchecks.ts.
CRONWATCH_BASE_URL=http://cronwatch:8000/ping
CRONWATCH_PING_KEY=
STATUSWATCH_WORKER_PUSH_URL=
STATUSWATCH_SCHEDULER_PUSH_URL=
CRONWATCH_EMAIL_USE_TLS=false
# GlitchTip DSN — obtain after first-run org/project setup at
# https://errors.athyper.local/. Leave blank to keep Sentry SDK as a no-op.
GLITCHTIP_DSN=
# 0 = no perf traces; 0.05 = sample 5% of transactions.
SENTRY_TRACES_SAMPLE_RATE=0
# Web (apps/web) frontend DSN — @sentry/nextjs. Shares the GlitchTip project
# with the runtime API by default; point to a separate project if event
# volumes warrant splitting. Baked into the browser bundle at build time.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_ENVIRONMENT=local
NEXT_PUBLIC_SERVICE_VERSION=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# Source-map upload (set in CI / deploy only — never commit a real token).
# When present during `next build`, client + server maps upload to GlitchTip
# and .map files are stripped from the build artefact.
SENTRY_ORG=athyper
SENTRY_PROJECT=athyper-web
SENTRY_URL=https://errors.athyper.local/
SENTRY_AUTH_TOKEN=

# =============================================
# ADMIN PROFILE (queueconsole + dbconsole)
# =============================================
# pgweb is DEV-ONLY — validate-env.sh blocks the admin profile in
# staging/production. BullBoard may be opt-in enabled for incident
# response, always behind DASHBOARD_AUTH_MW.
PGWEB_AUTH_USER=athyperadmin
PGWEB_AUTH_PASS=athyperadmin

# =============================================
# SEARCH PROFILE (searchcore)
# =============================================
# Infra only — indexing worker and search API are wired separately.
# The master key is admin-only; app code should use scoped API keys or
# tenant tokens (JWTs), never the master.
# Rotate in staging/production. Generate: openssl rand -base64 32
# Internal Docker hostname used by API containers to reach searchcore.
SEARCHCORE_URL=http://searchcore:7700
# MEILI_MASTER_KEY: native env var read by the searchcore container binary.
# SEARCHCORE_MASTER_KEY: same value, read by the API server (server/src/config.ts).
MEILI_MASTER_KEY=athyperadmin-meili-local-change-me
SEARCHCORE_MASTER_KEY=athyperadmin-meili-local-change-me
# Meilisearch-internal env ("development" enables extra dev-only UI chrome;
# "production" is the default for any non-local deployment).
MEILI_ENV=development
MEILI_LOG_LEVEL=INFO
# Max RAM Meili uses while indexing. Default tuned for 256m container;
# bump on staging/production.
MEILI_MAX_INDEXING_MEMORY=128MiB

# =============================================
# ANALYTICS PROFILE (analyticsboard) — DEFERRED, hedge stage
# =============================================
# Pre-staged but NOT in any default profile set. Read
# Stack v2 analytics capability plan before enabling. Two real blockers:
# (1) a Postgres read replica must back the data source — never the
# primary; (2) governance sign-off (account provisioning / schema
# exposure / PII / SOX) is required.
#
# App DB defaults to embedded H2 on a volume — fine for the dormant
# hedge / local exploration; switch to MB_DB_TYPE=postgres before any
# non-local deploy.
MB_DB_TYPE=h2
MB_DB_CONNECTION_URI=
# JVM tuning. -Xmx768m fits inside ANALYTICSBOARD_MEMORY_LIMIT=1g with headroom
# for native + GC overhead. G1GC is Metabase's recommended collector.
MB_JAVA_OPTS=-Xmx768m -XX:+UseG1GC
# Governance gate. Must be set to literal "approved" to bring the
# analytics profile up in staging/production. validate-env.sh enforces.
ANALYTICSBOARD_GOVERNANCE_APPROVED=false

# =============================================
# SECRETS PROFILE (secretstore)
# =============================================
# Infra-only. Admin provisions secrets via UI after first-boot.
#
# State: Postgres DB `infisical` + Redis DB index 2 (no container volume).
#
# ENCRYPTION_KEY: 32 hex chars (128-bit). Infisical uses this to derive
# per-workspace data keys. NOT the athyper CREDENTIAL_MASTER_KEY.
# Generate: openssl rand -hex 16
INFISICAL_ENCRYPTION_KEY=6c1fe4e49cb45b9115d42b127bc5db17
# AUTH_SECRET: signs Infisical's own session JWTs. Any string ≥32 chars.
# Generate: openssl rand -base64 32
INFISICAL_AUTH_SECRET=athyperadmin-infisical-auth-local-change-me!!
