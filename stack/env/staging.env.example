# =============================================
# athyper Stack — Staging Environment (Bootstrap)
# =============================================
# This file contains NON-SECRET staging configuration only.
# It is copied to stack/env/.env during Phase 9.1 of staging setup.
#
# SECRET variables (passwords, keys, tokens) are intentionally absent.
# They are generated by write-env-staging.sh and live exclusively in
# /opt/stack/athyper/secrets/.env (root:athyper 750, mode 600).
#
# Two-file loading (compose.sh):
#   --env-file stack/env/.env          ← this file (non-secret config)
#   --env-file secrets/.env            ← generated secrets (wins on duplicates)
#
# Optional-feature variables (SMTP, OAuth, Sentry) are marked below.
# Leave them unset — their features are simply disabled until you provision them.
#
# Environment-specific files:
#   .env.example              ← Local dev
#   staging.env.example       ← Staging (this file)
#   production.env.example    ← Production

# =============================================
# ENVIRONMENT IDENTITY
# =============================================
ENVIRONMENT=staging
# Pinned — must match across all envs so container/volume/network names are
# stable. Changing this renames every container and orphans all named volumes.
COMPOSE_PROJECT_NAME=athyper

# =============================================
# RUNTIME CONFIGURATION
# =============================================
MODE=api
MULTITENANT=TRUE
SERVICE_NAME=athyper-runtime
# Set to actual release tag in CI (e.g. 1.2.3). Manual staging: stays 1.0.0.
SERVICE_VERSION=1.0.0
WEB_PORT=3000
API_PORT=3000
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=30000
NODE_ENV=production
NODE_TLS_REJECT_UNAUTHORIZED=1

# =============================================
# PUBLIC URLs
# =============================================
PUBLIC_BASE_URL=https://api-stg.athyper.com
PUBLIC_WEB_URL=https://neon-stg.athyper.com

# =============================================
# BASE PATHS (server runtime roots)
# =============================================
# These six vars are set by appending to stack/env/.env in Phase 9.1 of
# staging setup (see staging-setup.md). compose.sh reads them and exports
# ATHYPER_CONFIG / ATHYPER_DATA as backwards-compat aliases so compose bind
# mounts do not need to change.
#
# Staging server runtime roots — set as actual values so compose.sh and scripts
# have the correct paths without requiring systemd Environment= lines to be set first.
# Do NOT set ATHYPER_CONFIG or ATHYPER_DATA — they are derived aliases in compose.sh.
# ATHYPER_SECRETS_ROOT is intentionally absent: it is injected via systemd
# Environment= so that compose.sh activates the two-file bootstrap+secrets model.
ATHYPER_CONFIG_ROOT=/opt/stack/athyper/config
ATHYPER_DATA_ROOT=/opt/stack/athyper/data
ATHYPER_LOG_ROOT=/opt/stack/athyper/logs
ATHYPER_BACKUP_ROOT=/opt/stack/athyper/backups
ATHYPER_KERNEL_CONFIG_PATH=apps/kernel.config.staging.parameter.json
AUTH_DEBUG_EXPOSE_TOKENS=false

# =============================================
# HOSTNAMES
# =============================================
# Gateway & Infrastructure
GATEWAY_HOST=gateway-stg.athyper.com
IAM_HOST=iam-stg.athyper.com
OBJECTSTORAGE_HOST=objectstorage-stg.athyper.com
OBJECTSTORAGE_CONSOLE_HOST=objectstorage.console-stg.athyper.com

# Observability
TELEMETRY_HOST=telemetry-stg.athyper.com
METRICS_HOST=metrics-stg.athyper.com
ALERTMANAGER_HOST=alerts-stg.athyper.com
TRACES_HOST=traces-stg.athyper.com
LOGS_HOST=logs-stg.athyper.com

# Monitoring (monitoring profile)
UPTIME_HOST=uptime-stg.athyper.com
HEALTHCHECKS_HOST=healthchecks-stg.athyper.com
GLITCHTIP_HOST=errors-stg.athyper.com

# Admin: BullBoard is embedded in the API runtime at /api/jobs/admin/board,
# gated by JOBS.BOARD.VIEW / JOBS.QUEUE.MANAGE. The sidecar container
# (compose profile `emergency`) is internal-only — no public hostname.
# pgweb is blocked by validate-env.sh.
BULLBOARD_REDIS_HOST=memorycache
BULLBOARD_REDIS_PORT=6379
BULLBOARD_REDIS_DB=0
BULLBOARD_REDIS_USE_TLS=false
BULLBOARD_REDIS_USERNAME=app
# Leave unset to reuse MEMORYCACHE_PASSWORD. If REDIS_BULLMQ_URL points at the
# dedicated memorycache-jobs service, set BULLBOARD_REDIS_HOST=memorycache-jobs.
BULLBOARD_REDIS_PASSWORD=

# Search (search profile)
MEILI_HOST=meilisearch-stg.athyper.com

# Analytics (analytics profile — DEFERRED, do NOT enable without
# read replica + governance sign-off; see analytics/README.md)
METABASE_HOST=metabase-stg.athyper.com

# Secrets (security-infisical profile)
INFISICAL_HOST=infisical-stg.athyper.com

# Applications
APPS_ATHYPER_WEB_HOST=neon-stg.athyper.com
APPS_ATHYPER_API_HOST=api-stg.athyper.com
# Traefik upstream for the Neon web app — in-network Docker service name.
APPS_ATHYPER_WEB_UPSTREAM_URL=http://athyper-neon-web:3000
# Traefik upstream for the API — must be a valid URL even though the Docker-label
# router (priority ~30) always wins over the static file-provider router (priority 1).
# An empty value causes Traefik to emit a backend-parse warning at startup.
APPS_ATHYPER_API_UPSTREAM_URL=http://athyper-api:3000

# Single-ingress host guard (apps/web/middleware.ts): the athyper-neon-web
# container rejects requests whose Host header is not in ALLOWED_HOSTS.
# GATEWAY_ORIGIN is the redirect target for direct-access Host headers.
ALLOWED_HOSTS=neon-stg.athyper.com
GATEWAY_ORIGIN=https://neon-stg.athyper.com

# ── Neon Web — container-specific env (apps profile) ───────────────────────
# The web BFF uses a dedicated KC client distinct from the API's client_id.
KEYCLOAK_CLIENT_ID=neon-web
# KEYCLOAK_ADMIN_USERNAME / KEYCLOAK_ADMIN_PASSWORD — injected from secrets/.env
# Feature flags baked into the browser bundle at build time.
NEXT_PUBLIC_GITHUB_LOGIN_ENABLED=false
NEXT_PUBLIC_PLATFORM_CONTROL_ENABLED=false
# Social login → tenant mapping (used when KC org claim is absent).
GITHUB_TENANT_ID=

# =============================================
# GATEWAY (Traefik)
# =============================================
GATEWAY_TLS_OPTIONS=athyper-tls-default@file
# ACME cert resolver for Let's Encrypt staging certificates.
GATEWAY_CERT_RESOLVER=letsencrypt-staging
DASHBOARD_AUTH_MW=athyper-dashboard-auth@file
GATEWAY_ACCESSLOG=true
GATEWAY_LOG_LEVEL=INFO
# GATEWAY_DASHBOARD_HTPASSWD and ACME_EMAIL — injected from secrets/.env

# =============================================
# SERVICE MEMORY LIMITS
# =============================================
GATEWAY_MEMORY_LIMIT=256m
IAM_MEMORY_LIMIT=1g
OBJECTSTORAGE_MEMORY_LIMIT=512m
MEMORYCACHE_MEMORY_LIMIT=256m
MEMORYCACHE_EXPORTER_MEMORY_LIMIT=64m
TELEMETRY_MEMORY_LIMIT=512m
METRICS_MEMORY_LIMIT=512m
ALERTMANAGER_MEMORY_LIMIT=256m
TRACING_MEMORY_LIMIT=512m
LOGGING_MEMORY_LIMIT=512m
LOGSHIPPER_MEMORY_LIMIT=128m
APPS_ATHYPER_MEMORY_LIMIT=512m
DB_MEMORY_LIMIT=1g
DBPOOL_APPS_MEMORY_LIMIT=128m
DBPOOL_SESSION_MEMORY_LIMIT=128m
CLAMAV_MEMORY_LIMIT=768m
# --- Render profile ---
GOTENBERG_MEMORY_LIMIT=1536m
GOTENBERG_CPU_LIMIT=1.0
TIKA_MEMORY_LIMIT=1536m
# --- Monitoring profile ---
UPTIME_MEMORY_LIMIT=256m
HEALTHCHECKS_MEMORY_LIMIT=384m
GLITCHTIP_MEMORY_LIMIT=512m
# --- Admin profile (BullBoard only in staging) ---
BULLBOARD_MEMORY_LIMIT=128m
# pgweb is blocked by validate-env.sh in staging; still needs values so Compose parses cleanly
PGWEB_MEMORY_LIMIT=128m
PGWEB_HOST=pgweb-stg.athyper.com
# --- Search profile ---
MEILI_MEMORY_LIMIT=512m
# --- Analytics profile (DEFERRED — see analytics/README.md) ---
METABASE_MEMORY_LIMIT=1536m
# --- Secrets profile (security-infisical) ---
INFISICAL_MEMORY_LIMIT=512m

# =============================================
# DATABASE (PostgreSQL via PgBouncer)
# =============================================
# PgBouncer config paths (relative to ATHYPER_CONFIG)
DBPOOL_APPS_CONFIG=db/staging/dbpool/apps/pgbouncer-apps.ini
DBPOOL_SESSION_CONFIG=db/staging/dbpool/session/pgbouncer-session.ini
# Upstream Postgres endpoint — substituted into pgbouncer-{apps,auth}.ini
# at container start. Change DB_HOST for blue/green cutover, DNS failover,
# or read-replica promotion without rebuilding the pgbouncer config files.
DB_HOST=athyper-db-1
DB_PORT=5432
DB_ADMIN_USER=postgres
DB_POOL_MAX=20
# DBPOOL_APPS_USER / DBPOOL_APPS_PASSWORD — injected from secrets/.env
# DBPOOL_SESSION_USER / DBPOOL_SESSION_PASSWORD — injected from secrets/.env
# DB_ADMIN_PASSWORD / DATABASE_URL / DATABASE_ADMIN_URL — injected from secrets/.env

# =============================================
# CACHE (Redis)
# =============================================
# Redis client tuning
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_MAX_RETRIES=3
REDIS_ERROR_LOG_COOLDOWN_MS=30000
# REDIS_URL / MEMORYCACHE_PASSWORD / REDIS_*_PASSWORD — injected from secrets/.env
# REDIS_BULLMQ_URL: optional. When unset, BullMQ reuses REDIS_URL.
# Set to a dedicated Redis instance/db (e.g. redis://host:6379/1) to
# isolate job coordination from cache reconnect storms. See rb-09-redis-failover.md.

# =============================================
# OBJECT STORAGE (MinIO S3)
# S3_ACCESS_KEY/S3_SECRET_KEY = MinIO root credentials (MINIO_ROOT_USER).
# Application code uses the scoped APP_S3_* / BACKUP_S3_* credentials,
# provisioned by objectstorage-init on first stack start.
# All S3 credentials and endpoints — injected from secrets/.env
# =============================================
S3_REGION=us-east-1
S3_USE_SSL=false
# CORS allowed origins for object storage presigned-URL uploads
CORS_ALLOWED_ORIGINS=https://neon-stg.athyper.com
# Multipart upload tuning
S3_MULTIPART_PART_SIZE_MB=5
S3_MULTIPART_QUEUE_SIZE=4
S3_MAX_UPLOAD_MB=150
S3_PRESIGNED_TTL_SECONDS=900

# =============================================
# IAM (Keycloak)
# KEYCLOAK_IMAGE_TAG: single source for scripts + compose — bump here when upgrading
# =============================================
KEYCLOAK_IMAGE_TAG=26.6.1
IAM_ADMIN=admin
IAM_DB_URL=jdbc:postgresql://dbpool-session:6433/athyper_iam?preferQueryMode=simple
IAM_DB_USERNAME=postgres
IAM_ISSUER_URL=https://iam-stg.athyper.com/realms/athyper
IAM_CLIENT_ID=athyper-api
IAM_DEFAULT_REALM=athyper
# IAM_ADMIN_PASSWORD / IAM_CLIENT_SECRET / IAM_DB_PASSWORD — injected from secrets/.env
# KEYCLOAK_ADMIN_USERNAME / KEYCLOAK_ADMIN_PASSWORD — injected from secrets/.env

# Platform Control Realm (disabled by default, enable for platform admin features)
PLATFORM_CONTROL_ENABLED=false
PLATFORM_KEYCLOAK_REALM=platform-control
PLATFORM_KEYCLOAK_CLIENT_ID=athyper-admin
PLATFORM_IAM_ISSUER_URL=https://iam-stg.athyper.com/realms/platform-control

# IAM SMTP — Optional. Leave unset to disable email verification / password-reset emails.
# Set before enabling in production.
KC_SMTP_HOST=
KC_SMTP_PORT=587
KC_SMTP_FROM=
KC_SMTP_FROM_DISPLAY_NAME=Athyper
KC_SMTP_AUTH=true
KC_SMTP_USERNAME=
KC_SMTP_PASSWORD=
KC_SMTP_SSL=false
KC_SMTP_STARTTLS=true
KC_WEBAUTHN_RP_ID=athyper.com
ATHYPER_SVC_RUNTIME_WORKER_CLIENT_SECRET=
NEON_SVC_BFF_CLIENT_SECRET=

# Social OAuth — Optional. Set to enable provider login buttons.
# GitHub: Register at https://github.com/settings/developers
# Callback URL: https://iam-stg.athyper.com/realms/athyper/broker/github/endpoint
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Google: Obtain from GCP Console → APIs & Services → OAuth 2.0 Credentials
# Redirect URI: https://iam-stg.athyper.com/realms/athyper/broker/google/endpoint
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# =============================================
# VIRUS SCANNING (ClamAV)
# =============================================
# Enforce fail-closed: unreachable ClamAV blocks uploads (503) rather than
# silently bypassing the scan.
CLAMD_HOST=clamav
CLAMD_PORT=3310
CLAMD_ON_UNAVAILABLE=fail-closed
# Enable freshclam auto-update daemon in staging/production
FRESHCLAM_NO_DAEMON=false

# =============================================
# CREDENTIAL ENCRYPTION
# =============================================
# CREDENTIAL_MASTER_KEY — injected from secrets/.env

# =============================================
# LEGACY PDF RENDERER (superseded by Gotenberg)
# =============================================
# athyper-renderer container retired; PdfRendererClient is kept only as
# a fallback. Leave RENDERER_BASE_URL blank in staging — Gotenberg handles all PDF rendering.
RENDERER_BASE_URL=
# RENDERER_INTERNAL_TOKEN — injected from secrets/.env

# =============================================
# TELEMETRY (OpenTelemetry)
# =============================================
# Inject TELEMETRY_ADMIN_* directly from secret manager; do NOT alias to
# GRAFANA_ADMIN_* — that rename silently resolves to empty mid-incident.
# OTLP_ENDPOINT / TELEMETRY_ADMIN_USER / TELEMETRY_ADMIN_PASSWORD — injected from secrets/.env

# --- Alertmanager contact routing ---
# Required in staging. Inject real SMTP relay + recipient groups from
# secrets/.env; validate-env blocks blank values outside local.
ALERTMANAGER_SMTP_SMARTHOST=
ALERTMANAGER_SMTP_FROM=
ALERTMANAGER_SMTP_REQUIRE_TLS=true
ALERTMANAGER_SMTP_AUTH_USERNAME=
ALERTMANAGER_SMTP_AUTH_PASSWORD=
ALERTMANAGER_PLATFORM_EMAIL=
ALERTMANAGER_CRITICAL_EMAIL=
ALERTMANAGER_FINANCE_EMAIL=
ALERTMANAGER_COMPLIANCE_EMAIL=
ALERTMANAGER_SECURITY_EMAIL=

# --- Tempo storage backend ---
TEMPO_STORAGE_BACKEND=s3
TEMPO_S3_BUCKET=athyper-tempo-traces-staging
TEMPO_S3_ENDPOINT=objectstorage:9000
TEMPO_S3_INSECURE=true
# TEMPO_S3_ACCESS_KEY / TEMPO_S3_SECRET_KEY — injected from secrets/.env

# --- Loki storage backend ---
LOKI_STORAGE_BACKEND=s3
LOKI_S3_BUCKET=athyper-loki-logs-staging
LOKI_S3_ENDPOINT=objectstorage:9000
LOKI_S3_INSECURE=true
# LOKI_S3_ACCESS_KEY / LOKI_S3_SECRET_KEY — injected from secrets/.env

# --- Distributed tracing — OpenTelemetry → Tempo ---
# Head-based sampling: 0.1 = 10% in staging (reduces ingest without losing
# representative traces). Raise temporarily for incident investigation.
OTEL_EXPORTER_OTLP_ENDPOINT=http://tracing:4317
OTEL_SERVICE_NAME=athyper-runtime
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# =============================================
# RENDER PROFILE (Gotenberg + Tika)
# =============================================
GOTENBERG_REPLICAS=2
GOTENBERG_API_TIMEOUT=180s
GOTENBERG_LIBREOFFICE_RESTART_AFTER=100
GOTENBERG_CHROMIUM_ALLOW_LIST=file:///tmp.*
GOTENBERG_BASE_URL=http://gotenberg:3000
TIKA_URL=http://tika:9998

# =============================================
# MONITORING PROFILE (Uptime Kuma + Healthchecks + GlitchTip)
# =============================================
HEALTHCHECKS_BASE_URL=http://healthchecks:8000/ping
HEALTHCHECKS_EMAIL_USE_TLS=True
# HEALTHCHECKS_SECRET_KEY / GLITCHTIP_SECRET_KEY — injected from secrets/.env
# DSN vars below — Optional. Provision from GlitchTip UI after first boot.
GLITCHTIP_DSN=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_ENVIRONMENT=staging
NEXT_PUBLIC_SERVICE_VERSION=1.0.0
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
# Source-map upload — Optional. Set in CI job environment when SENTRY_DSN is provisioned.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_URL=
SENTRY_AUTH_TOKEN=

# =============================================
# SEARCH PROFILE (Meilisearch)
# =============================================
MEILI_ENV=production
MEILI_LOG_LEVEL=INFO
MEILI_MAX_INDEXING_MEMORY=256MiB
# MEILI_MASTER_KEY — injected from secrets/.env

# =============================================
# ANALYTICS PROFILE (Metabase) — DEFERRED
# =============================================
MB_DB_TYPE=h2
MB_DB_CONNECTION_URI=
MB_JAVA_OPTS=-Xmx1g -XX:+UseG1GC
METABASE_GOVERNANCE_APPROVED=false

# =============================================
# SECRETS PROFILE (Infisical)
# =============================================
# INFISICAL_ENCRYPTION_KEY / INFISICAL_AUTH_SECRET — injected from secrets/.env
