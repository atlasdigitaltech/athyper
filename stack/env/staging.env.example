# =============================================
# athyper Stack — Staging Environment
# =============================================
# Deploy on Ubuntu. All secrets injected via CI/CD secrets manager.
# Copy to staging.env and fill in ${VAR} references before deploying.
#
# Environment-specific files:
#   .env.example              ← Local dev
#   staging.env.example       ← Staging (this file)
#   production.env.example    ← Production

# =============================================
# ENVIRONMENT IDENTITY
# =============================================
ENVIRONMENT=staging
COMPOSE_PROJECT_NAME=athyper-stack-staging

# =============================================
# RUNTIME CONFIGURATION
# =============================================
MODE=api
MULTITENANT=TRUE
SERVICE_NAME=athyper-runtime
SERVICE_VERSION=${RELEASE_VERSION}
WEB_PORT=3000
API_PORT=3000
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=30000
NODE_ENV=production
NODE_TLS_REJECT_UNAUTHORIZED=1

# =============================================
# PUBLIC URLs
# =============================================
PUBLIC_BASE_URL=https://api-stg.athyper.com
PUBLIC_WEB_URL=https://neon-stg.athyper.com

# =============================================
# BASE PATHS
# =============================================
ATHYPER_DATA=/var/lib/athyper/stack/data
ATHYPER_CONFIG=/etc/athyper/stack/config
ATHYPER_KERNEL_CONFIG_PATH=apps/kernel.config.staging.parameter.json
AUTH_DEBUG_EXPOSE_TOKENS=false

# =============================================
# HOSTNAMES
# =============================================
# Gateway & Infrastructure
GATEWAY_HOST=gateway-stg.athyper.com
IAM_HOST=iam-stg.athyper.com
OBJECTSTORAGE_HOST=objectstorage-stg.athyper.com
OBJECTSTORAGE_CONSOLE_HOST=objectstorage.console-stg.athyper.com

# Observability
TELEMETRY_HOST=telemetry-stg.athyper.com
METRICS_HOST=metrics-stg.athyper.com
TRACES_HOST=traces-stg.athyper.com
LOGS_HOST=logs-stg.athyper.com

# Monitoring (monitoring profile)
UPTIME_HOST=uptime-stg.athyper.com
HEALTHCHECKS_HOST=healthchecks-stg.athyper.com
GLITCHTIP_HOST=errors-stg.athyper.com

# Admin: BullBoard is embedded in the API runtime at /api/jobs/admin/board,
# gated by JOBS.BOARD.VIEW / JOBS.QUEUE.MANAGE. The sidecar container
# (compose profile `emergency`) is internal-only — no public hostname.
# pgweb is blocked by validate-env.sh.

# Search (search profile)
MEILI_HOST=meilisearch-stg.athyper.com

# Analytics (analytics profile — DEFERRED, do NOT enable without
# read replica + governance sign-off; see analytics/README.md)
METABASE_HOST=metabase-stg.athyper.com

# Secrets (security-infisical profile)
INFISICAL_HOST=infisical-stg.athyper.com

# Applications
APPS_ATHYPER_WEB_HOST=neon-stg.athyper.com
APPS_ATHYPER_API_HOST=api-stg.athyper.com
# Traefik upstream for the Neon web app — in-network Docker service name.
APPS_ATHYPER_WEB_UPSTREAM_URL=http://athyper-neon-web:3000
# Traefik upstream for the API — must be a valid URL even though the Docker-label
# router (priority ~30) always wins over the static file-provider router (priority 1).
# An empty value causes Traefik to emit a backend-parse warning at startup.
APPS_ATHYPER_API_UPSTREAM_URL=http://athyper-api:3000

# F8 Phase 1 — single-ingress host guard (apps/web/middleware.ts).
# Active from F8 Phase 3 (2026-04-18): the athyper-neon-web container reads
# ALLOWED_HOSTS and rejects any request whose Host header is not listed.
# GATEWAY_ORIGIN is the redirect target for browser page requests that arrive
# with a direct-access Host header.
ALLOWED_HOSTS=neon-stg.athyper.com
GATEWAY_ORIGIN=https://neon-stg.athyper.com

# ── Neon Web — container-specific env (F8 Phase 3, apps profile) ───────────
# The web BFF uses a dedicated KC client distinct from the API's client_id.
# Keep it aligned with the redirect-URI entry registered in Keycloak for
# the neon-stg.athyper.com host.
KEYCLOAK_CLIENT_ID=neon-web
# KC admin API credentials — used for server-side org-attribute enrichment.
# PROVISION THESE FROM A SECRET MANAGER (see docs/secrets-management.md);
# the placeholders below must never ship as real values.
KEYCLOAK_ADMIN_USERNAME=${KEYCLOAK_ADMIN_USERNAME}
KEYCLOAK_ADMIN_PASSWORD=${KEYCLOAK_ADMIN_PASSWORD}
# Feature flags baked into the browser bundle at build time.
NEXT_PUBLIC_GITHUB_LOGIN_ENABLED=false
NEXT_PUBLIC_PLATFORM_CONTROL_ENABLED=false
# Social login → tenant mapping (used when KC org claim is absent).
GITHUB_TENANT_ID=

# =============================================
# GATEWAY (Traefik)
# =============================================
GATEWAY_TLS_OPTIONS=athyper-tls-default@file
DASHBOARD_AUTH_MW=athyper-dashboard-auth@file
GATEWAY_ACCESSLOG=true
GATEWAY_LOG_LEVEL=INFO
# Dashboard basic-auth htpasswd (user:bcrypt_hash).
# MUST be unique per environment — NEVER reuse the local dev hash.
# Generate: htpasswd -nbB admin <password> | sed 's/\$/\$\$/g'
# Escape $ as $$ for Docker Compose YAML interpolation.
GATEWAY_DASHBOARD_HTPASSWD=${GATEWAY_DASHBOARD_HTPASSWD}

# =============================================
# SERVICE MEMORY LIMITS
# =============================================
GATEWAY_MEMORY_LIMIT=256m
IAM_MEMORY_LIMIT=1g
OBJECTSTORAGE_MEMORY_LIMIT=512m
MEMORYCACHE_MEMORY_LIMIT=256m
MEMORYCACHE_EXPORTER_MEMORY_LIMIT=64m
TELEMETRY_MEMORY_LIMIT=512m
METRICS_MEMORY_LIMIT=512m
TRACING_MEMORY_LIMIT=512m
LOGGING_MEMORY_LIMIT=512m
LOGSHIPPER_MEMORY_LIMIT=128m
APPS_ATHYPER_MEMORY_LIMIT=512m
DB_MEMORY_LIMIT=1g
DBPOOL_APPS_MEMORY_LIMIT=128m
DBPOOL_SESSION_MEMORY_LIMIT=128m
CLAMAV_MEMORY_LIMIT=768m
# --- Render profile ---
GOTENBERG_MEMORY_LIMIT=1536m
TIKA_MEMORY_LIMIT=1536m
# --- Monitoring profile ---
UPTIME_MEMORY_LIMIT=256m
HEALTHCHECKS_MEMORY_LIMIT=384m
GLITCHTIP_MEMORY_LIMIT=512m
# --- Admin profile (BullBoard only in staging) ---
BULLBOARD_MEMORY_LIMIT=128m
# --- Search profile ---
MEILI_MEMORY_LIMIT=512m
# --- Analytics profile (DEFERRED — see analytics/README.md) ---
METABASE_MEMORY_LIMIT=1536m
# --- Secrets profile (security-infisical) ---
INFISICAL_MEMORY_LIMIT=512m

# =============================================
# DATABASE (PostgreSQL via PgBouncer)
# =============================================
# PgBouncer config paths (relative to ATHYPER_CONFIG)
DBPOOL_APPS_CONFIG=db/staging/dbpool/apps/pgbouncer-apps.ini
DBPOOL_SESSION_CONFIG=db/staging/dbpool/session/pgbouncer-session.ini
# Upstream Postgres endpoint — substituted into pgbouncer-{apps,auth}.ini
# at container start. Change DB_HOST for blue/green cutover, DNS failover,
# or read-replica promotion without rebuilding the pgbouncer config files.
DB_HOST=db-stg.athyper.com
DB_PORT=5432
# DB_ADMIN_PASSWORD is used by the db container (POSTGRES_PASSWORD).
# If you run a self-hosted PostgreSQL container, this MUST be set.
# If using a managed database (RDS, Cloud SQL), leave unset and omit the db profile.
DB_ADMIN_PASSWORD=${DB_ADMIN_PASSWORD}
DATABASE_URL=${DATABASE_URL}
DATABASE_ADMIN_URL=${DATABASE_ADMIN_URL}
DB_POOL_MAX=20
# PgBouncer auth — userlist generated at container start from these env vars
DBPOOL_APPS_USER=athyper_user
DBPOOL_APPS_PASSWORD=${DBPOOL_APPS_PASSWORD}
DBPOOL_SESSION_USER=pgbouncer_auth_user
DBPOOL_SESSION_PASSWORD=${DBPOOL_SESSION_PASSWORD}

# =============================================
# CACHE (Redis)
# =============================================
REDIS_URL=${REDIS_URL}
MEMORYCACHE_PASSWORD=${MEMORYCACHE_PASSWORD}
# Per-service Redis passwords (ACL hashes computed at container start)
# Generate strong passwords: openssl rand -base64 24
REDIS_EXPORTER_PASSWORD=${REDIS_EXPORTER_PASSWORD}
REDIS_GLITCHTIP_PASSWORD=${REDIS_GLITCHTIP_PASSWORD}
REDIS_INFISICAL_PASSWORD=${REDIS_INFISICAL_PASSWORD}
# Breakglass only — no service connects as this user
REDIS_ADMIN_PASSWORD=${REDIS_ADMIN_PASSWORD}
# Redis client tuning
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_MAX_RETRIES=3
REDIS_ERROR_LOG_COOLDOWN_MS=30000
# Optional: dedicated Redis for BullMQ (queues/workers/schedulers).
# When unset, BullMQ reuses REDIS_URL. Point at a separate instance (or
# db index, e.g. redis://host:6379/1) so a READONLY error or reconnect
# storm on the cache client cannot cascade to job coordination. Operated
# alongside the opt-in `memorycache-jobs` compose profile — see
# rb-09-redis-failover.md for the client ownership matrix.
REDIS_BULLMQ_URL=${REDIS_BULLMQ_URL}

# =============================================
# OBJECT STORAGE (MinIO S3)
# S3_ACCESS_KEY/S3_SECRET_KEY = MinIO root credentials (MINIO_ROOT_USER).
# Application code uses the scoped APP_S3_* / BACKUP_S3_* credentials below,
# provisioned by objectstorage-init on first stack start.
# Generate: openssl rand -hex 12   (access key, min 3 chars)
#           openssl rand -base64 32 (secret key, min 8 chars)
# =============================================
S3_ENDPOINT=${S3_ENDPOINT}
S3_ACCESS_KEY=${S3_ACCESS_KEY}
S3_SECRET_KEY=${S3_SECRET_KEY}
S3_REGION=${S3_REGION}
# Staging value: athyper-staging
S3_BUCKET=${S3_BUCKET}
S3_USE_SSL=true
# CORS allowed origins for object storage presigned-URL uploads
CORS_ALLOWED_ORIGINS=https://neon-stg.athyper.com
# Multipart upload tuning
S3_MULTIPART_PART_SIZE_MB=5
S3_MULTIPART_QUEUE_SIZE=4
S3_MAX_UPLOAD_MB=150
S3_PRESIGNED_TTL_SECONDS=900

# Scoped service account — athyper-app (readwrite on S3_BUCKET).
# objectstorage-init creates this MinIO user with athyper-app-policy.
APP_S3_ACCESS_KEY=${APP_S3_ACCESS_KEY}
APP_S3_SECRET_KEY=${APP_S3_SECRET_KEY}

# Scoped service account — athyper-backup (readwrite on BACKUP_S3_BUCKET).
# objectstorage-init creates this MinIO user with athyper-backup-policy.
BACKUP_S3_BUCKET=${BACKUP_S3_BUCKET}
BACKUP_S3_ACCESS_KEY=${BACKUP_S3_ACCESS_KEY}
BACKUP_S3_SECRET_KEY=${BACKUP_S3_SECRET_KEY}

# =============================================
# IAM (Keycloak)
# KEYCLOAK_IMAGE_TAG: single source for scripts + compose — bump here when upgrading
# =============================================
KEYCLOAK_IMAGE_TAG=26.6.1
IAM_ADMIN=${IAM_ADMIN}
IAM_ADMIN_PASSWORD=${IAM_ADMIN_PASSWORD}
IAM_DB_URL=jdbc:postgresql://dbpool-session:6433/athyper_iam?preferQueryMode=simple
IAM_DB_USERNAME=${IAM_DB_USERNAME}
IAM_DB_PASSWORD=${IAM_DB_PASSWORD}
# Staging value: https://iam-stg.athyper.com/realms/athyper
IAM_ISSUER_URL=${IAM_ISSUER_URL}
# Staging value: athyper-api
IAM_CLIENT_ID=${IAM_CLIENT_ID}
IAM_CLIENT_SECRET=${IAM_CLIENT_SECRET}
IAM_DEFAULT_REALM=athyper

# Platform Control Realm (disabled by default, enable for platform admin features)
PLATFORM_CONTROL_ENABLED=false
PLATFORM_KEYCLOAK_REALM=platform-control
PLATFORM_KEYCLOAK_CLIENT_ID=athyper-admin
# Staging value: https://iam-stg.athyper.com/realms/platform-control
PLATFORM_IAM_ISSUER_URL=${PLATFORM_IAM_ISSUER_URL}

# IAM SMTP
KC_SMTP_HOST=${KC_SMTP_HOST}
# Staging value: 587
KC_SMTP_PORT=${KC_SMTP_PORT}
# Staging value: noreply@athyper.com
KC_SMTP_FROM=${KC_SMTP_FROM}
KC_SMTP_FROM_DISPLAY_NAME=Athyper
KC_SMTP_AUTH=true
KC_SMTP_USERNAME=${KC_SMTP_USERNAME}
KC_SMTP_PASSWORD=${KC_SMTP_PASSWORD}
KC_SMTP_SSL=false
KC_SMTP_STARTTLS=true

# Social OAuth — set to enable provider login buttons
# GitHub: Register at https://github.com/settings/developers
# Callback URL: https://iam-stg.athyper.com/realms/athyper/broker/github/endpoint
GITHUB_OAUTH_CLIENT_ID=${GITHUB_OAUTH_CLIENT_ID}
GITHUB_OAUTH_CLIENT_SECRET=${GITHUB_OAUTH_CLIENT_SECRET}
# Google: Obtain from GCP Console → APIs & Services → OAuth 2.0 Credentials
# Redirect URI: https://iam-stg.athyper.com/realms/athyper/broker/google/endpoint
GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET}

# =============================================
# IAM SECRETS (SUPERSTAR env vars)
# =============================================
# These are resolved by kernel config loader
ATHYPER_SUPER__IAM_SECRET__IAM_ATHYPER_CLIENT_SECRET=${IAM_CLIENT_SECRET}

# =============================================
# VIRUS SCANNING (ClamAV)
# =============================================
# F2: Enforce fail-closed in non-local environments.
# Unreachable ClamAV blocks uploads (503) rather than silently bypassing scanning.
CLAMD_HOST=clamav
CLAMD_PORT=3310
CLAMD_ON_UNAVAILABLE=fail-closed
# Enable freshclam auto-update daemon in staging/production
FRESHCLAM_NO_DAEMON=false

# =============================================
# CREDENTIAL ENCRYPTION
# =============================================
# F3: Required in staging/production — server will refuse to start without it.
# Must be ≥32 characters. Generate with: openssl rand -base64 48
CREDENTIAL_MASTER_KEY=${CREDENTIAL_MASTER_KEY}

# =============================================
# LEGACY PDF RENDERER (superseded by Gotenberg)
# =============================================
# athyper-renderer container retired; PdfRendererClient is kept only as
# a fallback. Leave RENDERER_BASE_URL blank in staging — Gotenberg below
# handles all PDF rendering.
RENDERER_INTERNAL_TOKEN=${RENDERER_INTERNAL_TOKEN}
RENDERER_BASE_URL=

# =============================================
# TELEMETRY (OpenTelemetry)
# =============================================
# Staging value: http://logshipper:4318 (if using in-stack collector)
# Canonical names (no vendor aliases): inject TELEMETRY_ADMIN_* directly
# from the secret manager. Do NOT alias to GRAFANA_ADMIN_* — the rename
# layer silently resolves to empty and locks ops out of Grafana mid-incident.
OTLP_ENDPOINT=${OTLP_ENDPOINT}
TELEMETRY_ADMIN_USER=${TELEMETRY_ADMIN_USER}
TELEMETRY_ADMIN_PASSWORD=${TELEMETRY_ADMIN_PASSWORD}

# --- Tempo storage backend (P2.10) ---
# Staging uses the stack MinIO for durable trace storage. Bucket is
# provisioned at start by the tracing-bucket-init sidecar (idempotent).
# Retention is driven by Tempo's compactor (336h = 14d) — MinIO lifecycle
# is left as defense-in-depth; configure via `mc ilm rule add` out of band
# if required by compliance.
# TEMPO_S3_ACCESS_KEY/TEMPO_S3_SECRET_KEY: prefer a dedicated MinIO user
# with put/get/delete/list on the bucket; fall back to root creds
# (${S3_ACCESS_KEY}/${S3_SECRET_KEY}) if the tempo-specific user is not
# yet provisioned.
TEMPO_STORAGE_BACKEND=s3
TEMPO_S3_BUCKET=athyper-tempo-traces-staging
TEMPO_S3_ENDPOINT=objectstorage:9000
TEMPO_S3_ACCESS_KEY=${TEMPO_S3_ACCESS_KEY}
TEMPO_S3_SECRET_KEY=${TEMPO_S3_SECRET_KEY}
TEMPO_S3_INSECURE=true

# --- Loki storage backend ---
# Mirrors Tempo pattern: filesystem for local dev, s3 for staging/production.
# Bucket is provisioned at start by the logging-bucket-init sidecar (idempotent).
# LOKI_S3_ACCESS_KEY/LOKI_S3_SECRET_KEY: prefer a dedicated MinIO user
# with put/get/delete/list on the bucket; fall back to root creds if not provisioned.
LOKI_STORAGE_BACKEND=s3
LOKI_S3_BUCKET=athyper-loki-logs-staging
LOKI_S3_ENDPOINT=objectstorage:9000
LOKI_S3_ACCESS_KEY=${LOKI_S3_ACCESS_KEY}
LOKI_S3_SECRET_KEY=${LOKI_S3_SECRET_KEY}
LOKI_S3_INSECURE=true

# --- Distributed tracing — OpenTelemetry → Tempo ---
# Head-based sampling: 0.1 = 10% in staging (reduces ingest without losing
# representative traces). Raise temporarily for incident investigation.
OTEL_EXPORTER_OTLP_ENDPOINT=http://tracing:4317
OTEL_SERVICE_NAME=athyper-runtime
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# =============================================
# RENDER PROFILE (Gotenberg + Tika)
# =============================================
# Internal only. Gotenberg replica count drives LibreOffice throughput.
#
# Canonical tuning + error-category contract:
#   stack/config/render/environments/gotenberg.staging.conf
#   stack/config/render/environments/tika-config.staging.xml
#   stack/config/render/README.md
#
# Keep values below in sync with the .conf file (source of truth).
GOTENBERG_REPLICAS=2
GOTENBERG_API_TIMEOUT=180s
GOTENBERG_LIBREOFFICE_RESTART_AFTER=100
GOTENBERG_CHROMIUM_ALLOW_LIST=file:///tmp.*
# App-side consumer URLs (internal Docker DNS).
GOTENBERG_BASE_URL=http://gotenberg:3000
TIKA_URL=http://tika:9998

# =============================================
# MONITORING PROFILE (Uptime Kuma + Healthchecks + GlitchTip)
# =============================================
# Both Django apps reuse the stack Postgres; rotate secrets per environment.
HEALTHCHECKS_SECRET_KEY=${HEALTHCHECKS_SECRET_KEY}
GLITCHTIP_SECRET_KEY=${GLITCHTIP_SECRET_KEY}
# App-side consumer URLs.
HEALTHCHECKS_BASE_URL=http://healthchecks:8000/ping
HEALTHCHECKS_EMAIL_USE_TLS=True
# DSN injected from secret store (project-scoped, generated in GlitchTip
# UI). Leave the SDK as a no-op until a real DSN is provisioned.
GLITCHTIP_DSN=${GLITCHTIP_DSN}
SENTRY_TRACES_SAMPLE_RATE=0.05
# Web frontend (@sentry/nextjs). DSN baked into browser bundle at build time.
NEXT_PUBLIC_SENTRY_DSN=${NEXT_PUBLIC_SENTRY_DSN}
NEXT_PUBLIC_ENVIRONMENT=staging
NEXT_PUBLIC_SERVICE_VERSION=${SERVICE_VERSION}
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
# Source-map upload happens during `next build` in the CI image-build job.
# These vars must be present in that job's environment (from Vault / AWS SM).
SENTRY_ORG=${SENTRY_ORG}
SENTRY_PROJECT=${SENTRY_PROJECT}
SENTRY_URL=${SENTRY_URL}
SENTRY_AUTH_TOKEN=${SENTRY_AUTH_TOKEN}

# =============================================
# SEARCH PROFILE (Meilisearch)
# =============================================
# Track B2.1 — infra only. Indexing worker + search API land in B2.2.
MEILI_MASTER_KEY=${MEILI_MASTER_KEY}
MEILI_ENV=production
MEILI_LOG_LEVEL=INFO
MEILI_MAX_INDEXING_MEMORY=256MiB

# =============================================
# ANALYTICS PROFILE (Metabase) — DEFERRED
# =============================================
# Track B4 — pre-staged. Read stack/compose/analytics/README.md before
# enabling. The stack will REFUSE to start with the analytics profile
# unless METABASE_GOVERNANCE_APPROVED=approved is set explicitly here
# (validate-env.sh enforces). That flag is the contract that the four
# governance bullets in the README have been answered.
#
# When approved: switch MB_DB_TYPE to postgres and provide
# MB_DB_CONNECTION_URI pointing at a dedicated app DB (athyper_metabase).
# H2 is unsuitable for staging — see the README's "Upgrading from H2".
MB_DB_TYPE=h2
MB_DB_CONNECTION_URI=
MB_JAVA_OPTS=-Xmx1g -XX:+UseG1GC
METABASE_GOVERNANCE_APPROVED=false

# =============================================
# SECRETS PROFILE (Infisical — Track B3.1)
# =============================================
# Infra-only in B3.1. Admin provisions secrets via UI after first-boot.
# Integration with config.ts (B3.2) and tenant-scoped secret migration
# (B3.3) are separate tracks.
# ENCRYPTION_KEY: 32 hex chars. Generate: openssl rand -hex 16
INFISICAL_ENCRYPTION_KEY=${INFISICAL_ENCRYPTION_KEY}
# AUTH_SECRET: any string ≥32 chars. Generate: openssl rand -base64 32
INFISICAL_AUTH_SECRET=${INFISICAL_AUTH_SECRET}
