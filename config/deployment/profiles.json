{
  "$schema": "./profiles.schema.json",
  "version": 1,
  "profiles": {
    "athyper-neon": {
      "entryApplication": "@athyper/neon",
      "requiredProductPackages": ["@athyper/neon-runtime"],
      "requiredSharedPackages": [
        "@athyper/api-client", "@athyper/api-contracts", "@athyper/auth-bff", "@athyper/auth-common",
        "@athyper/bff-relay", "@athyper/brand", "@athyper/cascade", "@athyper/collaboration-ui",
        "@athyper/content-ui", "@athyper/entity-print", "@athyper/finance-workbench", "@athyper/icons",
        "@athyper/identity-gate", "@athyper/metadata-client", "@athyper/me-ui", "@athyper/query",
        "@athyper/runtime-add-item", "@athyper/runtime-canvas", "@athyper/runtime-contracts",
        "@athyper/runtime-line-item", "@athyper/runtime-list", "@athyper/runtime-shared",
        "@athyper/session-plane", "@athyper/session-store", "@athyper/shell", "@athyper/surface-kit",
        "@athyper/temporal", "@athyper/theme", "@athyper/ui"
      ],
      "requiredServerServices": ["@athyper/runtime-server"],
      "environmentVariables": ["NODE_ENV", "PORT", "DATABASE_URL", "REDIS_URL", "AUTH_ISSUER_URL", "AUTH_CLIENT_ID", "AUTH_CLIENT_SECRET"],
      "buildCommand": "pnpm --filter @athyper/neon... build",
      "runtimeCommand": "pnpm --filter @athyper/neon start",
      "healthChecks": [{"path": "/", "expectedStatus": 200}, {"path": "/readyz", "expectedStatus": 200, "target": "athyper-server"}]
    },
    "athyper-admin": {
      "entryApplication": "@athyper/admin",
      "requiredProductPackages": ["@athyper/admin-studio"],
      "requiredSharedPackages": [
        "@athyper/api-contracts", "@athyper/auth-bff", "@athyper/auth-common", "@athyper/bff-relay",
        "@athyper/brand", "@athyper/cascade", "@athyper/collaboration-ui", "@athyper/finance-rules",
        "@athyper/i18n", "@athyper/icons", "@athyper/identity-gate", "@athyper/me-ui", "@athyper/query",
        "@athyper/route-manifest-core", "@athyper/runtime-contracts", "@athyper/runtime-list",
        "@athyper/runtime-shared", "@athyper/session-plane", "@athyper/session-store", "@athyper/shell",
        "@athyper/shell-runtime", "@athyper/surface-kit", "@athyper/temporal", "@athyper/theme", "@athyper/ui"
      ],
      "requiredServerServices": ["@athyper/runtime-server"],
      "environmentVariables": ["NODE_ENV", "PORT", "DATABASE_URL", "REDIS_URL", "AUTH_ISSUER_URL", "AUTH_CLIENT_ID", "AUTH_CLIENT_SECRET"],
      "buildCommand": "pnpm --filter @athyper/admin... build",
      "runtimeCommand": "pnpm --filter @athyper/admin start",
      "healthChecks": [{"path": "/", "expectedStatus": 200}, {"path": "/readyz", "expectedStatus": 200, "target": "athyper-server"}]
    },
    "athyper-mesh": {
      "entryApplication": "@athyper/mesh",
      "requiredProductPackages": ["@athyper/mesh-runtime"],
      "requiredSharedPackages": [
        "@athyper/adapter-db", "@athyper/auth-bff", "@athyper/bff-relay", "@athyper/brand", "@athyper/i18n",
        "@athyper/identity-gate", "@athyper/me-ui", "@athyper/mesh-exchange-contracts", "@athyper/query",
        "@athyper/runtime-shared", "@athyper/session-plane", "@athyper/shell", "@athyper/surface-kit",
        "@athyper/theme", "@athyper/ui"
      ],
      "requiredServerServices": ["@athyper/runtime-server"],
      "environmentVariables": ["NODE_ENV", "PORT", "DATABASE_URL", "REDIS_URL", "AUTH_ISSUER_URL", "AUTH_CLIENT_ID", "AUTH_CLIENT_SECRET"],
      "buildCommand": "pnpm --filter @athyper/mesh... build",
      "runtimeCommand": "pnpm --filter @athyper/mesh start",
      "healthChecks": [{"path": "/", "expectedStatus": 200}, {"path": "/readyz", "expectedStatus": 200, "target": "athyper-server"}]
    },
    "athyper-server": {
      "entryApplication": "@athyper/runtime-server",
      "requiredProductPackages": [],
      "requiredSharedPackages": ["@athyper/auth-common", "@athyper/runtime-contracts"],
      "requiredServerServices": [
        "@athyper/svc-ai", "@athyper/svc-audit", "@athyper/svc-business", "@athyper/svc-collab",
        "@athyper/svc-content", "@athyper/svc-doc-services", "@athyper/svc-documents", "@athyper/svc-finance",
        "@athyper/svc-iam", "@athyper/svc-integration", "@athyper/svc-jobs", "@athyper/svc-master",
        "@athyper/svc-metadata", "@athyper/svc-platform", "@athyper/svc-policy", "@athyper/svc-records",
        "@athyper/svc-search", "@athyper/svc-shared", "@athyper/svc-workflow"
      ],
      "environmentVariables": ["NODE_ENV", "PORT", "DATABASE_URL", "REDIS_URL", "AUTH_ISSUER_URL", "AUTH_CLIENT_ID", "AUTH_CLIENT_SECRET", "S3_ENDPOINT", "S3_BUCKET"],
      "buildCommand": "pnpm --filter @athyper/runtime-server... build",
      "runtimeCommand": "pnpm --filter @athyper/runtime-server start:api",
      "healthChecks": [{"path": "/livez", "expectedStatus": 200}, {"path": "/readyz", "expectedStatus": 200}]
    }
  }
}
