{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athyper.local/schemas/authorization-external-identity-evidence-v1.json",
  "title": "Authorization Wave 0 external identity authority evidence",
  "description": "Restricted, PII-free evidence containing only enabled external subjects and their expected authorization planes.",
  "type": "object",
  "required": [
    "schemaVersion",
    "evidenceId",
    "generatedAt",
    "source",
    "subjects",
    "hashes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{2,127}$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "required": [
        "authoritySystem",
        "sourceInstanceIdSha256",
        "snapshotId",
        "snapshotSha256",
        "subjectSelection"
      ],
      "properties": {
        "authoritySystem": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{1,63}$"
        },
        "sourceInstanceIdSha256": {
          "$ref": "#/$defs/sha256"
        },
        "snapshotId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "snapshotSha256": {
          "$ref": "#/$defs/sha256"
        },
        "subjectSelection": {
          "const": "enabled_only"
        }
      },
      "additionalProperties": false
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "subjectKeySha256",
          "realmKey",
          "providerCode",
          "subjectSha256",
          "subjectType",
          "enabled",
          "expectedPlanes"
        ],
        "properties": {
          "subjectKeySha256": {
            "$ref": "#/$defs/sha256"
          },
          "realmKey": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{1,62}$"
          },
          "providerCode": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{1,62}$"
          },
          "subjectSha256": {
            "$ref": "#/$defs/sha256"
          },
          "subjectType": {
            "enum": [
              "user",
              "service_account",
              "integration_user"
            ]
          },
          "enabled": {
            "const": true
          },
          "expectedPlanes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "neon",
                "admin",
                "mesh"
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "hashes": {
      "type": "object",
      "required": [
        "subjectsSha256"
      ],
      "properties": {
        "subjectsSha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
