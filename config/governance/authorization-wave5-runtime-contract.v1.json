{
  "contractVersion": "wave5.canonical-runtime.v1",
  "evaluatorContractVersion": "wave4.canonical-evaluator.v1",
  "sessionContractVersion": "wave5.authorization-session.v2",
  "planes": {
    "neon": {
      "authorityDatabase": "neon",
      "repository": "master/control",
      "fallbackAllowed": false
    },
    "studio": {
      "authorityDatabase": "neon",
      "repository": "master/control",
      "semantics": "platform_managed",
      "fallbackAllowed": false
    },
    "mesh": {
      "authorityDatabase": "mesh",
      "repository": "mesh/mesh_control",
      "independentSession": true,
      "neonAvailabilityRequired": false,
      "fallbackAllowed": false
    }
  },
  "decisionApis": [
    "single",
    "batch",
    "collection_materialization"
  ],
  "collectionConsumers": [
    "list",
    "count",
    "export",
    "batch",
    "session"
  ],
  "resourceConsumers": [
    "detail",
    "read",
    "download",
    "share",
    "update",
    "delete",
    "workflow",
    "document",
    "metadata",
    "studio",
    "mesh",
    "ai"
  ],
  "consumerFamilies": [
    "metadata",
    "records",
    "workflow",
    "documents",
    "studio",
    "mesh",
    "session",
    "ai"
  ],
  "rules": {
    "exactCatalogIdsOnly": true,
    "permissionTextInferenceAllowed": false,
    "aclRecordOnly": true,
    "aclAdvertisedAsGlobalCapability": false,
    "delegationRequiresOrdinaryProvenanceAndScopeSubset": true,
    "durableDecisionEvidenceRequired": true,
    "outboxInvalidationRequired": true,
    "missingPlaneDatabaseOrReleaseFailsClosed": true,
    "sessionAndDecisionCatalogVersionMustMatch": true
  },
  "publication": {
    "initialState": "shadow",
    "productionState": "active",
    "activationRequires": [
      "nonzero_catalog_sha256",
      "exact_evaluator_revision",
      "all_consumer_families_verified",
      "acl_negative_tests",
      "delegation_provenance_subset_tests",
      "mesh_neon_unavailable_test",
      "rollback_owner_and_observation_window"
    ]
  }
}
