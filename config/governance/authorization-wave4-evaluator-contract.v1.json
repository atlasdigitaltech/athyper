{
  "schemaVersion": 1,
  "contractId": "authorization-v2-wave4-evaluator-entitlement-exceptions",
  "status": "additive-build-static-certified-live-pending",
  "dependsOn": [
    "authorization-v2-wave1-additive",
    "authorization-v2-wave2-canonical-catalog",
    "authorization-v2-wave3-authority"
  ],
  "semanticContract": "server/db/evaluator/authorization-evaluator-semantic-contract.v1.json",
  "implementation": {
    "core": "server/packages/services/iam/authorization-evaluator",
    "repositoryAgnostic": true,
    "singleBatch": "single_is_one_item_batch",
    "decisionModes": [
      "entity_resource",
      "registered_capability",
      "collection"
    ],
    "consumerStatus": "shadow_until_wave5"
  },
  "repositories": {
    "neonAdmin": {
      "contract": "server/db/evaluator/neon-admin/repository-contract.v1.json",
      "database": "neon",
      "planes": ["neon", "admin"],
      "legacyFallbackAllowed": false
    },
    "mesh": {
      "contract": "server/db/evaluator/mesh/repository-contract.v1.json",
      "database": "mesh",
      "planes": ["mesh"],
      "neonReadAllowed": false,
      "neonConnectionFallbackAllowed": false
    }
  },
  "entitlement": {
    "precedence": "before_hard_policy_deny_role_acl_delegation_override",
    "neon": "plan_module_feature_plus_tenant_activation",
    "admin": "explicit_active_platform_managed_policy",
    "mesh": "local_account_product_capability",
    "missingOrUnavailable": "deny"
  },
  "exceptions": {
    "denySubjects": ["hard_policy", "principal", "active_group"],
    "legacyRoleSubjectDenyRuntimeAllowed": false,
    "override": "principal_only_approved_expiring_exact_scope",
    "recordAcl": "exact_shareable_record_shadow_until_wave5",
    "delegation": "delegable_subset_ordinary_group_role_provenance_shadow_until_wave5",
    "directFeaturePrincipalGrantRuntimeAllowed": false
  },
  "migrationEvidence": {
    "accessGrant": "control.authorization_v4_access_grant_disposition",
    "roleSubjectDeny": "control.authorization_v4_role_deny_disposition",
    "directFeatureGrant": "control.authorization_v4_feature_grant_disposition",
    "meshLegacyException": "mesh_control.authorization_v4_legacy_exception_disposition",
    "reviewRule": "reviewed_or_applied_requires_zero_diff_exact_legacy_and_canonical_hashes_and_named_approval"
  },
  "staticGate": {
    "command": "pnpm --dir server/db run db:verify:authorization-v2-wave4",
    "status": "implemented"
  },
  "liveGate": {
    "command": "pnpm --dir server/db run db:verify:authorization-v2-wave4:live",
    "requiredEnvironment": [
      "AUTHORIZATION_V2_NEON_DATABASE_URL",
      "AUTHORIZATION_V2_MESH_DATABASE_URL"
    ],
    "status": "required_not_executed",
    "zeroRequired": [
      "unclassified_access_grants",
      "access_grant_affected_user_diffs",
      "unreviewed_role_subject_denies",
      "role_subject_deny_affected_user_diffs",
      "unclassified_direct_feature_grants",
      "mesh_legacy_exception_affected_user_diffs",
      "inexact_active_deny_subject_bindings",
      "published_mesh_permissions_without_local_entitlement_binding",
      "unvalidated_wave4_constraints"
    ]
  },
  "publication": {
    "allowedBeforeLiveGate": false,
    "requiresNamedBusinessOwner": true,
    "requiresAffectedUserDiffApproval": true,
    "requiresRollbackOwnerAndObservationWindow": true,
    "requiresWave5ConsumerMigration": true
  }
}
