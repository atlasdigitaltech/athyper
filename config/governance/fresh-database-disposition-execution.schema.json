{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athyper.example/governance/fresh-database-disposition-execution.schema.json",
  "title": "Wave 6 Fresh Database Disposition Execution Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "migrationId",
    "plane",
    "dataClass",
    "sourceDatabase",
    "targetDatabase",
    "approval",
    "tables"
  ],
  "properties": {
    "contractVersion": { "const": "wave6.fresh-database-disposition.v1" },
    "migrationId": { "type": "string", "minLength": 1 },
    "plane": { "enum": ["neon", "mesh"] },
    "dataClass": { "enum": ["business", "document", "audit"] },
    "sourceDatabase": { "type": "string", "minLength": 1 },
    "targetDatabase": { "type": "string", "minLength": 1 },
    "externalObjectEvidenceSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "ticket", "approvedBy", "approvedAt"],
      "properties": {
        "status": { "const": "approved" },
        "ticket": { "type": "string", "minLength": 1 },
        "approvedBy": { "type": "string", "minLength": 1 },
        "approvedAt": { "type": "string", "format": "date-time" }
      }
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema", "table", "columns", "primaryKey"],
        "properties": {
          "schema": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "table": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "columns": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
          },
          "primaryKey": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "dataClass": { "const": "document" } } },
      "then": { "required": ["externalObjectEvidenceSha256"] }
    }
  ]
}
