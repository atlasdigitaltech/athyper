# =============================================
# Athyper Server Platform Host — Staging
# =============================================
# Used when the platform host runs OUTSIDE the stack Docker network
# (split-server topology: stack on one machine, runtime on another).
#
# If server runs inside the stack Docker Compose (same machine, same network),
# vars are injected by the compose service — this file is NOT needed.
#
# Copy to .env:
#   cp server/staging.env.example server/.env
#
# All ${VAR} references must be sourced from your CI/CD secret store
# (Vault, AWS Secrets Manager, Infisical, etc.) before deployment.

# =============================================
# SERVER
# =============================================
PORT=4000
ENVIRONMENT=staging
NODE_ENV=production
NODE_TLS_REJECT_UNAUTHORIZED=1
SERVICE_NAME=athyper-platform-host
SERVICE_VERSION=${SERVICE_VERSION}
MULTITENANT=TRUE
PUBLIC_BASE_URL=https://api-stg.athyper.com
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=30000
ATHYPER_KERNEL_CONFIG_PATH=${ATHYPER_KERNEL_CONFIG_PATH}

# =============================================
# DATABASE (PostgreSQL via PgBouncer)
# =============================================
# Split-server: PgBouncer is Docker-internal (port 6432). Expose it on the
# stack host, or point directly at Postgres (port 5432) if no external pooler.
# Format: postgresql://<user>:<pass>@<stack-host>:<port>/athyper_neon
DATABASE_URL=${DATABASE_URL}
STUDIO_DATABASE_URL=${STUDIO_DATABASE_URL}
STUDIO_DATABASE_POOL_MAX=${STUDIO_DATABASE_POOL_MAX}
MESH_DATABASE_URL=${MESH_DATABASE_URL}
NEON_WORKER_DATABASE_URL=${NEON_WORKER_DATABASE_URL}
STUDIO_WORKER_DATABASE_URL=${STUDIO_WORKER_DATABASE_URL}
MESH_WORKER_DATABASE_URL=${MESH_WORKER_DATABASE_URL}

# DATABASE_ADMIN_URL is NOT used in staging — migrations run via CI/CD pipeline
# against the direct Postgres endpoint before the runtime server starts.
# DATABASE_ADMIN_URL=${DATABASE_ADMIN_URL}

DB_POOL_MAX=20

# =============================================
# CACHE (Redis)
# =============================================
# Redis is Docker-internal. Expose port 6379 on the stack host (firewall-gated),
# or use a managed Redis service (Elasticache, Upstash, etc.).
REDIS_URL=${REDIS_URL}
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_MAX_RETRIES_PER_REQUEST=2
REDIS_KEY_PREFIX=athyper:
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_MAX_RETRIES=3
REDIS_ERROR_LOG_COOLDOWN_MS=30000
# REDIS_BULLMQ_URL=${REDIS_BULLMQ_URL}
ALLOW_SHARED_BULLMQ_REDIS=false
JOB_WORKER_CONCURRENCY=10
JOB_SCHEDULE_RECONCILE_MS=60000

# =============================================
# IAM (Keycloak)
# =============================================
# Prefer the Docker-native fallback chain (IAM_ISSUER_URL / IAM_CLIENT_ID /
# IAM_CLIENT_SECRET / IAM_DEFAULT_REALM) when running inside compose.
# For split-server use KEYCLOAK_* below — app.ts reads both chains.
KEYCLOAK_BASE_URL=https://iam-stg.athyper.com
KEYCLOAK_REALM=athyper
KEYCLOAK_CLIENT_ID=athyper-api-runtime
AUTH_CLAIM_FIRST_CONTEXT=shadow
AUTH_REQUIRE_AUTHORIZED_ROLE=true
AUTH_VERIFY_ENFORCE_REQUIRED_ACTIONS=true
KEYCLOAK_JWKS_CACHE_TTL_MS=600000
KEYCLOAK_CLIENT_SECRET=${IAM_CLIENT_SECRET}
AUTH_DISCOVERY_SHARED_SECRET=${AUTH_DISCOVERY_SHARED_SECRET}
AUTH_DISCOVERY_STAGE1_VERIFICATION_MODE=disabled
AUTH_DISCOVERY_TOKEN_TTL_SECONDS=900
AUTH_DISCOVERY_RESEND_COOLDOWN_SECONDS=30
AUTH_DISCOVERY_VERIFIED_TRUST_TTL_DAYS=30
AUTH_DISCOVERY_USERNAME_EMAIL_DOMAINS=

# Attachment hardening rollout flags. Keep disabled until staging evidence is approved.
ATTACHMENT_AUTH_STRICT=false
ATTACHMENT_MULTIPART_CLEANUP_STRICT=false

# IAM outbox worker polling interval (ms)
OUTBOX_POLL_MS=10000

# Credential encryption master key (AES-256-GCM; generate: openssl rand -base64 48)
CREDENTIAL_MASTER_KEY=${CREDENTIAL_MASTER_KEY}

# WebAuthn relying-party ID (must match the domain in the browser URL bar)
WEBAUTHN_RP_ID=api-stg.athyper.com

# =============================================
# OBJECT STORAGE (MinIO / S3)
# =============================================
# Use the scoped app service account (APP_S3_ACCESS_KEY / APP_S3_SECRET_KEY).
# S3_ENDPOINT must be reachable from the runtime server. Options:
#   - Expose MinIO via Traefik: https://objectstorage-stg.athyper.com
#   - Managed S3: leave S3_ENDPOINT blank and set S3_REGION/S3_BUCKET
S3_ENDPOINT=${S3_ENDPOINT}
S3_ACCESS_KEY=${APP_S3_ACCESS_KEY}
S3_SECRET_KEY=${APP_S3_SECRET_KEY}
S3_REGION=us-east-1
S3_BUCKET=athyper-staging
S3_USE_SSL=true
S3_MULTIPART_PART_SIZE_MB=5
S3_MULTIPART_QUEUE_SIZE=4
S3_MAX_UPLOAD_MB=150
ATTACHMENT_TENANT_QUOTA_GB=10
ATTACHMENT_TENANT_QUOTA_ITEMS=50000
ATTACHMENT_QUOTA_RESERVATION_TTL_SECONDS=1800
ATTACHMENT_QUOTA_RETRY_AFTER_SECONDS=900
S3_PRESIGNED_TTL_SECONDS=900

# EntityQueryService and mutation-kernel rollout controls.
# Required: inject at least 32 random UTF-8 bytes from the secrets manager.
ENTITY_QUERY_CURSOR_SECRET=
MUTATION_KERNEL_STAGE=shadow_validation
MUTATION_KERNEL_INTERNAL_TENANTS=
MUTATION_KERNEL_EXTERNAL_COHORT=

# =============================================
# ATLAS AGENT (supervised staging evaluation)
# =============================================
# Keep both gates disabled until the tenant flag, evaluator permissions, and
# managed credentials are ready. Provider keys and the fingerprint key are
# server-only secrets injected by CI/CD.
ATLAS_AGENT_ENABLED=true
ATLAS_AGENT_ADMIN_ENABLED=true
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
ATLAS_AGENT_CREDENTIAL_FINGERPRINT_KEY=${ATLAS_AGENT_CREDENTIAL_FINGERPRINT_KEY}
ATLAS_BYOK_ENABLED=false
ATLAS_BYOK_BACKEND=disabled
ATLAS_BYOK_FINGERPRINT_KEY=${ATLAS_BYOK_FINGERPRINT_KEY}
ATLAS_BYOK_CACHE_TTL_MS=30000
ATLAS_AGENT_DEFAULT_PUBLIC_MODEL=atlas-fast
ATLAS_AGENT_ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
ATLAS_AGENT_ANTHROPIC_BALANCED_MODEL=claude-sonnet-4-6
ATLAS_AGENT_ANTHROPIC_BEST_MODEL=claude-opus-4-8
ATLAS_AGENT_PROVIDER_TIMEOUT_MS=60000
ATLAS_AGENT_STREAM_IDLE_TIMEOUT_MS=30000
ATLAS_AGENT_MAX_OUTPUT_TOKENS=2048
ATLAS_AGENT_MAX_OUTPUT_BYTES=131072
ATLAS_AGENT_USER_RUNS_PER_MINUTE=10
ATLAS_AGENT_TENANT_RUNS_PER_MINUTE=100
# Keep governed tools disabled until durable persistence and the read-only
# conformance, policy, and invocation-ledger gates pass for an allowlisted tenant.
ATLAS_AGENT_TOOLS_ENABLED=false
ATLAS_AGENT_TOOL_MAX_ROUNDS=3
ATLAS_AGENT_TOOL_MAX_CALLS=4
ATLAS_AGENT_TOOL_MAX_ELAPSED_MS=120000
ATLAS_AGENT_TOOL_MAX_TOTAL_TOKENS=32768
ATLAS_AGENT_TOOL_TIMEOUT_MS=10000
ATLAS_AGENT_TOOL_MAX_INPUT_BYTES=32768
ATLAS_AGENT_TOOL_MAX_RESULT_BYTES=32768
# Enable only for an allowlisted tenant after RLS and purge verification.
ATLAS_CONVERSATION_PERSISTENCE_ENABLED=false
ATLAS_CONVERSATION_CONTENT_PROTECTION_MODE=database_at_rest_non_sensitive_only
# Inject only into retention scheduler/worker processes, not the API.
ATLAS_CONVERSATION_MAINTENANCE_DATABASE_URL=${ATLAS_CONVERSATION_MAINTENANCE_DATABASE_URL}
ATLAS_CONVERSATION_RETENTION_DAYS=30
ATLAS_CONVERSATION_MIN_RETENTION_DAYS=1
ATLAS_CONVERSATION_MAX_RETENTION_DAYS=365
ATLAS_CONVERSATION_CONTEXT_MAX_MESSAGES=20
ATLAS_CONVERSATION_CONTEXT_MAX_CHARACTERS=98304
ATLAS_CONVERSATION_STALE_RUN_TIMEOUT_MS=900000
ATLAS_CONVERSATION_PURGE_BATCH_SIZE=500
# OpenAI evaluation is non-default, public-classified-content only, and also
# requires ai.agent.provider_diagnostics. That permission does not classify or
# sanitize pasted content.
OPENAI_PROVIDER_ENABLED=false
OPENAI_API_KEY=${OPENAI_API_KEY}
OPENAI_PROJECT_ID=
OPENAI_TIMEOUT_MS=60000
ATLAS_AGENT_OPENAI_EVAL_MODEL=gpt-5.6-sol
GEMINI_PROVIDER_ENABLED=false
GEMINI_API_KEY=${GEMINI_API_KEY}
GEMINI_PROJECT_ID=
GEMINI_EVAL_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=60000
GEMINI_ACCOUNT_CLASS=paid
GEMINI_PROVIDER_REGION=global

# Backup bucket — scoped athyper-backup service account
BACKUP_S3_BUCKET=athyper-backups-staging
BACKUP_S3_ACCESS_KEY=${BACKUP_S3_ACCESS_KEY}
BACKUP_S3_SECRET_KEY=${BACKUP_S3_SECRET_KEY}

# =============================================
# VIRUS SCANNING (ClamAV)
# =============================================
# ClamAV is Docker-internal. Expose clamd TCP port 3310 on the stack host
# (firewall-gated), or run a separate ClamAV container on the runtime server.
CLAMD_HOST=${CLAMD_HOST}
CLAMD_PORT=3310
CLAMD_TIMEOUT_MS=30000
CLAMD_MAX_BYTES=104857600
CLAMD_ON_UNAVAILABLE=fail-closed

# =============================================
# PDF RENDERING (docrender / Gotenberg)
# =============================================
# docrender is Docker-internal. Either:
#   a) Expose it on the stack host: http://stack-host:3000
#   b) Add a Traefik TCP/HTTP route (internal-only, no public hostname)
#   c) Run a separate docrender container on the runtime server
# Leave unset to disable PDF rendering.
# DOCRENDER_BASE_URL=http://stack-host:3000
# DOCRENDER_TIMEOUT_MS=120000
# DOCRENDER_MAX_HTML_BYTES=5242880
# DOCRENDER_MAX_PDF_BYTES=52428800

# =============================================
# TEXT EXTRACTION (docparser / Tika)
# =============================================
# docparser is Docker-internal. Leave unset to disable attachment text extraction.
# DOCPARSER_URL=http://stack-host:9998
# DOCPARSER_TIMEOUT_MS=120000
# DOCPARSER_MAX_INPUT_BYTES=52428800
# DOCPARSER_MAX_TEXT_CHARS=5000000

# =============================================
# OBSERVABILITY — Error tracking (GlitchTip)
# =============================================
GLITCHTIP_DSN=${GLITCHTIP_DSN}
SENTRY_TRACES_SAMPLE_RATE=0.05

# =============================================
# OBSERVABILITY — Distributed tracing (OTel → Tempo)
# =============================================
# Tempo OTLP/gRPC port 4317 is Docker-internal. Expose it on the stack host
# or point at a managed OTLP collector. Leave unset to disable tracing.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://stack-host:4317
OTEL_AUTO_INSTRUMENTATIONS_ENABLED=false

# Optional notification transports. Store credentials in the environment's
# secret manager; configure either a Twilio number or Messaging Service SID.
# SMTP_HOST=${SMTP_HOST}
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=${SMTP_USER}
# SMTP_PASS=${SMTP_PASS}
# SMTP_FROM=no-reply-stg@athyper.com
# TWILIO_ACCOUNT_SID=${TWILIO_ACCOUNT_SID}
# TWILIO_AUTH_TOKEN=${TWILIO_AUTH_TOKEN}
# TWILIO_FROM_NUMBER=${TWILIO_FROM_NUMBER}
# TWILIO_MESSAGING_SERVICE_SID=${TWILIO_MESSAGING_SERVICE_SID}
# META_WHATSAPP_API_VERSION=${META_WHATSAPP_API_VERSION}
# META_WHATSAPP_PHONE_NUMBER_ID=${META_WHATSAPP_PHONE_NUMBER_ID}
# META_WHATSAPP_ACCESS_TOKEN=${META_WHATSAPP_ACCESS_TOKEN}
# PUSH_FCM_PROJECT_ID=${PUSH_FCM_PROJECT_ID}
# PUSH_FCM_CLIENT_EMAIL=${PUSH_FCM_CLIENT_EMAIL}
# PUSH_FCM_PRIVATE_KEY=${PUSH_FCM_PRIVATE_KEY}
OTEL_SERVICE_NAME=athyper-platform-host
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# =============================================
# SEARCH (searchcore)
# =============================================
# searchcore is Docker-internal. Expose or run externally. Leave unset to disable.
# SEARCHCORE_URL=https://meilisearch-stg.athyper.com
# SEARCHCORE_MASTER_KEY=${MEILI_MASTER_KEY}
# SEARCHCORE_DOCUMENT_INDEX=documents
# SEARCHCORE_TIMEOUT_MS=10000

# =============================================
# CRON HEARTBEAT (cronwatch / Healthchecks)
# =============================================
# cronwatch is Docker-internal. Expose or run externally. Leave unset to disable.
CRONWATCH_PING_KEY=${CRONWATCH_PING_KEY}
# CRONWATCH_BASE_URL=https://healthchecks-stg.athyper.com/ping

# =============================================
# WEB PUSH (VAPID)
# =============================================
# Generate once per environment:
#   npx web-push generate-vapid-keys
# Keep VAPID_PRIVATE_KEY in your secrets manager.
VAPID_SUBJECT=mailto:noreply-stg@athyper.com
VAPID_PUBLIC_KEY=${VAPID_PUBLIC_KEY}
VAPID_PRIVATE_KEY=${VAPID_PRIVATE_KEY}

# =============================================
# IAM SECRETS
# =============================================
ATHYPER_SUPER__IAM_SECRET__IAM_ATHYPER_CLIENT_SECRET=${ATHYPER_SUPER__IAM_SECRET__IAM_ATHYPER_CLIENT_SECRET}

# =============================================
# AUTH HARDENING (claim-first context, plane gate, required-actions matrix)
# =============================================
# Staging runs these in `shadow` first so Prometheus counters
# auth_context_mismatch_total and auth_required_action_blocked_total can be
# baselined before flipping production to `on`. See
# stack/config/iam/protocol-mappers/README.md for the KC mapper attach steps.

# Claim-vs-context cross-check inside verifyTokenForCurrentContext.
# off | shadow | on   (staging target: shadow first, then on)
AUTH_CLAIM_FIRST_CONTEXT=shadow

# Wave 7 repository cutover. Each workflow advances independently:
# legacy -> shadow (legacy authoritative) -> enforce (canonical authoritative).
IAM_LOGIN_CUTOVER_MODE=shadow
IAM_SESSION_CUTOVER_MODE=shadow
IAM_LOGOUT_CUTOVER_MODE=legacy
IAM_PROVISIONING_CUTOVER_MODE=legacy
IAM_IDENTITY_RESOLVER_REVISION=wave7-r1

# Unified platform-context middleware on apiRouter. Requires KC mappers
# (tenant_id, allowed_tenants, required_actions) attached to every *-web client.
AUTH_PLATFORM_CONTEXT_GATE=on

# /api/auth/verify must receive x-plane and bind to claims.azp → plane.
AUTH_VERIFY_REQUIRE_PLANE=on

# Override the built-in required-action blocking matrix (JSON). See
# production.env.example for default behaviour.
# AUTH_REQUIRED_ACTIONS_MATRIX=

# Publication (enable incrementally: apply, dispatch, then Studio compile)
PUBLICATION_API_ENABLED=false
PUBLICATION_COMPILE_ENABLED=false
PUBLICATION_DISPATCH_ENABLED=false
PUBLICATION_APPLY_ENABLED=false
PUBLICATION_RECOVERY_ENABLED=false
PUBLICATION_TARGET_PLANES=studio,neon,mesh
PUBLICATION_REQUIRE_SIGNATURE=true
PUBLICATION_SIGNING_KEY_ID=${PUBLICATION_SIGNING_KEY_ID}
PUBLICATION_PRIVATE_KEY_REFERENCE=publication/signing/private
PUBLICATION_PUBLIC_KEY_REFERENCE=publication/signing/public
PUBLICATION_RUNTIME_VERSION=1.0.0
PUBLICATION_RECOVERY_INTERVAL_MS=60000
INFISICAL_URL=${INFISICAL_URL}
INFISICAL_TOKEN=${INFISICAL_TOKEN}
INFISICAL_WORKSPACE_ID=${INFISICAL_WORKSPACE_ID}
INFISICAL_ENVIRONMENT=staging
INFISICAL_SECRET_PATH=/publication
