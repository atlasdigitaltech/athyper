# =============================================
# Athyper Runtime API Server — Production
# =============================================
# Used when the runtime server runs OUTSIDE the stack Docker network
# (split-server topology: stack on one machine, runtime on another).
#
# If server runs inside the stack Docker Compose (same machine, same network),
# vars are injected by the compose service — this file is NOT needed.
#
# Copy to .env:
#   cp server/production.env.example server/.env
#
# All ${VAR} references must be sourced from your CI/CD secret store
# (Vault, AWS Secrets Manager, Infisical, etc.) before deployment.

# =============================================
# SERVER
# =============================================
PORT=4000
ENVIRONMENT=production
NODE_ENV=production
NODE_TLS_REJECT_UNAUTHORIZED=1
SERVICE_NAME=athyper-runtime
SERVICE_VERSION=${SERVICE_VERSION}
MULTITENANT=TRUE
PUBLIC_BASE_URL=https://api.athyper.com
LOG_LEVEL=warn
SHUTDOWN_TIMEOUT_MS=60000
ATHYPER_KERNEL_CONFIG_PATH=${ATHYPER_KERNEL_CONFIG_PATH}

# =============================================
# DATABASE (PostgreSQL via PgBouncer)
# =============================================
# Split-server: PgBouncer is Docker-internal (port 6432). Expose it on the
# stack host, or point directly at Postgres (port 5432) if no external pooler.
# Format: postgresql://<user>:<pass>@<stack-host>:<port>/athyper_neon
DATABASE_URL=${DATABASE_URL}

# DATABASE_ADMIN_URL is NOT used in production — migrations run via CI/CD pipeline
# against the direct Postgres endpoint during the deploy pipeline, before cutover.
# DATABASE_ADMIN_URL=${DATABASE_ADMIN_URL}

DB_POOL_MAX=50

# =============================================
# CACHE (Redis)
# =============================================
# Redis is Docker-internal. Expose port 6379 on the stack host (firewall-gated),
# or use a managed Redis service (Elasticache, Upstash, etc.).
REDIS_URL=${REDIS_URL}
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_MAX_RETRIES=5
REDIS_ERROR_LOG_COOLDOWN_MS=60000
# REDIS_BULLMQ_URL=${REDIS_BULLMQ_URL}

# =============================================
# IAM (Keycloak)
# =============================================
# Prefer the Docker-native fallback chain (IAM_ISSUER_URL / IAM_CLIENT_ID /
# IAM_CLIENT_SECRET / IAM_DEFAULT_REALM) when running inside compose.
# For split-server use KEYCLOAK_* below — app.ts reads both chains.
KEYCLOAK_BASE_URL=https://iam.athyper.com
KEYCLOAK_REALM=athyper
KEYCLOAK_CLIENT_ID=athyper-api-runtime
KEYCLOAK_CLIENT_SECRET=${IAM_CLIENT_SECRET}

# IAM outbox worker polling interval (ms)
OUTBOX_POLL_MS=10000

# Credential encryption master key (AES-256-GCM; generate: openssl rand -base64 48)
CREDENTIAL_MASTER_KEY=${CREDENTIAL_MASTER_KEY}

# WebAuthn relying-party ID (must match the domain in the browser URL bar)
WEBAUTHN_RP_ID=api.athyper.com

# =============================================
# OBJECT STORAGE (MinIO / S3)
# =============================================
# Use the scoped app service account (APP_S3_ACCESS_KEY / APP_S3_SECRET_KEY).
# S3_ENDPOINT must be reachable from the runtime server. Options:
#   - Expose MinIO via Traefik: https://objectstorage.athyper.com
#   - Managed S3: leave S3_ENDPOINT blank and set S3_REGION/S3_BUCKET
S3_ENDPOINT=${S3_ENDPOINT}
S3_ACCESS_KEY=${APP_S3_ACCESS_KEY}
S3_SECRET_KEY=${APP_S3_SECRET_KEY}
S3_REGION=us-east-1
S3_BUCKET=${S3_BUCKET}
S3_USE_SSL=true
S3_MULTIPART_PART_SIZE_MB=8
S3_MULTIPART_QUEUE_SIZE=4
S3_MAX_UPLOAD_MB=250
S3_PRESIGNED_TTL_SECONDS=900

# Backup bucket — scoped athyper-backup service account
BACKUP_S3_BUCKET=${BACKUP_S3_BUCKET}
BACKUP_S3_ACCESS_KEY=${BACKUP_S3_ACCESS_KEY}
BACKUP_S3_SECRET_KEY=${BACKUP_S3_SECRET_KEY}

# =============================================
# VIRUS SCANNING (ClamAV)
# =============================================
# ClamAV is Docker-internal. Expose clamd TCP port 3310 on the stack host
# (firewall-gated), or run a separate ClamAV container on the runtime server.
CLAMD_HOST=${CLAMD_HOST}
CLAMD_PORT=3310
CLAMD_ON_UNAVAILABLE=fail-closed

# =============================================
# PDF RENDERING (Gotenberg)
# =============================================
# Gotenberg is Docker-internal. Either:
#   a) Expose it on the stack host: http://stack-host:3000
#   b) Add a Traefik TCP/HTTP route (internal-only, no public hostname)
#   c) Run a separate Gotenberg container on the runtime server
# Leave unset to disable PDF rendering.
# GOTENBERG_BASE_URL=http://stack-host:3000

# =============================================
# TEXT EXTRACTION (Tika)
# =============================================
# Tika is Docker-internal. Leave unset to disable attachment text extraction.
# TIKA_URL=http://stack-host:9998

# =============================================
# OBSERVABILITY — Error tracking (GlitchTip)
# =============================================
GLITCHTIP_DSN=${GLITCHTIP_DSN}
SENTRY_TRACES_SAMPLE_RATE=0.01

# =============================================
# OBSERVABILITY — Distributed tracing (OTel → Tempo)
# =============================================
# Tempo OTLP/gRPC port 4317 is Docker-internal. Expose it on the stack host
# or point at a managed OTLP collector. Leave unset to disable tracing.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://stack-host:4317
OTEL_SERVICE_NAME=athyper-runtime
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# =============================================
# SEARCH (Meilisearch)
# =============================================
# Meilisearch is Docker-internal. Expose or run externally. Leave unset to disable.
# MEILISEARCH_URL=https://meilisearch.athyper.com
# MEILISEARCH_MASTER_KEY=${MEILI_MASTER_KEY}

# =============================================
# CRON HEARTBEAT (Healthchecks)
# =============================================
# Healthchecks is Docker-internal. Expose or run externally. Leave unset to disable.
# HEALTHCHECKS_BASE_URL=https://healthchecks.athyper.com/ping

# =============================================
# IAM SECRETS
# =============================================
ATHYPER_SUPER__IAM_SECRET__IAM_ATHYPER_CLIENT_SECRET=${ATHYPER_SUPER__IAM_SECRET__IAM_ATHYPER_CLIENT_SECRET}
