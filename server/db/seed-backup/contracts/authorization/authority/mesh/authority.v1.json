{
  "contractVersion": "wave3.authorization-authority.semantic.v1",
  "manifestVersion": "wave3.mesh.authority.v1",
  "database": "mesh",
  "planes": ["mesh"],
  "catalogInput": "seed/contracts/authorization/catalog/mesh/compiled/compiled-catalog.v1.json",
  "allowedReadRoots": [
    "seed/contracts/authorization/authority/authorization-authority-semantic-contract.v1.json",
    "seed/contracts/authorization/authority/mesh/authority.v1.json",
    "seed/contracts/authorization/catalog/mesh/compiled/compiled-catalog.v1.json"
  ],
  "subjectAdmission": {
    "principalSource": "mesh.principal",
    "accountSource": "mesh.network_account",
    "legacyGrantSource": "mesh.account_grant",
    "identitySource": "mesh.principal_identity_binding",
    "activeGrant": "explicit mesh.auth_plane_membership plus local group membership",
    "missingOrInvalidGrant": "quarantined_zero_grant"
  },
  "entitlement": {
    "source": "Mesh-local product/account eligibility",
    "permissions": "exact local permission IDs",
    "neonPlanRead": "forbidden"
  },
  "roles": [
    {
      "code": "mesh.observer",
      "name": "Mesh Observer",
      "selector": {"operationKinds": ["read"]}
    },
    {
      "code": "mesh.participant",
      "name": "Mesh Participant",
      "selector": {"riskTiers": ["low", "medium"]}
    },
    {
      "code": "mesh.security_admin",
      "name": "Mesh Security Administrator",
      "selector": {
        "entities": [
          "network_account",
          "network_relationship",
          "attachment",
          "conversation",
          "content_item",
          "bank_account"
        ]
      }
    },
    {
      "code": "mesh.account_owner",
      "name": "Mesh Account Owner",
      "selector": {"all": true}
    }
  ],
  "groups": [
    {
      "code": "mesh.observers",
      "roleCodes": ["mesh.observer"],
      "scopeKind": "account"
    },
    {
      "code": "mesh.participants",
      "roleCodes": ["mesh.participant"],
      "scopeKind": "account"
    },
    {
      "code": "mesh.security_admins",
      "roleCodes": ["mesh.security_admin"],
      "scopeKind": "account"
    },
    {
      "code": "mesh.account_owners",
      "roleCodes": ["mesh.account_owner"],
      "scopeKind": "account"
    },
    {
      "code": "mesh.unassigned_review",
      "roleCodes": [],
      "scopeKind": "account",
      "purpose": "Fail-closed quarantine; membership grants no permission."
    }
  ],
  "scopes": {
    "account": "mesh.auth_scope_account",
    "network_relationship": "mesh.auth_scope_network_relationship",
    "resource": "mesh.auth_scope_resource",
    "emptyOrUnknown": "anomaly_never_account"
  },
  "aclDelegation": {
    "acl": "mesh.auth_record_acl plus exact auth_record_acl_permission rows",
    "delegation": "mesh.auth_delegation plus exact permission and typed scope rows",
    "shareability": "permission is_shareable must be true",
    "delegability": "permission is_delegable must be true",
    "implicitCapability": "forbidden"
  },
  "repositoryEnablement": {
    "default": false,
    "requiresCompleteProofGraph": true,
    "requiresZeroReconciliationAnomalies": true,
    "requiresAllDeferredConstraintsValidated": true
  }
}
