    "db:verify:atlas-upgrade": "tsx scripts/verify/verify-atlas-conversation-upgrade.ts",
    "db:verify:atlas-tools-contract": "tsx scripts/verify/verify-atlas-tools-contract.ts",
    "db:verify:atlas-tools-rls": "tsx scripts/verify/verify-atlas-tools-rls.ts",
    "db:verify:certification-contract": "tsx scripts/verify/verify-certification-contract.ts",
    "db:verify:collaboration-lookup-ownership": "tsx scripts/verify/verify-collaboration-lookup-ownership.ts",
    "db:verify:atlas-audit-consolidation": "tsx scripts/verify/verify-atlas-audit-consolidation.ts",
    "db:verify:common-audit-contract": "tsx scripts/verify/verify-common-audit-contract.ts",
    "db:verify:business-intent-ownership": "tsx scripts/verify/verify-business-intent-ownership.ts",
    "db:verify:dimension-policy-contract": "tsx scripts/verify/verify-dimension-policy-contract.ts",
    "db:verify:fiscal-calendar-contract": "tsx scripts/verify/verify-fiscal-calendar-contract.ts",
    "db:verify:planning-budget-control-contract": "tsx scripts/verify/verify-planning-budget-control-contract.ts",
    "db:verify:field-security": "tsx scripts/verify/verify-field-security.ts",
    "db:verify:secdef": "tsx scripts/verify/verify-security-definer.ts",
    "db:verify:archetypes": "tsx scripts/verify/verify-archetypes.ts",
    "db:verify:entity-operations": "tsx scripts/verify/verify-entity-operations.ts",
    "db:verify:permission-aliases": "tsx scripts/verify/verify-permission-aliases.ts",
    "db:verify:plane-eligibility": "tsx scripts/verify/verify-plane-eligibility.ts",
    "db:verify:version-locks": "tsx scripts/verify/verify-version-locks.ts",
    "db:verify:cache-backlog": "tsx scripts/verify/verify-cache-invalidation-backlog.ts",
    "db:verify:end-to-end": "tsx scripts/verify/verify-end-to-end-pipeline.ts",
    "db:verify:effective-lock": "tsx scripts/verify/verify-effective-lock-scenarios.ts",
    "db:verify:seed-contracts": "tsx scripts/verify/verify-seed-contracts.ts",
