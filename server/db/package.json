    "db:seed:authorization-packs": "tsx scripts/seed/compile-final-authorization-seed-packs.ts",
    "db:seed:keycloak-user-manifest": "tsx scripts/authority/compile-keycloak-existing-user-manifest.ts",
    "db:verify:ddl-model": "tsx scripts/verify/verify-three-plane-ddl-model.ts",
    "db:verify:wave8-cleanup": "node scripts/verify/verify-wave8-cleanup.mjs",
    "db:verify:wave8-runtime": "node scripts/verify/verify-wave8-cleanup.mjs --runtime-only",
    "db:verify:rls": "tsx scripts/verify/verify-rls.ts",
