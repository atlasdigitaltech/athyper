{
  "name": "@athyper/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "db:setup": "tsx scripts/provision.ts --all --no-mesh",
    "db:setup:ddl": "tsx scripts/provision.ts --phase=1 --no-mesh",
    "db:setup:system": "tsx scripts/provision.ts --system-only --no-mesh",
    "db:setup:tenant": "tsx scripts/provision.ts --phase=3 --no-mesh",
    "db:setup:status": "tsx scripts/provision.ts --status",
    "db:setup:discover": "tsx scripts/provision.ts --discover --no-mesh",
    "db:setup:rebuild-entity-metadata": "tsx scripts/provision.ts --system-only --rebuild-entity-metadata --no-mesh",
    "db:setup:drop": "tsx scripts/provision.ts --drop-only",
    "db:setup:reset": "tsx scripts/provision.ts --reset",
    "db:setup:force": "tsx scripts/provision.ts --all --force --no-mesh",
    "db:sync:shared-to-mesh": "tsx scripts/sync-shared-to-mesh.ts",
    "db:sync:shared-to-mesh:dry": "tsx scripts/sync-shared-to-mesh.ts --dry-run",
    "db:verify:rls": "tsx scripts/verify/verify-rls.ts",
    "db:verify:field-security": "tsx scripts/verify/verify-field-security.ts",
    "db:verify:secdef": "tsx scripts/verify/verify-security-definer.ts",
    "db:verify:archetypes": "tsx scripts/verify/verify-archetypes.ts",
    "db:verify:entity-operations": "tsx scripts/verify/verify-entity-operations.ts",
    "db:verify:permission-aliases": "tsx scripts/verify/verify-permission-aliases.ts",
    "db:verify:plane-eligibility": "tsx scripts/verify/verify-plane-eligibility.ts",
    "db:verify:version-locks": "tsx scripts/verify/verify-version-locks.ts",
    "db:verify:cache-backlog": "tsx scripts/verify/verify-cache-invalidation-backlog.ts",
    "db:verify:end-to-end": "tsx scripts/verify/verify-end-to-end-pipeline.ts",
    "db:verify:effective-lock": "tsx scripts/verify/verify-effective-lock-scenarios.ts",
    "db:verify:seed-contracts": "tsx scripts/verify/verify-seed-contracts.ts",
    "db:verify:identity-header": "tsx scripts/verify/verify-identity-header.ts",
    "db:verify:three-plane": "pnpm run db:verify:entity-operations && pnpm run db:verify:permission-aliases && pnpm run db:verify:plane-eligibility && pnpm run db:verify:version-locks",
    "db:verify": "pnpm run db:verify:rls && pnpm run db:verify:field-security && pnpm run db:verify:secdef && pnpm run db:verify:archetypes && pnpm run db:verify:three-plane && pnpm run db:verify:identity-header",
    "db:setup:ddl:sh": "bash ddl/runner.sh",
    "lint:sql": "bash ../packages/adapters/db/ci/lint_sql_hardcoded.sh"
  },
  "dependencies": {
    "pg": "^8.13.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3"
  }
}
