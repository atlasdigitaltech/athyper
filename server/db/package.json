    "db:seed:contract:legacy-report": "tsx scripts/seed/lint-seed-contracts.ts --legacy-report",
    "db:seed:wave5:build": "tsx scripts/seed/build-wave5-blueprint-packs.ts",
    "db:seed:wave5:check": "tsx scripts/seed/build-wave5-blueprint-packs.ts --check",
    "db:seed:wave5:verify": "tsx scripts/verify/verify-wave5-blueprint-packs.ts",
