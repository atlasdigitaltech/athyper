{
  "name": "@athyper/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "db:setup": "tsx scripts/provision.ts --all",
    "db:setup:ddl": "tsx scripts/provision.ts --phase=1",
    "db:setup:system": "tsx scripts/provision.ts --system-only",
    "db:setup:tenant": "tsx scripts/provision.ts --phase=3",
    "db:setup:status": "tsx scripts/provision.ts --status",
    "db:setup:discover": "tsx scripts/provision.ts --discover",
    "db:setup:rebuild-entity-metadata": "tsx scripts/provision.ts --system-only --rebuild-entity-metadata",
    "db:setup:drop": "tsx scripts/provision.ts --drop-only",
    "db:setup:reset": "tsx scripts/provision.ts --reset",
    "db:setup:force": "tsx scripts/provision.ts --all --force",
    "db:setup:ddl:sh": "bash ddl/runner.sh",
    "lint:sql": "bash ../framework/adapters/db/ci/lint_sql_hardcoded.sh"
  },
  "dependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3"
  }
}
