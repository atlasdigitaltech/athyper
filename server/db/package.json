    "db:verify": "pnpm run db:verify:atlas-contract && pnpm run db:verify:atlas-tools-contract && pnpm run db:verify:rls && pnpm run db:verify:atlas-rls && pnpm run db:verify:atlas-tools-rls && pnpm run db:verify:field-security && pnpm run db:verify:secdef && pnpm run db:verify:archetypes && pnpm run db:verify:three-plane && pnpm run db:verify:identity-header",
