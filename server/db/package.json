    "db:foundation:create:athyper": "powershell -NoProfile -ExecutionPolicy Bypass -File ddl/foundation-runner.ps1 -Plane athyper -Docker -CreateDatabaseOnly",
    "db:foundation:create:neon": "powershell -NoProfile -ExecutionPolicy Bypass -File ddl/foundation-runner.ps1 -Plane neon -Docker -CreateDatabaseOnly",
    "db:foundation:create:mesh": "powershell -NoProfile -ExecutionPolicy Bypass -File ddl/foundation-runner.ps1 -Plane mesh -Docker -CreateDatabaseOnly",
    "db:foundation:athyper:docker": "powershell -NoProfile -ExecutionPolicy Bypass -File ddl/foundation-runner.ps1 -Plane athyper -Docker",
    "db:foundation:neon:docker": "powershell -NoProfile -ExecutionPolicy Bypass -File ddl/foundation-runner.ps1 -Plane neon -Docker",
    "db:foundation:mesh:docker": "powershell -NoProfile -ExecutionPolicy Bypass -File ddl/foundation-runner.ps1 -Plane mesh -Docker",
    "db:foundation:athyper": "powershell -NoProfile -ExecutionPolicy Bypass -File ddl/foundation-runner.ps1 -Plane athyper",
    "db:foundation:neon": "powershell -NoProfile -ExecutionPolicy Bypass -File ddl/foundation-runner.ps1 -Plane neon",
    "db:foundation:mesh": "powershell -NoProfile -ExecutionPolicy Bypass -File ddl/foundation-runner.ps1 -Plane mesh",
    "db:seed:meta-entity": "tsx scripts/seed/apply-meta-entity-seed-pack.ts",
    "db:seed:meta-entity:check": "tsx scripts/seed/apply-meta-entity-seed-pack.ts --dry-run",
    "db:seed:meta-entity:validation": "tsx scripts/seed/apply-meta-entity-seed-pack.ts --profile=validation",
    "db:seed:meta-entity:validation:check": "tsx scripts/seed/apply-meta-entity-seed-pack.ts --profile=validation --dry-run",
    "lint:sql": "bash ../packages/adapters/db/ci/lint_sql_hardcoded.sh"
