  "dependencies": {
    "dotenv": "^17.4.2",
    "kysely": "^0.28.16",
    "pg": "^8.13.0",
    "postgres": "^3.4.9",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3"
