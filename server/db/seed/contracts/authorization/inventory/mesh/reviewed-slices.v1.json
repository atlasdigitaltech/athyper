        { "code": "accept", "from": ["requested"], "to": "active", "permissionCode": "mesh.network.network_relationship.accept" },
        { "code": "reject", "from": ["requested"], "to": "terminated", "permissionCode": "mesh.network.network_relationship.reject" },
        { "code": "suspend", "from": ["active"], "to": "suspended", "permissionCode": "mesh.network.network_relationship.suspend" },
