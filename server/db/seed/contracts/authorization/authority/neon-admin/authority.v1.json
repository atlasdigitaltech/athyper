{
  "contractVersion": "wave3.authorization-authority.semantic.v1",
  "manifestVersion": "wave3.neon-admin.authority.v1",
  "database": "neon",
  "planes": ["neon", "admin"],
  "catalogInput": "seed/contracts/authorization/catalog/neon-admin/compiled/compiled-catalog.v1.json",
  "approval": {
    "status": "policy_approved",
    "basis": "Preserve existing users and assign explicit groups; zero-grant quarantine is fail-closed.",
    "requiresNamedBusinessOwnerBeforePublication": true
  },
  "canonicalAccessRoles": {
    "roleOrder": [
      "viewer",
      "reporter",
      "requester",
      "agent",
      "manager",
      "owner",
      "admin"
    ],
    "operationTiers": {
      "viewer": ["read", "export", "print", "view_je", "view_match"],
      "reporter": ["add_comment", "add_attachment"],
      "requester": [
        "create", "update", "edit", "delete_draft", "submit", "amend",
        "cancel", "withdraw", "copy", "delegate", "share_read"
      ],
      "agent": [
        "delete", "close", "reopen", "post", "return", "import"
      ],
      "manager": [
        "reverse", "del_others_comment", "approve", "deny", "request_info",
        "bulk_update", "block_supplier", "unblock_supplier"
      ],
      "owner": ["*"],
      "admin": ["*"]
    },
    "output": {
      "permissionSetCodePattern": "neon.access.{role}",
      "roleCodePattern": "neon.access.{role}",
      "groupCodePattern": "neon.access.{role}",
      "sourceType": "canonical",
      "publicationStatus": "draft"
    }
  },
  "adminRoles": [
    {
      "code": "admin.catalog.viewer",
      "name": "Admin Catalog Viewer",
      "operationKinds": ["read"]
    },
    {
      "code": "admin.catalog.operator",
      "name": "Admin Catalog Operator",
      "riskTiers": ["low", "medium"]
    },
    {
      "code": "admin.catalog.owner",
      "name": "Admin Catalog Owner",
      "riskTiers": ["low", "medium", "high", "critical"]
    }
  ],
  "existingUserPolicy": {
    "source": "all active master.principal rows at the captured watermark",
    "existingActiveMembership": "copy exact groups and create explicit plane membership",
    "legacyAdminGrant": "map to admin plane membership and admin migration group",
    "legacyTierInput": "map once to the matching canonical neon.access group",
    "noAuthoritySource": "quarantined_zero_grant",
    "servicePrincipal": "excluded_non_human with signed reason",
    "requiredEvidence": [
      "principal_id",
      "tenant_id",
      "plane_code",
      "source_rows",
      "target_group_ids",
      "target_membership_id",
      "disposition",
      "approval_ticket",
      "definition_sha256"
    ]
  },
  "groupTemplates": [
    {
      "code": "neon.access.quarantine",
      "name": "Neon Access Quarantine",
      "roleCodes": [],
      "status": "active",
      "purpose": "Fail-closed quarantine; membership grants no permission."
    },
    {
      "code": "admin.platform.owners",
      "name": "Admin Platform Owners",
      "roleCodes": ["admin.catalog.owner"],
      "plane": "admin"
    },
    {
      "code": "admin.platform.quarantine",
      "name": "Admin Platform Quarantine",
      "roleCodes": [],
      "plane": "admin",
      "status": "active",
      "purpose": "Fail-closed Admin quarantine; membership grants no permission."
    }
  ],
  "scopeMigration": {
    "authority": "master.auth_group_role",
    "typedScopeAuthority": "master.auth_scope_target",
    "emptyOrUnknown": "anomaly_never_tenant",
    "companyOrganizationAccess": "scoped_group_role_or_explicit_override",
    "includeDescendants": "preserve_only_with_approved_typed_hierarchy"
  },
  "publication": {
    "initialStatus": "draft",
    "requiresZeroAnomalies": true,
    "requiresNamedBusinessOwner": true,
    "requiresAllDeferredConstraintsValidated": true
  }
}
