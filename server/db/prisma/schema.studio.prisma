generator kysely {
  provider        = "prisma-kysely"
  output          = "../../packages/adapters/database/athyper-postgres/src/generated/kysely-studio"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["aggregate", "ai", "audit", "authz", "control", "document", "event", "governance", "ledger", "log", "master", "metadata", "onboarding", "ops", "public", "publication", "runtime_meta", "shared", "snapshot", "trustiam"]
}

