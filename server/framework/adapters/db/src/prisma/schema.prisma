generator kysely {
  provider        = "prisma-kysely"
  output          = "../generated/kysely"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["aggregate", "control", "document", "event", "governance", "ledger", "log", "master", "public", "shared", "snapshot"]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model tax_credit_summary {
  id               String           @id(map: "tcs_pkey") @default(dbgenerated("shared.uuidv7()")) @db.Uuid
  tenant_id        String           @db.Uuid
  company_code_id  String           @db.Uuid
  jurisdiction_id  String           @db.Uuid
  tax_type_id      String           @db.Uuid
  book_id          String           @db.Uuid
  fiscal_year      Int              @db.SmallInt
  period_number    Int              @db.SmallInt
  input_credits    Decimal          @default(0) @db.Decimal(18, 4)
  output_liability Decimal          @default(0) @db.Decimal(18, 4)
  net_position     Decimal?         @default(dbgenerated("(input_credits - output_liability)")) @db.Decimal(18, 4)
  wht_deducted     Decimal          @default(0) @db.Decimal(18, 4)
  wht_suffered     Decimal          @default(0) @db.Decimal(18, 4)
  adjustment_total Decimal          @default(0) @db.Decimal(18, 4)
  carry_forward_in Decimal          @default(0) @db.Decimal(18, 4)
  movement_count   Int              @default(0)
  currency_code    String           @db.Char(3)
  is_reconciled    Boolean          @default(false)
  reconciled_at    DateTime?        @db.Timestamptz(6)
  reconciled_by    String?          @db.Uuid
  filed_at         DateTime?        @db.Timestamptz(6)
  filing_reference String?
  last_rebuilt_at  DateTime         @default(now()) @db.Timestamptz(6)
  version          Int              @default(1)
  status           String           @default("draft")
  posted_at        DateTime?        @db.Timestamptz(6)
  posted_by        String?          @db.Uuid
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  created_by       String           @db.Uuid
  updated_at       DateTime?        @db.Timestamptz(6)
  updated_by       String?          @db.Uuid
  ledger_book      ledger_book      @relation(fields: [tenant_id, book_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction, map: "tcs_book_fk")
  company_code     company_code     @relation(fields: [tenant_id, company_code_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction, map: "tcs_company_fk")
  principal        principal        @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "tcs_created_by_fk")
  currency         currency         @relation(fields: [currency_code], references: [code], onDelete: NoAction, onUpdate: NoAction, map: "tcs_currency_fk")
  tax_jurisdiction tax_jurisdiction @relation(fields: [tenant_id, jurisdiction_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction, map: "tcs_jurisdiction_fk")
  tenant           tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "tcs_tenant_fk")
  tax_type         tax_type         @relation(fields: [tenant_id, tax_type_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction, map: "tcs_type_fk")

  @@unique([tenant_id, company_code_id, jurisdiction_id, tax_type_id, book_id, fiscal_year, period_number], map: "tcs_period_uq")
  @@unique([tenant_id, id], map: "tcs_tenant_id_uq")
  @@index([tenant_id, company_code_id, fiscal_year, period_number], map: "tcs_company_period_idx")
  @@index([tenant_id, jurisdiction_id, fiscal_year, period_number], map: "tcs_jurisdiction_period_idx")
  @@schema("aggregate")
}

