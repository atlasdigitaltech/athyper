{
  "name": "@athyper/svc-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup index.ts --format esm --dts --outDir dist --external express --external kysely --external zod",
    "dev": "tsup index.ts --format esm --dts --outDir dist --external express --external kysely --external zod --watch",
    "eval:gemini:validate": "vitest run __tests__/atlas-gemini-eval-set.test.ts __tests__/gemini-provider-lifecycle.test.ts",
    "eval:anthropic:validate": "vitest run __tests__/anthropic-production-baseline.test.ts __tests__/anthropic-promotion-gates.test.ts providers/__tests__/provider-conformance.test.ts providers/__tests__/claude-text.provider.test.ts agent/__tests__/atlas-telemetry.test.ts",
    "eval:anthropic:readiness": "tsx evals/probe-anthropic-readiness.ts",
    "eval:anthropic:pilot": "tsx evals/run-openai-phase2-pilot.ts --endpoint /api/relay/ai/agent/runs --pilot-label \"Atlas Anthropic phase 2\" --dataset-lock-model gpt-5.6-sol --model-id atlas-fast --expected-upstream-model claude-haiku-4-5-20251001 --price-input 1 --price-output 5 --output evals/results/anthropic-phase2-live-pilot.json --require-signoff",
    "eval:openai:validate": "vitest run __tests__/atlas-openai-eval-set.test.ts",
    "eval:openai:pilot": "tsx evals/run-openai-phase2-pilot.ts --endpoint /api/relay/ai/agent/runs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@athyper/foundation-crypto": "workspace:*",
    "@athyper/platform-ai-agent-runtime": "workspace:*",
    "@athyper/svc-iam": "workspace:*",
    "@athyper/svc-shared": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@google/genai": "2.13.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@athyper/tsconfig": "workspace:*",
    "@types/express": "^5.0.1",
    "@types/node": "^25.6.0",
    "express": "^5.0.0",
    "kysely": "^0.28.16",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
