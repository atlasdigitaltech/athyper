{
  "name": "@athyper/plane-neon-document-rendering",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup src/index.ts --format esm --dts --outDir dist --external kysely",
    "dev": "tsup src/index.ts --format esm --dts --outDir dist --external kysely --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@athyper/adapter-object-storage": "workspace:*",
    "@athyper/platform-rendering": "workspace:*"
  },
  "devDependencies": {
    "@athyper/tsconfig": "workspace:*",
    "@types/node": "^25.6.0",
    "kysely": "^0.28.16",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.0",
    "typescript": "^6.0.3"
  }
}
