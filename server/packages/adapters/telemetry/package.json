{
  "name": "@athyper/adapter-telemetry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./dist/otel/index.js",
    "./dist/sentry/index.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./otel": {
      "types": "./dist/otel/index.d.ts",
      "import": "./dist/otel/index.js",
      "default": "./dist/otel/index.js"
    },
    "./sentry": {
      "types": "./dist/sentry/index.d.ts",
      "import": "./dist/sentry/index.js",
      "default": "./dist/sentry/index.js"
    },
    "./cronwatch": {
      "types": "./dist/cronwatch/index.d.ts",
      "import": "./dist/cronwatch/index.js",
      "default": "./dist/cronwatch/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup src/index.ts src/otel/index.ts src/sentry/index.ts src/cronwatch/index.ts --format esm --dts --sourcemap --outDir dist --external @opentelemetry/api",
    "dev": "tsup src/index.ts src/otel/index.ts src/sentry/index.ts src/cronwatch/index.ts --format esm --dts --sourcemap --outDir dist --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@athyper/platform-core": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.73.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.215.0",
    "@opentelemetry/resources": "^2.7.0",
    "@opentelemetry/sdk-node": "^0.215.0",
    "@opentelemetry/semantic-conventions": "^1.29.0",
    "@sentry/node": "^10.49.0"
  },
  "devDependencies": {
    "@athyper/tsconfig": "workspace:*",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
