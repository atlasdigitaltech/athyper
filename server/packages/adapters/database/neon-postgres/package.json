{
  "name": "@athyper/adapter-db-neon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup src/index.ts --format esm --dts --outDir dist --external kysely --external pg",
    "dev": "tsup src/index.ts --format esm --dts --outDir dist --watch --external kysely --external pg",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:pull": "node scripts/prisma-pull.mjs --target=neon --schema src/prisma/schema.prisma",
    "prisma:pull:mesh": "node scripts/prisma-pull.mjs --target=mesh --schema src/prisma/schema.mesh.prisma",
    "prisma:pull:admin": "node scripts/prisma-pull.mjs --target=admin --schema src/prisma/schema.admin.prisma",
    "prisma:generate": "node scripts/kysely-generate-from-ast.mjs --schema src/prisma/schema.prisma",
    "prisma:generate:mesh": "node scripts/kysely-generate-from-ast.mjs --schema src/prisma/schema.mesh.prisma",
    "prisma:generate:admin": "node scripts/kysely-generate-from-ast.mjs --schema src/prisma/schema.admin.prisma",
    "codegen": "pnpm run prisma:generate && pnpm run prisma:generate:mesh && pnpm run prisma:generate:admin",
    "db:sync": "pnpm run prisma:pull && pnpm run prisma:pull:mesh && pnpm run prisma:pull:admin && python3 scripts/fix-prisma-relations.py && pnpm run codegen"
  },
  "dependencies": {
    "@athyper/adapter-db-core": "workspace:*",
    "@athyper/foundation-transaction": "workspace:*",
    "kysely": "^0.28.16",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@athyper/tsconfig": "workspace:*",
    "@types/pg": "^8.11.10",
    "@types/node": "^25.6.0",
    "prisma": "^7.7.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.0",
    "typescript": "^6.0.3"
  }
}
