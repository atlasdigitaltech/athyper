generator kysely {
  provider        = "prisma-kysely"
  output          = "../generated/kysely-admin"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["ai", "audit", "authz", "control", "document", "event", "governance", "log", "master", "metadata", "ops", "public", "runtime_meta", "shared", "snapshot"]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
