/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ai_action_policy {
  id                                               String             @id(map: "ai_action_policy_aap_pkey") @default(dbgenerated("shared.uuidv7()")) @db.Uuid
  tenant_id                                        String             @db.Uuid
  action_code                                      String
  doc_class                                        String?
  autonomy_level                                   String             @default("suggest")
  min_confidence_for_auto                          Decimal?           @db.Decimal(5, 4)
  requires_human_confirmation                      Boolean            @default(true)
  override_policy_definition_id                    String?            @db.Uuid
  is_active                                        Boolean            @default(true)
  effective_from                                   DateTime           @default(now()) @db.Timestamptz(6)
  effective_to                                     DateTime?          @db.Timestamptz(6)
  created_at                                       DateTime           @default(now()) @db.Timestamptz(6)
  created_by                                       String             @db.Uuid
  updated_at                                       DateTime?          @db.Timestamptz(6)
  updated_by                                       String?            @db.Uuid
  principal_ai_action_policy_created_byToprincipal principal          @relation("ai_action_policy_created_byToprincipal", fields: [created_by], references: [id], onUpdate: NoAction, map: "ai_action_policy_aap_created_by_fk")
  policy_definition                                policy_definition? @relation(fields: [override_policy_definition_id], references: [id], onUpdate: NoAction, map: "ai_action_policy_aap_override_policy_fk")
  tenant                                           tenant             @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ai_action_policy_aap_tenant_fk")
  principal_ai_action_policy_updated_byToprincipal principal?         @relation("ai_action_policy_updated_byToprincipal", fields: [updated_by], references: [id], onUpdate: NoAction, map: "ai_action_policy_aap_updated_by_fk")

  @@unique([tenant_id, action_code, doc_class], map: "ai_action_policy_aap_natural_uq")
  @@index([tenant_id, action_code, doc_class], map: "ai_action_policy_aap_tenant_action_idx", where: raw("(is_active = true)"))
  @@schema("ai")
}

