generator kysely {
  provider        = "prisma-kysely"
  output          = "../generated/kysely-mesh"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["aggregate", "control", "document", "event", "governance", "ledger", "log", "master", "mesh", "public", "shared", "snapshot"]
}

