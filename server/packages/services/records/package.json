{
  "name": "@athyper/svc-records",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup index.ts --format esm --dts --outDir dist --external express --external kysely --external exceljs",
    "dev": "tsup index.ts --format esm --dts --outDir dist --external express --external kysely --external exceljs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@athyper/adapter-telemetry": "workspace:*",
    "@athyper/api-contracts": "workspace:*",
    "@athyper/cascade": "workspace:*",
    "@athyper/svc-audit": "workspace:*",
    "@athyper/finance-rules": "workspace:*",
    "@athyper/svc-business": "workspace:*",
    "@athyper/svc-finance": "workspace:*",
    "@athyper/svc-iam": "workspace:*",
    "@athyper/svc-jobs": "workspace:*",
    "@athyper/svc-metadata": "workspace:*",
    "@athyper/svc-platform": "workspace:*",
    "@athyper/svc-policy": "workspace:*",
    "@athyper/svc-shared": "workspace:*",
    "@athyper/svc-workflow": "workspace:*",
    "@athyper/platform-temporal": "workspace:*",
    "busboy": "^1.6.0"
  },
  "devDependencies": {
    "@athyper/tsconfig": "workspace:*",
    "@types/busboy": "^1.5.4",
    "@types/express": "^5.0.1",
    "bullmq": "^5.74.1",
    "express": "^5.0.0",
    "kysely": "^0.28.16",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
