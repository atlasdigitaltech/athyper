{
  "name": "@athyper/server-service-publication",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./shared/preview/environment": "./src/shared/preview/environment.ts",
    "./shared/case-contract/model": "./src/shared/case-contract/model.ts",
    "./shared/collections/compiler": "./src/shared/collections/compiler.ts",
    "./kysely-publication-authority-work": "./src/kysely-publication-authority-work.ts",
