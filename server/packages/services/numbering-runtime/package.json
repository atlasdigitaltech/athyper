{
  "name": "@athyper/svc-numbering-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" } },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup index.ts --format esm --dts --outDir dist --external kysely",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@athyper/numbering-policy-contracts": "workspace:*",
    "kysely": "^0.28.16"
  },
  "devDependencies": {
    "@athyper/tsconfig": "workspace:*",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.0",
    "typescript": "6.0.3",
    "vitest": "4.1.4"
  }
}
