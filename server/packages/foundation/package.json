{
  "name": "@athyper/server-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./resilience": {
      "types": "./dist/resilience/index.d.ts",
      "import": "./dist/resilience/index.js",
      "default": "./dist/resilience/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@athyper/adapter-object-storage": "workspace:*",
    "@athyper/adapter-rendering-gotenberg": "workspace:*",
    "@athyper/adapter-rendering-legacy": "workspace:*",
    "@athyper/adapter-telemetry": "workspace:*",
    "@athyper/foundation-crypto": "workspace:*",
    "@athyper/foundation-kernel": "workspace:*",
    "@athyper/foundation-observability": "workspace:*",
    "@athyper/plane-neon-document-rendering": "workspace:*",
    "@athyper/platform-rendering": "workspace:*",
    "@athyper/runtime-http": "workspace:*",
    "@opentelemetry/api": "^1.9.0"
  },
  "devDependencies": {
    "@athyper/tsconfig": "workspace:*",
    "@types/express": "^5.0.1",
    "@types/node": "^25.6.0",
    "express": "^5.0.0",
    "kysely": "^0.28.16",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.0",
    "typescript": "^6.0.3"
  }
}
