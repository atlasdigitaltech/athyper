{
  "name": "@athyper/runtime-http",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup src/index.ts --format esm --dts --outDir dist --external express --external @athyper/adapter-telemetry",
    "dev": "tsup src/index.ts --format esm --dts --outDir dist --external express --external @athyper/adapter-telemetry --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@athyper/adapter-telemetry": "workspace:*"
  },
  "devDependencies": {
    "@athyper/tsconfig": "workspace:*",
    "@types/express": "^5.0.1",
    "@types/node": "^25.6.0",
    "express": "^5.0.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.0",
    "typescript": "^6.0.3"
  }
}
