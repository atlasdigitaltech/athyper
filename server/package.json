{
  "name": "@athyper/server-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter \"@athyper/server-*\" --if-present run build",
    "typecheck": "pnpm --filter \"@athyper/server-*\" --if-present run typecheck",
    "test": "pnpm --filter \"@athyper/server-*\" --if-present run test",
    "dev": "pnpm --filter @athyper/server-platform-host run dev",
    "dev:worker": "pnpm --filter @athyper/server-platform-host run dev:worker",
    "dev:scheduler": "pnpm --filter @athyper/server-platform-host run dev:scheduler"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
