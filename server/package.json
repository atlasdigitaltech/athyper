{
  "name": "@athyper/runtime-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "dev:worker": "MODE=worker tsx watch src/app.ts",
    "dev:scheduler": "MODE=scheduler tsx watch src/app.ts",
    "start": "node dist/src/app.js",
    "start:api": "node dist/src/app.js",
    "start:worker": "MODE=worker node dist/src/app.js",
    "start:scheduler": "MODE=scheduler node dist/src/app.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "rls:verify": "tsx scripts/verify-rls.ts",
    "field-security:verify": "tsx scripts/verify-field-security.ts",
    "lookup:diff": "tsx scripts/lookup-diff.ts"
  },
  "dependencies": {
    "@athyper/adapter-auth": "workspace:*",
    "@athyper/adapter-db": "workspace:*",
    "@athyper/adapter-memorycache": "workspace:*",
    "@athyper/adapter-objectstorage": "workspace:*",
    "@athyper/svc-collab": "workspace:*",
    "@athyper/svc-documents": "workspace:*",
    "@athyper/svc-finance": "workspace:*",
    "@athyper/svc-iam": "workspace:*",
    "@athyper/svc-jobs": "workspace:*",
    "@athyper/svc-metadata": "workspace:*",
    "@athyper/svc-platform": "workspace:*",
    "@athyper/svc-records": "workspace:*",
    "@athyper/svc-shared": "workspace:*",
    "bullmq": "^5.74.1",
    "dotenv": "^17.4.2",
    "express": "^5.0.0",
    "kysely": "^0.28.16",
    "nodemailer": "^8.0.5",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.11.10",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
