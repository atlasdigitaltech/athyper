# =============================================
# Athyper Runtime API Server — Environment
# =============================================
# Copy to .env for local development:
#   cp .env.example .env
#
# For Docker (stack): values are set in stack/env/.env
# For localhost dev: override with local addresses

# Server
PORT=4000
# NODE_ENV controls stack-trace exposure in error responses.
# 'development' (default when unset) shows full stack traces.
# Set to 'production' in staging/prod Docker builds to suppress them.
NODE_ENV=development

# Database (PostgreSQL via PgBouncer)
# Docker:    postgresql://athyperadmin:athyperadmin@dbpool-apps:6432/athyper_neon
# Localhost: postgresql://athyperadmin:athyperadmin@localhost:6432/athyper_neon
# Use 127.0.0.1 on Windows instead of localhost (IPv6 ::1 vs IPv4 bind mismatch).
DATABASE_URL=postgresql://athyperadmin:athyperadmin@127.0.0.1:6432/athyper_neon

# Direct Postgres connection (bypasses PgBouncer — required for DDL migrations).
# Must point at port 5432 (not the pooler 6432). Used by tsx db/seed/migrate.ts.
DATABASE_ADMIN_URL=postgresql://athyperadmin:athyperadmin@127.0.0.1:5432/athyper_neon

# Connection pool size (keep low — PgBouncer handles the real pool)
DB_POOL_MAX=5

# Redis (session cache)
# Docker:    redis://:athyperadmin@memorycache:6379/0
# Localhost: redis://:athyperadmin@localhost:6379/0
# Use 127.0.0.1 on Windows (same IPv6 reason as DATABASE_URL above).
REDIS_URL=redis://app:athyperadmin@127.0.0.1:6379/0
# Optional: dedicated Redis URL for BullMQ (queues, workers, schedulers).
# Unset ⇒ BullMQ reuses REDIS_URL (same server, same db index) but with its own
# connection options (maxRetriesPerRequest: null, as required by BullMQ Workers).
# Set this to point BullMQ at a different db index (e.g. .../1) or a dedicated
# Redis instance so a reconnect storm or READONLY error on the cache client
# cannot cascade to job coordination (and vice versa).
# REDIS_BULLMQ_URL=redis://app:athyperadmin@127.0.0.1:6379/1
# Redis client tuning (all optional — defaults shown)
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_MAX_RETRIES=2
REDIS_ERROR_LOG_COOLDOWN_MS=10000

# Keycloak / IAM
# The server accepts two naming conventions via a fallback chain in app.ts:
#   Docker stack (injected by athyper-apps.yml compose service):
#     IAM_ISSUER_URL, IAM_CLIENT_ID, IAM_CLIENT_SECRET, IAM_DEFAULT_REALM
#     → IAM_ISSUER_URL takes precedence when set; no KEYCLOAK_* vars needed in Docker.
#   Local dev (set these below when running server directly outside Docker):
#     KEYCLOAK_BASE_URL + KEYCLOAK_REALM (constructs issuer URL), KEYCLOAK_CLIENT_ID, KEYCLOAK_CLIENT_SECRET
KEYCLOAK_BASE_URL=https://iam.athyper.local
KEYCLOAK_REALM=athyper
KEYCLOAK_CLIENT_ID=athyper-api-runtime
KEYCLOAK_CLIENT_SECRET=

# Object storage (MinIO/S3) — optional; omit S3_ENDPOINT to disable attachments.
# When running the server on the HOST (outside Docker), use 127.0.0.1:9000
# (MinIO port-forwarded from the stack). The Docker-internal hostname
# 'objectstorage:9000' only resolves inside the athyper-internal network.
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_ACCESS_KEY=athyperadmin
# S3_SECRET_KEY=athyperadmin
# S3_REGION=us-east-1
# S3_BUCKET=athyper-local
# S3_USE_SSL=false
# In local dev APP_S3_* == root creds; set to scoped MinIO user in staging/prod.
# APP_S3_ACCESS_KEY=athyperadmin
# APP_S3_SECRET_KEY=athyperadmin
# Multipart upload tuning (all optional — defaults shown)
# S3_MULTIPART_PART_SIZE_MB=5
# S3_MULTIPART_QUEUE_SIZE=4
# S3_MAX_UPLOAD_MB=100
# S3_PRESIGNED_TTL_SECONDS=900

# IAM outbox worker polling interval (ms)
OUTBOX_POLL_MS=10000

# Disable TLS verification for local dev (self-signed stack certs)
NODE_TLS_REJECT_UNAUTHORIZED=0

# Error tracking — GlitchTip (Sentry-SDK-compatible).
# Leave unset to disable. DSN is generated in the GlitchTip admin UI after
# creating a project; format: https://<public-key>@errors.athyper.local/<project-id>
# GLITCHTIP_DSN=
# Perf trace sample rate (0.0-1.0). 0 = errors only, no performance data.
# SENTRY_TRACES_SAMPLE_RATE=0

# Distributed tracing — OpenTelemetry → Tempo (OTLP/gRPC).
# Leave OTEL_EXPORTER_OTLP_ENDPOINT unset to disable: initOtel() is a no-op and
# auto-instrumentations do not load. Set to point at Tempo (Docker hostname
# `tracing` or localhost when running server outside Docker).
#   Docker:    http://tracing:4317
#   Localhost: http://127.0.0.1:4317  (requires tempo port-forward)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://tracing:4317
# Service name override. Falls back to SERVICE_NAME, then "athyper-runtime".
# OTEL_SERVICE_NAME=athyper-runtime
# Head-based sampling ratio (0.0-1.0). 1.0 = sample every trace.
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=1.0

# Cross-entity search — Meilisearch (Track B2).
# Leave unset to disable — /api/search returns 503 and the future indexing
# worker is inert.
# Master key doubles as the tenant-token signing key in Slice A; future
# hardening will mint a scoped "search" API key in Meilisearch.
# MEILISEARCH_URL=http://meilisearch:7700
# MEILISEARCH_MASTER_KEY=

# PDF rendering — Gotenberg (HTML/Office → PDF).
# Preferred over the legacy RENDERER_BASE_URL path. Internal-only service.
# Leave unset to fall back to the legacy PdfRendererClient; unset both to
# disable PDF rendering entirely.
# GOTENBERG_BASE_URL=http://gotenberg:3000

# Cron heartbeat — self-hosted Healthchecks.
# Base URL for Healthchecks pings (append /<slug> for success, /<slug>/fail for failure).
# Leave unset to disable — job hooks become no-ops.
# Slug format: <queue-name>-<job-name>, e.g. "jobs-notifications-sweep"
# HEALTHCHECKS_BASE_URL=https://healthchecks.athyper.local/ping
