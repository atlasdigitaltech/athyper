# =============================================
# Athyper Runtime Server - Local Development
# =============================================
# This file is copied to server/.env by:
#   stack/scripts/setup/setup-env.bat local server
#   stack/scripts/setup/setup-env.sh local server
#
# Use host-reachable endpoints here. Docker Compose service names such as
# memorycache and dbpool-apps only resolve inside the Docker network.

# =============================================
# SERVER
# =============================================
ENVIRONMENT=local
NODE_ENV=development
NODE_TLS_REJECT_UNAUTHORIZED=0
PORT=4000
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT_MS=15000
MULTITENANT=TRUE

# =============================================
# DATABASE
# =============================================
DATABASE_URL=postgresql://athyperadmin:athyperadmin@127.0.0.1:6432/athyper_neon?sslmode=disable
DATABASE_ADMIN_URL=postgresql://athyperadmin:athyperadmin@127.0.0.1:5432/athyper_neon?sslmode=disable
MESH_DATABASE_URL=postgresql://athyperadmin:athyperadmin@127.0.0.1:6432/athyper_mesh?sslmode=disable
DB_POOL_MAX=5

# =============================================
# CACHE
# =============================================
REDIS_URL=redis://app:athyperadmin@127.0.0.1:6379/0
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_MAX_RETRIES=2
REDIS_ERROR_LOG_COOLDOWN_MS=10000
# REDIS_BULLMQ_URL=redis://app:athyperadmin@127.0.0.1:6379/0

# =============================================
# IAM
# =============================================
IAM_ISSUER_URL=https://iam.athyper.local/realms/athyper
IAM_CLIENT_ID=athyper-api
IAM_CLIENT_SECRET=athyperadmin
IAM_DEFAULT_REALM=athyper
ATHYPER_SUPER__IAM_SECRET__IAM_ATHYPER_CLIENT_SECRET=athyperadmin
AUTH_DEBUG_EXPOSE_TOKENS=true

# =============================================
# OBJECT STORAGE
# =============================================
# Feature flags for attachment hardening rollout (Phase 0).
# Enable temporarily to collect strict telemetry and exercise stricter checks safely.
ATTACHMENT_AUTH_STRICT=false
ATTACHMENT_MULTIPART_CLEANUP_STRICT=false

S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=athyperadmin
S3_SECRET_KEY=athyperadmin
APP_S3_ACCESS_KEY=athyperadmin
APP_S3_SECRET_KEY=athyperadmin
S3_REGION=us-east-1
S3_BUCKET=athyper-local
S3_USE_SSL=false
S3_MULTIPART_PART_SIZE_MB=5
S3_MULTIPART_QUEUE_SIZE=4
S3_MAX_UPLOAD_MB=100
S3_PRESIGNED_TTL_SECONDS=900

# =============================================
# KERNEL CONFIG
# =============================================
# Leave ATHYPER_KERNEL_CONFIG_PATH blank for env-var-only local API starts.
# Uncomment after running stack/scripts/setup/setup-config.* local if you need
# the multi-realm kernel config locally.
# ATHYPER_CONFIG=D:/Stack/athyper/config
# ATHYPER_KERNEL_CONFIG_PATH=apps/kernel.config.local.parameter.json

# =============================================
# LOCAL-OPTIONAL SERVICES
# =============================================
CREDENTIAL_MASTER_KEY=
# SEARCHCORE_URL=http://127.0.0.1:7700
# SEARCHCORE_MASTER_KEY=athyperadmin-meili-local-change-me
# DOCPARSER_URL=http://127.0.0.1:9998
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
# P5 EntityQueryService rollout. Keep the pilot list empty until shadow parity
# and EXPLAIN (ANALYZE, BUFFERS) evidence are approved for each entity.
ENTITY_QUERY_V1_PILOTS=company_code
# Production must use a managed random secret; changing it invalidates cursors.
ENTITY_QUERY_CURSOR_SECRET=

# P6 mutation kernel. Shadow is the safe default and never performs a second
# authoritative write. Promote tenant cohorts only after comparison evidence.
MUTATION_KERNEL_STAGE=shadow_validation
MUTATION_KERNEL_INTERNAL_TENANTS=
MUTATION_KERNEL_EXTERNAL_COHORT=
