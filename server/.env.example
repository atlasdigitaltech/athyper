# =============================================
# Athyper Server Platform Host - Local
# =============================================
# This file is copied to server/.env by:
#   stack/scripts/setup/setup-env.bat local server
#   stack/scripts/setup/setup-env.sh local server
#
# Use host-reachable endpoints here. Docker Compose service names such as
# memorycache and dbpool-apps only resolve inside the Docker network.

# =============================================
# SERVER
# =============================================
ENVIRONMENT=local
NODE_ENV=development
NODE_TLS_REJECT_UNAUTHORIZED=0
PORT=4000
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT_MS=15000
MULTITENANT=TRUE

# =============================================
# DATABASE
# =============================================
DATABASE_URL=postgresql://athyperadmin:athyperadmin@127.0.0.1:6432/athyper_neon?sslmode=disable
DATABASE_ADMIN_URL=postgresql://athyperadmin:athyperadmin@127.0.0.1:5432/athyper_neon?sslmode=disable
MESH_DATABASE_URL=postgresql://athyperadmin:athyperadmin@127.0.0.1:6432/athyper_mesh?sslmode=disable
DB_POOL_MAX=5

# =============================================
# CACHE
# =============================================
REDIS_URL=redis://app:athyperadmin@127.0.0.1:6379/0
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_MAX_RETRIES_PER_REQUEST=2
REDIS_KEY_PREFIX=athyper:
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_MAX_RETRIES=2
REDIS_ERROR_LOG_COOLDOWN_MS=10000
# REDIS_BULLMQ_URL=redis://app:athyperadmin@127.0.0.1:6379/0
# Local development may share REDIS_URL by default. Set false to require a dedicated URL.
ALLOW_SHARED_BULLMQ_REDIS=true
JOB_WORKER_CONCURRENCY=10

# =============================================
# IAM
# =============================================
IAM_ISSUER_URL=https://iam.athyper.local/realms/athyper
IAM_CLIENT_ID=athyper-api
KEYCLOAK_JWKS_CACHE_TTL_MS=600000
AUTH_CLAIM_FIRST_CONTEXT=shadow
AUTH_REQUIRE_AUTHORIZED_ROLE=true
AUTH_VERIFY_ENFORCE_REQUIRED_ACTIONS=true
# AUTH_REQUIRED_ACTIONS_MATRIX={"UPDATE_PASSWORD":["/api/"]}
IAM_CLIENT_SECRET=athyperadmin
IAM_DEFAULT_REALM=athyper
ATHYPER_SUPER__IAM_SECRET__IAM_ATHYPER_CLIENT_SECRET=athyperadmin
AUTH_DEBUG_EXPOSE_TOKENS=true
AUTH_DISCOVERY_SHARED_SECRET=athyperadmin
AUTH_DISCOVERY_STAGE1_VERIFICATION_MODE=disabled
AUTH_DISCOVERY_TOKEN_TTL_SECONDS=900
AUTH_DISCOVERY_RESEND_COOLDOWN_SECONDS=30
AUTH_DISCOVERY_VERIFIED_TRUST_TTL_DAYS=30
AUTH_DISCOVERY_USERNAME_EMAIL_DOMAINS=athyper.demo

# =============================================
# OBJECT STORAGE
# =============================================
# Feature flags for attachment hardening rollout (Phase 0).
# Enable temporarily to collect strict telemetry and exercise stricter checks safely.
ATTACHMENT_AUTH_STRICT=false
ATTACHMENT_MULTIPART_CLEANUP_STRICT=false

S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=athyperadmin
S3_SECRET_KEY=athyperadmin
APP_S3_ACCESS_KEY=athyperadmin
APP_S3_SECRET_KEY=athyperadmin
S3_REGION=us-east-1
S3_BUCKET=athyper-local
S3_USE_SSL=false
S3_MULTIPART_PART_SIZE_MB=5
S3_MULTIPART_QUEUE_SIZE=4
S3_MAX_UPLOAD_MB=100
S3_PRESIGNED_TTL_SECONDS=900

# =============================================
# KERNEL CONFIG
# =============================================
# Leave ATHYPER_KERNEL_CONFIG_PATH blank for env-var-only local API starts.
# Uncomment after running stack/scripts/setup/setup-config.* local if you need
# the multi-realm kernel config locally.
# ATHYPER_CONFIG=D:/Stack/athyper/config
# ATHYPER_KERNEL_CONFIG_PATH=apps/kernel.config.local.parameter.json

# =============================================
# LOCAL-OPTIONAL SERVICES
# =============================================
CREDENTIAL_MASTER_KEY=
# SEARCHCORE_URL=http://127.0.0.1:7700
# SEARCHCORE_MASTER_KEY=athyperadmin-meili-local-change-me
# SEARCHCORE_DOCUMENT_INDEX=documents
# SEARCHCORE_TIMEOUT_MS=10000
# DOCPARSER_URL=http://127.0.0.1:9998
# DOCPARSER_TIMEOUT_MS=120000
# DOCPARSER_MAX_INPUT_BYTES=52428800
# DOCPARSER_MAX_TEXT_CHARS=5000000
# DOCRENDER_BASE_URL=http://127.0.0.1:3000
# DOCRENDER_TIMEOUT_MS=120000
# DOCRENDER_MAX_HTML_BYTES=5242880
# DOCRENDER_MAX_PDF_BYTES=52428800
# CLAMD_HOST=127.0.0.1
# CLAMD_PORT=3310
# CLAMD_TIMEOUT_MS=30000
# CLAMD_MAX_BYTES=104857600
# CLAMD_ON_UNAVAILABLE=fail-closed
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
OTEL_AUTO_INSTRUMENTATIONS_ENABLED=false

# Notification transports are optional. Configure a complete block to register
# that channel in the platform-host notification registry.
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@athyper.local
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# TWILIO_MESSAGING_SERVICE_SID=
# META_WHATSAPP_API_VERSION=
# META_WHATSAPP_PHONE_NUMBER_ID=
# META_WHATSAPP_ACCESS_TOKEN=
# META_WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
# PUSH_FCM_PROJECT_ID=
# PUSH_FCM_CLIENT_EMAIL=
# PUSH_FCM_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:no-reply@athyper.local
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# P5 EntityQueryService rollout. Keep the pilot list empty until shadow parity
# and EXPLAIN (ANALYZE, BUFFERS) evidence are approved for each entity.
# Required: use at least 32 random UTF-8 bytes. Production must source this
# from a secrets manager; changing it invalidates in-flight cursors.
ENTITY_QUERY_CURSOR_SECRET=
ENTITY_QUERY_V1_PILOTS=company_code

# P6 mutation kernel. Shadow is the safe default and never performs a second
# authoritative write. Promote tenant cohorts only after comparison evidence.
MUTATION_KERNEL_STAGE=shadow_validation
MUTATION_KERNEL_INTERNAL_TENANTS=
MUTATION_KERNEL_EXTERNAL_COHORT=

# =============================================
# ATLAS AGENT (disabled by default)
# =============================================
# This environment gate and control.feature_flag.atlas_agent_enabled must both
# be enabled. Grant ai.agent.use explicitly to supervised internal evaluators.
ATLAS_AGENT_ENABLED=true
# Admin product help has a second independent application gate.
ATLAS_AGENT_ADMIN_ENABLED=true
ANTHROPIC_API_KEY=
# Server-only HMAC key for non-reversible credential fingerprints (32+ chars).
ATLAS_AGENT_CREDENTIAL_FINGERPRINT_KEY=
ATLAS_BYOK_ENABLED=false
ATLAS_BYOK_BACKEND=disabled
ATLAS_BYOK_FINGERPRINT_KEY=
ATLAS_BYOK_CACHE_TTL_MS=30000
ATLAS_AGENT_DEFAULT_PUBLIC_MODEL=atlas-fast
ATLAS_AGENT_ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
ATLAS_AGENT_ANTHROPIC_BALANCED_MODEL=claude-sonnet-4-6
ATLAS_AGENT_ANTHROPIC_BEST_MODEL=claude-opus-4-8
# Internal OpenAI evaluation binding. It remains non-default, accepts only
# public-classified content, and additionally requires the canonical
# ai.agent.provider_diagnostics permission. That permission does not classify
# or sanitize prompt content.
OPENAI_PROVIDER_ENABLED=false
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_TIMEOUT_MS=60000
ATLAS_AGENT_OPENAI_EVAL_MODEL=gpt-5.6-sol
GEMINI_PROVIDER_ENABLED=false
GEMINI_API_KEY=
GEMINI_PROJECT_ID=
GEMINI_EVAL_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=60000
GEMINI_ACCOUNT_CLASS=
GEMINI_PROVIDER_REGION=global
ATLAS_AGENT_PROVIDER_TIMEOUT_MS=60000
ATLAS_AGENT_STREAM_IDLE_TIMEOUT_MS=30000
ATLAS_AGENT_MAX_OUTPUT_TOKENS=2048
ATLAS_AGENT_MAX_OUTPUT_BYTES=131072
ATLAS_AGENT_USER_RUNS_PER_MINUTE=10
ATLAS_AGENT_TENANT_RUNS_PER_MINUTE=100
# Governed Atlas tools require durable conversation persistence, this server
# gate, the tenant/per-tool flags, and the exact tool permission. The initial
# release is read-only.
ATLAS_AGENT_TOOLS_ENABLED=false
ATLAS_AGENT_TOOL_MAX_ROUNDS=3
ATLAS_AGENT_TOOL_MAX_CALLS=4
ATLAS_AGENT_TOOL_MAX_ELAPSED_MS=120000
ATLAS_AGENT_TOOL_MAX_TOTAL_TOKENS=32768
ATLAS_AGENT_TOOL_TIMEOUT_MS=10000
ATLAS_AGENT_TOOL_MAX_INPUT_BYTES=32768
ATLAS_AGENT_TOOL_MAX_RESULT_BYTES=32768
# Durable Atlas history is independently gated and remains off until the
# schema, RLS, purge job, tenant flag, and retention notice are approved.
ATLAS_CONVERSATION_PERSISTENCE_ENABLED=false
# Sensitive retained content requires tenant_protected_store plus an approved,
# server-injected protected-content store. The default is non-sensitive only.
ATLAS_CONVERSATION_CONTENT_PROTECTION_MODE=database_at_rest_non_sensitive_only
# Separate privileged connection for retention scheduler/worker processes.
# Never inject this URL into the API or browser/app environments.
ATLAS_CONVERSATION_MAINTENANCE_DATABASE_URL=
ATLAS_CONVERSATION_RETENTION_DAYS=30
ATLAS_CONVERSATION_MIN_RETENTION_DAYS=1
ATLAS_CONVERSATION_MAX_RETENTION_DAYS=365
ATLAS_CONVERSATION_CONTEXT_MAX_MESSAGES=20
ATLAS_CONVERSATION_CONTEXT_MAX_CHARACTERS=98304
ATLAS_CONVERSATION_STALE_RUN_TIMEOUT_MS=900000
ATLAS_CONVERSATION_PURGE_BATCH_SIZE=500
