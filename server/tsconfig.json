{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "declaration": false,
    "sourceMap": true,
    "resolveJsonModule": true,
    "paths": {
      "@athyper/adapter-db-core": ["./packages/adapters/database/core/src/index.ts"],
      "@athyper/adapter-db-neon": ["./packages/adapters/database/neon-postgres/src/index.ts"],
      "@athyper/adapter-db-athyper": ["./packages/adapters/database/athyper-postgres/src/index.ts"],
      "@athyper/adapter-db-mesh": ["./packages/adapters/database/mesh-postgres/src/index.ts"],
      "@athyper/server-foundation": ["./packages/foundation/index.ts"],
      "@athyper/server-foundation/kernel": ["./packages/foundation/kernel/src/index.ts"],
      "@athyper/server-foundation/kernel/resilience": ["./packages/foundation/kernel/src/resilience/index.ts"],
      "@athyper/server-foundation/context": ["./packages/foundation/context/src/index.ts"],
      "@athyper/server-foundation/tenancy": ["./packages/foundation/tenancy/src/index.ts"],
      "@athyper/server-foundation/transaction": ["./packages/foundation/transaction/src/index.ts"],
      "@athyper/server-foundation/crypto": ["./packages/foundation/crypto/src/index.ts"],
      "@athyper/server-foundation/cache": ["./packages/foundation/cache/src/index.ts"],
      "@athyper/server-foundation/storage": ["./packages/foundation/storage/src/index.ts"],
      "@athyper/server-foundation/observability": ["./packages/foundation/observability/src/index.ts"],
      "@athyper/server-foundation/monitoring/*": ["./packages/foundation/monitoring/*.ts"],
      "@athyper/svc-shared":    ["./packages/services/shared/index.ts"],
      "@athyper/svc-iam":       ["./packages/platform/iam/index.ts"],
      "@athyper/svc-metadata":  ["./packages/services/metadata/index.ts"],
      "@athyper/svc-meta-entity-authoring": ["./packages/services/meta-entity-authoring/index.ts"],
      "@athyper/svc-numbering-runtime": ["./packages/services/numbering-runtime/index.ts"],
      "@athyper/plane-athyper-onboarding": ["./packages/planes/athyper/onboarding/index.ts"],
      "@athyper/svc-publication": ["./packages/services/publication/index.ts"],
      "@athyper/svc-records":   ["./packages/services/records/index.ts"],
      "@athyper/svc-documents": ["./packages/platform/documents/index.ts"],
      "@athyper/svc-collab":    ["./packages/platform/collaboration/index.ts"],
      "@athyper/svc-jobs":      ["./packages/platform/jobs/index.ts"],
      "@athyper/svc-finance":   ["./packages/services/finance/index.ts"],
      "@athyper/svc-platform":  ["./packages/services/platform/index.ts"],
      "@athyper/svc-search":    ["./packages/platform/search/index.ts"],
      "@athyper/svc-ai":        ["./packages/platform/ai/index.ts"],
      "@athyper/svc-audit":     ["./packages/platform/audit/index.ts"],
      "@athyper/svc-business":  ["./packages/services/business/index.ts"],
      "@athyper/svc-content":   ["./packages/services/content/index.ts"],
      "@athyper/svc-doc-services": ["./packages/services/doc-services/index.ts"],
      "@athyper/svc-integration": ["./packages/platform/events/index.ts"],
      "@athyper/svc-master":    ["./packages/services/master/index.ts"],
      "@athyper/svc-policy":    ["./packages/platform/policy/index.ts"],
      "@athyper/svc-workflow":  ["./packages/platform/workflow/index.ts"],
      "@athyper/platform-notifications": ["./packages/platform/notifications/src/index.ts"],
      "@athyper/platform-rendering": ["./packages/platform/rendering/src/index.ts"],
      "@athyper/platform-rules": ["./packages/platform/rules/index.ts"]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "packages/adapters",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
