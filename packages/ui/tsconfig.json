{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tooling/tsconfig/base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true
  },
  "include": ["src"],
  "exclude": [
    "dist",
    "node_modules",
    ".turbo",
    "src/**/*.stories.tsx",
    "src/**/*.test.tsx",
    "src/**/__tests__/**"
  ]
}
