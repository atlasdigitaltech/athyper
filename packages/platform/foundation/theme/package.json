{
  "name": "@athyper/platform-theme",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.tsx",
  "types": "./src/index.tsx",
  "sideEffects": [
    "./src/styles.css"
  ],
  "exports": {
    ".": "./src/index.tsx",
    "./tokens": "./src/tokens.ts",
    "./colour-validator": "./src/colour-validator.ts",
    "./styles.css": "./src/styles.css",
    "./tailwind.css": "./src/tailwind.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/colour-validator.test.ts src/chart-colors.test.ts",
    "iam:build": "tsx scripts/build-iam-css.ts",
    "docs-theme:build": "tsx scripts/build-docs-css.ts",
    "docs-theme:check": "tsx scripts/build-docs-css.ts --check",
    "iam:check": "tsx scripts/build-iam-css.ts --check"
  },
  "dependencies": {
    "@athyper/platform-brand": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.2.5"
  },
  "devDependencies": {
    "@athyper/config": "workspace:*",
    "@types/react": "^19.2.14",
    "react": "^19.2.5",
    "typescript": "^6.0.3"
  }
}
