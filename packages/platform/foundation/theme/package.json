{
  "name": "@athyper/platform-theme",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./src": "./src/index.ts",
    "./src/*": "./src/*",
    "./brand-palette": "./src/brand-palette.ts",
    "./base.css": "./src/base.css",
    "./all.css": "./src/all.css",
    "./stable-chrome.css": "./src/stable-chrome.css",
    "./tokens.css": "./src/tokens/athyper.tokens.css",
    "./presets/base.css": "./src/presets/base.css",
    "./presets/athyper-base.css": "./src/presets/athyper-base.css",
    "./presets/neon-base.css": "./src/presets/neon-base.css",
    "./presets/neon-modern.css": "./src/presets/neon-modern.css",
    "./presets/neon-mono.css": "./src/presets/neon-mono.css",
    "./presets/neon-tangerine.css": "./src/presets/neon-tangerine.css",
    "./presets/mesh-night.css": "./src/presets/mesh-night.css",
    "./presets/mesh-bloom.css": "./src/presets/mesh-bloom.css",
    "./presets/athyper-pop.css": "./src/presets/athyper-pop.css",
    "./presets/athyper-bubble.css": "./src/presets/athyper-bubble.css",
    "./presets/atlas-neo.css": "./src/presets/atlas-neo.css",
    "./presets/atlas-doom.css": "./src/presets/atlas-doom.css",
    "./presets/atlas-vintage.css": "./src/presets/atlas-vintage.css",
    "./presets": "./src/presets/registry.ts",
    "./tailwind-preset": "./src/tailwind-preset.ts",
    "./typography": "./src/typography.ts",
    "./semantic-colors": "./src/semantic-colors.ts",
    "./utils": "./src/utils.ts",
    "./contracts": "./src/theme-contract.ts",
    "./validator": "./src/preset-validator.ts",
    "./record-badge": "./src/record-badge.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typography:generate": "tsx src/typography.generate.ts",
    "check:typography": "pnpm run typography:generate && git diff --exit-code -- src/typography.generated.css",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "validate-presets": "tsx src/preset-validator.cli.ts --check-shipped"
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "tailwindcss": "^4.0.0",
    "tailwind-merge": "^3.5.0"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@athyper/config": "workspace:*",
    "@types/node": "^25.6.0",
    "geist": "^1.7.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "4.1.4"
  }
}
