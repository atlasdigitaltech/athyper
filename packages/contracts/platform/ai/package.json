{
  "name": "@athyper/contract-platform-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./intent": "./src/intent.ts",
    "./feedback": "./src/feedback.ts",
    "./answer": "./src/answer.ts",
    "./insights": "./src/insights.ts",
    "./business-context": "./src/business-context.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && esbuild src/index.ts --bundle --format=esm --platform=browser --outfile=dist/index.js",
    "test": "vitest run"
  },
  "devDependencies": {
    "@athyper/tsconfig": "workspace:*",
    "typescript": "^6.0.3",
    "esbuild": "^0.27.7",
    "vitest": "^4.1.4"
  }
}
