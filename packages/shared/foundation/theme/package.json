{
  "name": "@athyper/theme",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./base.css": "./src/base.css",
    "./presets/*.css": "./src/presets/*.css",
    "./tailwind-preset": "./src/tailwind-preset.ts",
    "./semantic-colors": "./src/semantic-colors.ts",
    "./utils": "./src/utils.ts",
    "./contracts": "./src/theme-contract.ts",
    "./presets": "./src/presets/registry.ts",
    "./validator": "./src/preset-validator.ts",
    "./domain-intents": "./src/domain-intents.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "validate-presets": "tsx src/preset-validator.cli.ts --check-shipped"
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "tailwind-merge": "^3.5.0"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@athyper/config": "workspace:*",
    "@types/node": "^25.6.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3"
  }
}
