sender_principal_arns = [
  "arn:aws:iam::111111111111:role/athyper-stg-notification-worker",
]
consumer_principal_arns = [
  "arn:aws:iam::111111111111:role/athyper-stg-ses-event-consumer",
]

tags = {
  Owner      = "communications"
  CostCenter = "platform"
}
