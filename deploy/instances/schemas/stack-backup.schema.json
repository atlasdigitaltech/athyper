{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://athyper.io/schemas/stack-backup-v1alpha1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "athyper.io/v1alpha1" },
    "kind": { "const": "StackBackup" },
    "metadata": { "type": "object", "additionalProperties": false, "required": ["instance", "id"], "properties": { "instance": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" }, "id": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z$" } } },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createdAt", "project", "sourceRevision", "database"],
      "properties": {
        "createdAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
        "project": { "type": "string", "pattern": "^athyper-[a-z0-9-]+$" },
        "sourceRevision": { "type": "string", "pattern": "^(working-tree|unknown|[a-f0-9]{40})$" },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "globals", "dumps"],
          "properties": {
            "format": { "const": "postgres-custom-per-database" },
            "globals": { "$ref": "#/definitions/artifact" },
            "dumps": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "allOf": [
                { "contains": { "type": "object", "required": ["database"], "properties": { "database": { "const": "athyper_iam" } } } },
                { "contains": { "type": "object", "required": ["database"], "properties": { "database": { "const": "athyper_neon" } } } },
                { "contains": { "type": "object", "required": ["database"], "properties": { "database": { "const": "athyper_mesh" } } } },
                { "contains": { "type": "object", "required": ["database"], "properties": { "database": { "const": "athyper_studio" } } } }
              ],
              "items": {
                "allOf": [
                  { "$ref": "#/definitions/artifact" },
                  { "type": "object", "required": ["database"], "properties": { "database": { "enum": ["athyper_iam", "athyper_neon", "athyper_mesh", "athyper_studio"] } } }
                ]
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "sizeBytes"],
      "properties": {
        "file": { "type": "string", "pattern": "^[a-z0-9_-]+\\.(sql|dump)$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "database": { "enum": ["athyper_iam", "athyper_neon", "athyper_mesh", "athyper_studio"] }
      }
    }
  }
}
