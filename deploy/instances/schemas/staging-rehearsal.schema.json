{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://athyper.io/schemas/staging-rehearsal-v1alpha1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "athyper.io/v1alpha1" },
    "kind": { "const": "StagingRehearsal" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" } }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceInstance", "targetInstance", "promotion", "data", "integrations", "migration", "notifications"],
      "properties": {
        "sourceInstance": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "targetInstance": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "promotion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rebuildAllowed", "requiredImageIds", "requireExactDigests", "requireSourceRevisionMatch"],
          "properties": {
            "rebuildAllowed": { "const": false },
            "requiredImageIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
            "requireExactDigests": { "const": true },
            "requireSourceRevisionMatch": { "const": true }
          }
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["classification", "manifest", "prohibitedContent"],
          "properties": {
            "classification": { "const": "sanitized" },
            "manifest": { "type": "string", "pattern": "^stg/[a-z0-9./-]+\\.json$" },
            "prohibitedContent": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
          }
        },
        "integrations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["defaultAction", "allowedDestinations", "productionCredentialsAllowed"],
          "properties": {
            "defaultAction": { "const": "deny" },
            "allowedDestinations": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 3 } },
            "productionCredentialsAllowed": { "const": false }
          }
        },
        "migration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["backupReceipt", "restoreReceipt", "backupMustPrecedeMigration", "restoreDrillRequired"],
          "properties": {
            "backupReceipt": { "type": "string", "pattern": "^stg/[a-z0-9./-]+\\.json$" },
            "restoreReceipt": { "type": "string", "pattern": "^stg/[a-z0-9./-]+\\.json$" },
            "backupMustPrecedeMigration": { "const": true },
            "restoreDrillRequired": { "const": true }
          }
        },
        "notifications": {
          "type": "object",
          "additionalProperties": false,
          "required": ["providerReadiness", "emailCanary", "webPushCanary", "failureExercise"],
          "properties": {
            "providerReadiness": { "type": "string", "pattern": "^stg/[a-z0-9./-]+\\.json$" },
            "emailCanary": { "type": "string", "pattern": "^stg/[a-z0-9./-]+\\.json$" },
            "webPushCanary": { "type": "string", "pattern": "^stg/[a-z0-9./-]+\\.json$" },
            "failureExercise": { "type": "string", "pattern": "^stg/[a-z0-9./-]+\\.json$" }
          }
        }
      }
    }
  }
}
