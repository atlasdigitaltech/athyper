{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://athyper.io/schemas/cold-start-qualification-v1alpha1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "checkedAt", "bootedAt", "bootAgeMinutes", "maximumBootAgeMinutes", "administrator", "defenderPlatform", "defenderEngine", "defenderSignatures", "antivirusEnabled", "realTimeProtectionEnabled", "platformUpdatesChannel", "platformUpdatesChannelExpected", "bitLockerC", "bitLockerD", "secureBoot", "ubuntuColdStartExitCode", "dockerDistroColdStartExitCode", "dockerDesktopStartRequested", "dockerDesktopStartExitCode", "dockerEngineReady", "dockerEngineVersion", "dockerVhdCountOnDataDrive", "passed", "failures"],
  "properties": {
    "apiVersion": { "const": "athyper.io/v1alpha1" },
    "kind": { "const": "ColdStartQualification" },
    "checkedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
    "bootedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
    "bootAgeMinutes": { "type": "number", "minimum": 0 },
    "maximumBootAgeMinutes": { "type": "integer", "minimum": 1, "maximum": 120 },
    "administrator": { "const": true },
    "defenderPlatform": { "type": "string", "pattern": "^(?!4\\.18\\.26070\\.9$)[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "defenderEngine": { "type": "string", "pattern": "^(?!0\\.0\\.0\\.0$)[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "defenderSignatures": { "type": "string", "minLength": 3 },
    "antivirusEnabled": { "const": true },
    "realTimeProtectionEnabled": { "const": true },
    "platformUpdatesChannel": { "const": 6 },
    "platformUpdatesChannelExpected": { "const": "Delayed (6)" },
    "bitLockerC": { "const": "On" },
    "bitLockerD": { "const": "On" },
    "secureBoot": { "const": true },
    "ubuntuColdStartExitCode": { "const": 0 },
    "dockerDistroColdStartExitCode": { "const": 0 },
    "dockerDesktopStartRequested": { "const": true },
    "dockerDesktopStartExitCode": { "const": 0 },
    "dockerEngineReady": { "const": true },
    "dockerEngineVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+" },
    "dockerVhdCountOnDataDrive": { "type": "integer", "minimum": 2 },
    "passed": { "const": true },
    "failures": { "type": "array", "maxItems": 0 }
  }
}
