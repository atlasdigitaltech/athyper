{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://athyper.io/schemas/topology-requirement-v1alpha1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "athyper.io/v1alpha1" },
    "kind": { "const": "TopologyRequirement" },
    "metadata": { "type": "object", "additionalProperties": false, "required": ["id", "approvedBy", "approvedAt"], "properties": { "id": { "type": "string", "minLength": 3 }, "approvedBy": { "type": "string", "minLength": 3 }, "approvedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" } } },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["multiHostRequired", "minimumNodeCount", "placementRequirements", "approved"],
      "properties": {
        "multiHostRequired": { "const": true },
        "minimumNodeCount": { "type": "integer", "minimum": 2 },
        "placementRequirements": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 3 } },
        "approved": { "const": true }
      }
    }
  }
}
