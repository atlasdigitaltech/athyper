{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://athyper.io/schemas/restore-drill-receipt-v1alpha1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "athyper.io/v1alpha1" },
    "kind": { "const": "RestoreDrillReceipt" },
    "metadata": { "type": "object", "additionalProperties": false, "required": ["instance"], "properties": { "instance": { "const": "stg" } } },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["restoredAt", "backupSha256", "targetProject", "checks"],
      "properties": {
        "restoredAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
        "backupSha256": { "type": "string", "pattern": "^(?!0{64}$)[a-f0-9]{64}$" },
        "targetProject": { "type": "string", "pattern": "^athyper-stg-restore-[a-z0-9][a-z0-9-]+$" },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "passed"],
            "properties": { "id": { "type": "string", "minLength": 2 }, "passed": { "const": true } }
          }
        }
      }
    }
  }
}
