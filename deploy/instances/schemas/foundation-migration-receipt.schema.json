{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://athyper.io/schemas/foundation-migration-receipt-v1alpha1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "athyper.io/v1alpha1" },
    "kind": { "const": "FoundationMigrationReceipt" },
    "metadata": { "type": "object", "additionalProperties": false, "required": ["instance"], "properties": { "instance": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" } } },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "completedAt", "sourceRevision", "ddlSha256", "mode"],
      "properties": {
        "project": { "type": "string", "pattern": "^athyper-[a-z0-9-]+$" },
        "completedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
        "sourceRevision": { "type": "string", "pattern": "^(working-tree|unknown|[a-f0-9]{40})$" },
        "ddlSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "mode": { "const": "fresh-database-foundation" }
      }
    }
  }
}
