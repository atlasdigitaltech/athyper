{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://athyper.io/schemas/staging-notification-evidence-v1alpha1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "athyper.io/v1alpha1" },
    "kind": { "const": "StagingNotificationEvidence" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate"],
      "properties": {
        "gate": { "enum": ["provider-readiness", "email-canary", "web-push-canary", "failure-exercise"] }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "status", "sourceRevision", "recordedAt", "channel", "canaryIdentity", "assertions"],
      "allOf": [
        {
          "if": {
            "properties": { "channel": { "const": "email" } },
            "required": ["channel"]
          },
          "then": {
            "required": ["providerReference"],
            "properties": {
              "providerReference": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
              "assertions": {
                "type": "object",
                "additionalProperties": false,
                "required": ["authenticatedDispatch", "providerAccepted", "providerEventObserved", "delivered", "activityCenterPublished"],
                "properties": {
                  "authenticatedDispatch": { "const": true },
                  "providerAccepted": { "const": true },
                  "providerEventObserved": { "const": true },
                  "delivered": { "const": true },
                  "activityCenterPublished": { "const": true }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "environment": { "const": "stg" },
        "status": { "const": "passed" },
        "sourceRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "recordedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
        "channel": { "enum": ["provider", "email", "web-push", "multi-channel"] },
        "canaryIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tenantId", "principalId", "recipientRef"],
          "properties": {
            "tenantId": { "type": "string", "pattern": "^[a-f0-9-]{36}$" },
            "principalId": { "type": "string", "pattern": "^[a-f0-9-]{36}$" },
            "recipientRef": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          }
        },
        "providerReference": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "assertions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "boolean" },
          "propertyNames": { "pattern": "^[a-z][a-zA-Z0-9]+$" }
        }
      }
    }
  }
}
