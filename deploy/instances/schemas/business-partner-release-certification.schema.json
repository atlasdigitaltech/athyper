{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://athyper.io/schemas/business-partner-release-certification-v1alpha1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "athyper.io/v1alpha1" },
    "kind": { "const": "BusinessPartnerReleaseCertification" },
    "metadata": {
      "type": "object", "additionalProperties": false, "required": ["id"],
      "properties": { "id": { "type": "string", "minLength": 3 } }
    },
    "spec": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceImageSet", "sourceRevision", "images", "gates", "thresholds", "canary", "requiredOwners", "runbooks"],
      "properties": {
        "sourceImageSet": { "type": "string", "pattern": "^deploy/image-sets/releases/[a-z0-9.-]+\\.yaml$" },
        "sourceRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$", "not": { "pattern": "^0{40}$" } },
        "images": {
          "type": "object", "minProperties": 5,
          "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$", "not": { "pattern": "^0{64}$" } }
        },
        "gates": {
          "type": "array", "minItems": 7, "maxItems": 7,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "environment", "evidence", "requiredChecks"],
            "properties": {
              "id": { "enum": ["database", "domain-service", "cross-plane", "security-privacy", "ux", "operations", "ownership"] },
              "environment": { "enum": ["staging", "production"] },
              "evidence": { "type": "string", "pattern": "^production/business-partner/[a-z0-9-]+\\.json$" },
              "requiredChecks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]+$" } }
            }
          }
        },
        "thresholds": {
          "type": "object", "additionalProperties": false,
          "required": ["requestFailureRateMax", "requestP95MillisecondsMax", "outboxLagSecondsMax", "quarantineCountMax", "iamDriftMax", "meshDriftMax", "readinessFailuresMax"],
          "properties": {
            "requestFailureRateMax": { "type": "number", "minimum": 0, "maximum": 1 },
            "requestP95MillisecondsMax": { "type": "number", "exclusiveMinimum": 0 },
            "outboxLagSecondsMax": { "type": "number", "minimum": 0 },
            "quarantineCountMax": { "type": "integer", "minimum": 0 },
            "iamDriftMax": { "type": "integer", "minimum": 0 },
            "meshDriftMax": { "type": "integer", "minimum": 0 },
            "readinessFailuresMax": { "type": "integer", "minimum": 0 }
          }
        },
        "canary": {
          "type": "object", "additionalProperties": false, "required": ["cohortPercent", "minimumObservationMinutes", "journeys", "retainPriorRevision"],
          "properties": {
            "cohortPercent": { "type": "number", "exclusiveMinimum": 0, "maximum": 5 },
            "minimumObservationMinutes": { "type": "integer", "minimum": 30 },
            "journeys": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "enum": ["supplier", "customer", "workforce", "external-invitation"] } },
            "retainPriorRevision": { "const": true }
          }
        },
        "requiredOwners": { "type": "array", "minItems": 6, "uniqueItems": true, "items": { "enum": ["neon", "mesh", "studio-iam", "security-privacy", "operations", "product"] } },
        "runbooks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^docs/runbooks/[a-z0-9-]+\\.md$" } }
      }
    }
  }
}
