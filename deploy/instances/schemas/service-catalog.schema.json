{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://athyper.io/schemas/service-catalog-v1alpha1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "services"],
  "properties": {
    "apiVersion": { "const": "athyper.io/v1alpha1" },
    "kind": { "const": "ServiceCatalog" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": { "name": { "type": "string" } }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "class", "lifecycle", "ledger", "image", "stateful", "profiles", "presets", "resources", "backupOwner", "secrets"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
          "class": { "enum": ["application", "capability", "platform", "fixture"] },
          "lifecycle": { "enum": ["long-running", "stateful", "one-shot", "on-demand", "ephemeral"] },
          "ledger": { "enum": ["resolved-v1", "v2-addition", "test-fixture"] },
          "image": { "type": "string", "minLength": 3 },
          "stateful": { "type": "boolean" },
          "profiles": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "presets": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "resources": {
            "type": "object",
            "additionalProperties": false,
            "required": ["memoryMiB", "cpu"],
            "properties": {
              "memoryMiB": { "type": "integer", "minimum": 16 },
              "cpu": { "type": "number", "exclusiveMinimum": 0 }
            }
          },
          "backupOwner": { "type": "string", "minLength": 2 },
          "secrets": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "uniqueItems": true }
        }
      }
    }
  }
}
