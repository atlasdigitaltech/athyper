{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://athyper.io/schemas/stack-v1-disposition-v1alpha1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "decidedAt", "decision", "legacyData", "preservation", "restoreAuthorized", "oldSecretsReuseAuthorized", "rawVolumeReuseAuthorized", "selectiveImportPolicy", "authorizedBy"],
  "properties": {
    "apiVersion": { "const": "athyper.io/v1alpha1" },
    "kind": { "const": "StackV1Disposition" },
    "decidedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
    "decision": { "enum": ["clean-slate", "preserve-and-migrate"] },
    "legacyData": { "enum": ["disposable", "preserve"] },
    "preservation": { "enum": ["reference-only", "verified-export"] },
    "restoreAuthorized": { "type": "boolean" },
    "oldSecretsReuseAuthorized": { "const": false },
    "rawVolumeReuseAuthorized": { "const": false },
    "selectiveImportPolicy": { "const": "reviewed-transformations-only" },
    "authorizedBy": { "type": "string", "minLength": 3 }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "clean-slate" } } },
      "then": {
        "properties": {
          "legacyData": { "const": "disposable" },
          "preservation": { "const": "reference-only" },
          "restoreAuthorized": { "const": false }
        }
      }
    },
    {
      "if": { "properties": { "decision": { "const": "preserve-and-migrate" } } },
      "then": {
        "properties": {
          "legacyData": { "const": "preserve" },
          "preservation": { "const": "verified-export" },
          "restoreAuthorized": { "const": true }
        }
      }
    }
  ]
}
