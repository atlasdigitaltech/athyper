{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://athyper.io/schemas/sanitized-data-manifest-v1alpha1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "athyper.io/v1alpha1" },
    "kind": { "const": "SanitizedDataManifest" },
    "metadata": { "type": "object", "additionalProperties": false, "required": ["instance"], "properties": { "instance": { "const": "stg" } } },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceInstance", "classification", "createdAt", "datasetSha256", "recordCount", "checks"],
      "properties": {
        "sourceInstance": { "const": "qa" },
        "classification": { "const": "sanitized" },
        "createdAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
        "datasetSha256": { "type": "string", "pattern": "^(?!0{64}$)[a-f0-9]{64}$" },
        "recordCount": { "type": "integer", "minimum": 0 },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["credentialScanPassed", "personalDataScanPassed", "prohibitedContentFound"],
          "properties": {
            "credentialScanPassed": { "const": true },
            "personalDataScanPassed": { "const": true },
            "prohibitedContentFound": { "type": "array", "maxItems": 0 }
          }
        }
      }
    }
  }
}
