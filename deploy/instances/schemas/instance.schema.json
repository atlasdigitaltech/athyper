{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://athyper.io/schemas/instance-v1alpha1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "athyper.io/v1alpha1" },
    "kind": { "const": "Instance" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,30}$" } }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "composeProject", "domainSuffix", "preset", "hostProfile", "imageSet", "dataPolicy", "integrations", "providers"],
      "properties": {
        "mode": { "enum": ["development", "qa", "staging", "production"] },
        "composeProject": { "type": "string", "pattern": "^athyper-[a-z0-9][a-z0-9-]{1,30}$" },
        "domainSuffix": { "type": "string", "pattern": "^[a-z0-9.-]+\\.athyper\\.test$" },
        "preset": { "enum": ["dev-lite", "dev-full", "qa-standard", "stg-standard", "validation-full"] },
        "hostProfile": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "imageSet": { "type": "string", "pattern": "^image-sets/.+\\.yaml$" },
        "dataPolicy": { "enum": ["persistent", "disposable", "sanitized"] },
        "integrations": { "enum": ["sandbox", "mock", "allowlisted", "production"] },
        "debugPorts": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^127\\.0\\.0\\.1:[0-9]{2,5}$" }
        },
        "providers": {
          "type": "object",
          "minProperties": 4,
          "additionalProperties": { "enum": ["internal", "external", "mock", "disabled", "file"] }
        }
      }
    }
  }
}
