{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://athyper.io/schemas/pre-migration-backup-receipt-v1alpha1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "athyper.io/v1alpha1" },
    "kind": { "const": "PreMigrationBackupReceipt" },
    "metadata": { "type": "object", "additionalProperties": false, "required": ["instance"], "properties": { "instance": { "const": "stg" } } },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createdAt", "sourceRevision", "database"],
      "properties": {
        "createdAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
        "sourceRevision": { "type": "string", "pattern": "^(?!0{40}$)[a-f0-9]{40}$" },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256", "sizeBytes", "format"],
          "properties": {
            "sha256": { "type": "string", "pattern": "^(?!0{64}$)[a-f0-9]{64}$" },
            "sizeBytes": { "type": "integer", "minimum": 1 },
            "format": { "enum": ["postgres-custom", "postgres-directory"] }
          }
        }
      }
    }
  }
}
